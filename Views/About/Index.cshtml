@using WebMTTQ.Models
@using System.Linq
@inject DataMTTQContext _context

@{
    ViewData["Title"] = "Giới thiệu tổ chức";
    ViewData["IsAbout"] = true;
    // Lấy lời giới thiệu đang được kích hoạt
    var intro = _context.GioiThieuChungs.OrderByDescending(x => x.Id).FirstOrDefault(x => x.TrangThai == true);
    // Lấy dữ liệu tổ chức từ DB
    var cap1 = _context.DoanTheToChucs.Where(x => x.CapDo == 1 && x.DaXoa != true).OrderBy(x => x.ThuTu).ToList();
    var cap2 = _context.DoanTheToChucs.Where(x => x.CapDo == 2 && x.DaXoa != true).OrderBy(x => x.ThuTu).ToList();
}
<style>
    /* RESET & BASE */
    .org-wrapper {
        background: #fdfdfd;
        padding-bottom: 0;
        font-family: 'Be Vietnam Pro', sans-serif;
    }
    
    /* HEADER SECTION */
    .org-header {
        text-align: center;
        padding: 3rem 1rem 1.5rem;
        background: #fff;
    }
    
    .org-title {
        font-family: 'Be Vietnam Pro', sans-serif;
        font-weight: 800;
        font-size: clamp(1.4rem, 3vw, 2.2rem);
        line-height: 1.4;
        margin-bottom: 1rem;
        color: #1565c0;
    }
    
    .org-title .text-red { color: #d32f2f; }
    
    .org-subtitle-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        margin-top: 5px;
    }
    
    .org-line {
        height: 2px;
        background-color: #d32f2f;
        width: 80px;
        position: relative;
    }
    
    .org-line::after {
        content: '';
        position: absolute;
        width: 6px; height: 6px;
        background: #d32f2f;
        border-radius: 50%;
        top: -2px;
    }
    
    .org-line.left::after { right: 0; }
    .org-line.right::after { left: 0; }
    
    .org-slogan-pill {
        display: inline-block;
        background: #1565c0;
        color: white;
        padding: 6px 30px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 1px;
        margin: 1.5rem 0;
        box-shadow: 0 4px 10px rgba(21, 101, 192, 0.3);
    }
    
    .org-intro-text {
        max-width: 950px;
        margin: 0 auto;
        font-size: 0.95rem;
        line-height: 1.7;
        color: #333;
        text-align: justify;
    }

    /* TREE STRUCTURE (SƠ ĐỒ CÂY) */
    .tree-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1rem 5rem;
    }

    /* Cấp 1: Chủ tịch MTTQ */
    .tree-level-1 {
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 10;
    }

    /* Đường nối dọc từ Chủ tịch xuống */
    .tree-connector {
        width: 2px;
        height: 60px;
        background-color: #d32f2f;
        margin: 0 auto;
    }

    /* Cấp 2: 4 Thành viên */
    .tree-level-2 {
        display: flex;
        justify-content: center;
        gap: 25px;
    }

    .tree-item {
        flex: 1;
        position: relative;
        padding-top: 40px;
        max-width: 280px;
    }

    /* Đường kẻ ngang nối 4 thẻ */
    .tree-item::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 2px;
        background-color: #d32f2f;
    }
    .tree-item:first-child::before { width: 50%; left: 50%; }
    .tree-item:last-child::before { width: 50%; right: 50%; }

    /* Đường kẻ dọc cắm xuống từng thẻ */
    .tree-item::after {
        content: '';
        position: absolute;
        top: 0; left: 50%;
        width: 2px; height: 40px;
        background-color: #d32f2f;
        transform: translateX(-50%);
    }

    /* THIẾT KẾ THẺ ROOT (CHỦ TỊCH) NẰM NGANG NHƯ HÌNH MẪU */
    .org-card-root {
        display: flex;
        align-items: center;
        gap: 25px;
        background: #fff;
        border: 2px solid #d32f2f;
        border-radius: 12px;
        padding: 15px 30px;
        max-width: 600px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .root-ava {
        width: 110px; height: 110px;
        flex-shrink: 0;
    }

    .root-info {
        text-align: center;
    }

    .root-name {
        background: #d32f2f;
        color: #fff;
        font-weight: 700;
        padding: 6px 20px;
        border-radius: 20px;
        font-size: 1.1rem;
        display: inline-block;
        margin-bottom: 8px;
    }

    .root-role { font-size: 0.95rem; color: #333; margin-bottom: 5px; }
    .root-title { color: #d32f2f; font-weight: 800; font-size: 1.4rem; margin-bottom: 2px; text-transform: uppercase; }
    .root-sub { font-size: 0.95rem; font-weight: 500; color: #444; }

    /* THIẾT KẾ THẺ CẤP 2 (CARD) */
    .org-card {
        background: #fff;
        border: 2px solid;
        border-radius: 12px;
        padding: 55px 15px 15px;
        margin-top: 45px;
        display: flex;
        flex-direction: column;
        height: calc(100% - 45px);
        text-align: center;
        transition: box-shadow 0.3s ease;
        position: relative;
        z-index: 5;
    }

    .org-card:hover {
        box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    }

    /* Avatar nổi lên trên mép thẻ */
    .org-ava {
        width: 90px; height: 90px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid;
        position: absolute;
        top: -45px; left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
        z-index: 6;
    }

    .org-ava img, .org-ava svg, .root-ava svg, .root-ava img {
        width: 100%; height: 100%;
        border-radius: 50%;
        object-fit: contain; /* Đổi thành contain để logo không bị cắt xén */
        background-color: #fff;
    }

    .org-name {
        color: #fff;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 20px;
        margin-bottom: 12px;
        font-size: 0.85rem;
        text-transform: uppercase;
        display: inline-block;
    }

    .org-body {
        flex-grow: 1;
        font-size: 0.85rem;
        color: #444;
        text-align: left;
        line-height: 1.5;
    }

    .role-row {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        margin-bottom: 8px;
    }
    
    .role-row svg {
        width: 12px; height: 12px;
        margin-top: 4px;
        flex-shrink: 0;
    }

    .org-footer {
        border-top: 1px solid #eee;
        padding-top: 12px;
        margin-top: 15px;
    }

    .org-title-role {
        font-weight: 800;
        font-size: 1.1rem;
        margin-bottom: 2px;
        text-transform: uppercase;
    }

    .org-subtitle-role { font-size: 0.82rem; font-weight: 600; color: #555; }

    /* MÀU SẮC THEO TỪNG TỔ CHỨC */
    .card-pn { border-color: #e91e63; }
    .card-pn .org-ava { border-color: #e91e63; }
    .card-pn .org-name { background: #e91e63; }
    .card-pn .role-row svg { color: #e91e63; }
    .card-pn .org-title-role { color: #e91e63; }
    
    .card-cd { border-color: #1976d2; }
    .card-cd .org-ava { border-color: #1976d2; }
    .card-cd .org-name { background: #1976d2; }
    .card-cd .role-row svg { color: #1976d2; }
    .card-cd .org-title-role { color: #1976d2; }
    
    .card-ccb { border-color: #2e7d32; }
    .card-ccb .org-ava { border-color: #2e7d32; }
    .card-ccb .org-name { background: #2e7d32; }
    .card-ccb .role-row svg { color: #2e7d32; }
    .card-ccb .org-title-role { color: #2e7d32; }
    
    .card-dt { border-color: #0d47a1; }
    .card-dt .org-ava { border-color: #0d47a1; }
    .card-dt .org-name { background: #0d47a1; }
    .card-dt .role-row svg { color: #0d47a1; }
    .card-dt .org-title-role { color: #0d47a1; }

    /* FOOTER BANNER */
    .org-bottom-banner {
        background: linear-gradient(90deg, #1565c0, #0d47a1);
        color: white;
        text-align: center;
        padding: 15px 10px;
        font-size: clamp(1.1rem, 2.5vw, 1.6rem);
        font-weight: 700;
        font-style: italic;
        font-family: 'Playfair Display', serif;
        border-top: 4px solid #d32f2f;
    }

    /* RESPONSIVE TRÊN ĐIỆN THOẠI */
    @@media (max-width: 900px) {
        .org-card-root { flex-direction: column; padding: 20px; max-width: 350px; margin: 0 auto; text-align: center; }
        .tree-level-2 { flex-direction: column; gap: 30px; align-items: center; }
        .tree-item { width: 100%; max-width: 350px; padding-top: 0; }
        .tree-connector { display: none; }
        .tree-item::before, .tree-item::after { display: none !important; }
        .org-card-root { margin-bottom: 20px; }
    }
</style>

<div class="org-wrapper">
    <!-- KHU VỰC TIÊU ĐỀ & GIỚI THIỆU LẤY TỪ DB -->
    <section class="org-header">
        <h1 class="org-title">
            @(intro?.TieuDeChinh ?? "ỦY BAN MẶT TRẬN TỔ QUỐC VIỆT NAM PHƯỜNG")<br />
            <div class="org-subtitle-row">
                <div class="org-line left"></div>
                <span style="font-style: italic; color: #1565c0;">@(intro?.ChuNghieng ?? "và các") </span>
                <span class="text-red">@(intro?.TieuDePhu ?? "TỔ CHỨC CHÍNH TRỊ - XÃ HỘI")</span>
                <div class="org-line right"></div>
            </div>
        </h1>

        <div class="org-slogan-pill">
            @(intro?.Slogan ?? "★ ĐOÀN KẾT – ĐỔI MỚI – VĂN MINH – NGHĨA TÌNH ★")
        </div>

        <p class="org-intro-text">
            @(intro?.NoiDung ?? "Ủy ban Mặt trận Tổ quốc Việt Nam phường và các tổ chức chính trị - xã hội là lực lượng nòng cốt trong việc xây dựng khối đại đoàn kết toàn dân tộc, phát huy quyền làm chủ của Nhân dân, đại diện, bảo vệ quyền và lợi ích hợp pháp, chính đáng của đoàn viên, hội viên và Nhân dân. Với mô hình hoạt động thống nhất, gồm Ủy ban MTTQ Việt Nam, Đoàn Thanh niên Cộng sản Hồ Chí Minh, Hội Liên hiệp Phụ nữ, Hội Nông dân và Hội Cựu chiến binh, các tổ chức luôn phối hợp chặt chẽ trong công tác tuyên truyền, vận động Nhân dân, thực hiện các phong trào thi đua yêu nước, các cuộc vận động, giám sát, phản biện xã hội và tham gia xây dựng Đảng, chính quyền trong sạch, vững mạnh. Ban Thường trực Ủy ban MTTQ Việt Nam phường Tân Định gồm:")
        </p>
    </section>
    <!-- KHU VỰC SƠ ĐỒ TỔ CHỨC ĐỘNG TỪ CSDL -->
    <section class="tree-container">

        <!-- LEVEL 1: CHỦ TỊCH MTTQ -->
        <div class="tree-level-1">
            @foreach (var root in cap1)
            {
                <div class="org-card-root" style="border-color: @root.MauSac;">
                    <div class="root-ava">
                        <img src="@root.HinhAnh" alt="Logo" />
                    </div>
                    <div class="root-info">
                        <div class="root-name" style="background: @root.MauSac;">@root.HoTen</div>

                        @if (!string.IsNullOrEmpty(root.VaiTroBoSung))
                        {
                            var roles = root.VaiTroBoSung.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                            foreach (var role in roles)
                            {
                                <div class="root-role">@role</div>
                            }
                        }

                        <div class="root-title" style="color: @root.MauSac;">@root.ChucVu</div>
                        <div class="root-sub">@root.CoQuan</div>
                    </div>
                </div>
            }
        </div>

        <!-- Cây nối dọc từ Chủ tịch xuống ngã 4 -->
        @if (cap1.Any() && cap2.Any())
        {
            <div class="tree-connector"></div>
        }

        <!-- LEVEL 2: CÁC THÀNH VIÊN -->
        <div class="tree-level-2">
            @foreach (var node in cap2)
            {
                <div class="tree-item">
                    <!-- Gắn động mã màu vào border -->
                    <div class="org-card" style="border-color: @node.MauSac;">

                        <!-- Gắn động mã màu vào viền avatar -->
                        <div class="org-ava" style="border-color: @node.MauSac;">
                            <img src="@node.HinhAnh" alt="Logo" />
                        </div>

                        <!-- Gắn động mã màu vào nền tên -->
                        <div><span class="org-name" style="background: @node.MauSac;">@node.HoTen</span></div>

                        <div class="org-body">
                            @if (!string.IsNullOrEmpty(node.VaiTroBoSung))
                            {
                                var subRoles = node.VaiTroBoSung.Split('\n', StringSplitOptions.RemoveEmptyEntries);
                                foreach (var role in subRoles)
                                {
                                    <div class="role-row">
                                        <!-- Gắn động mã màu vào icon mũi tên -->
                                        <svg style="color: @node.MauSac;" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                                        <span>@role</span>
                                    </div>
                                }
                            }
                        </div>

                        <div class="org-footer">
                            <!-- Gắn động mã màu vào tên chức vụ -->
                            <div class="org-title-role" style="color: @node.MauSac;">@node.ChucVu</div>
                            <div class="org-subtitle-role">@node.CoQuan</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- KHU VỰC CÁC SECTION NỘI DUNG ĐỘNG TỪ CSDL -->
    @{
        var sections = ViewBag.Sections as List<WebMTTQ.Models.GioiThieuSection> ?? new List<WebMTTQ.Models.GioiThieuSection>();
    }
    @if (sections.Any())
    {
        <section class="org-sections" style="max-width:1100px; margin:0 auto; padding:2rem 1rem;">
            @foreach (var sec in sections)
            {
                <div class="org-section-item" style="margin-bottom:2.5rem; background:#fff; border-radius:12px; padding:2rem; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
                    <h2 style="font-family:'Be Vietnam Pro',sans-serif; font-weight:800; font-size:1.4rem; color:#1565c0; margin:0 0 1rem; border-bottom:2px solid #d32f2f; padding-bottom:0.75rem;">
                        @sec.TieuDe
                    </h2>
                    @if (!string.IsNullOrEmpty(sec.HinhAnh))
                    {
                        <div style="text-align:center; margin:0 auto 1rem; display:flex; justify-content:center;">
                            <img src="@sec.HinhAnh" alt="@sec.AltText" style="max-width:100%; max-height:300px; border-radius:8px; object-fit:cover; display:block; margin:0 auto;" />
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(sec.NoiDung))
                    {
                        <div class="org-section-content" style="font-size:0.95rem; line-height:1.7; color:#333; text-align:justify;">
                            @Html.Raw(WebMTTQ.Services.HtmlSanitizer.Sanitize(sec.NoiDung ?? ""))
                        </div>
                    }
                </div>
            }
        </section>
    }

    <!-- FOOTER CHÂN TRANG -->
    <div class="org-bottom-banner">
        Đoàn kết – Đổi mới – Văn minh – Nghĩa tình
    </div>
</div>
