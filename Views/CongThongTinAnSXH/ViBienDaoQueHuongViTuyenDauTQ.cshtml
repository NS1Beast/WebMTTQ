        .asxh-card, .cl-container, .map-container-wrapper, .help-section {
            padding: 20px;
            border-radius: 16px;
            margin-bottom: 20px;
        }

        .asxh-col-4, .asxh-col-6, .asxh-col-8 {
            width: 100%;
