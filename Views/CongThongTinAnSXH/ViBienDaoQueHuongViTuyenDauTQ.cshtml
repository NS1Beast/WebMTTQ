</style>

<div class="asxh-wrapper">
    <div class="asxh-container">

        <div class="asxh-hero">
            <div class="asxh-badge">ỔNG THÔNG TIN QUỸ VÌ BIỂN ĐẢO QUÊ HƯƠNG VÌ TUYẾN ĐẦU TỔ QUỐC</div>
            <h1 class="asxh-font-serif" style="font-size: 2.8rem; font-weight: bold; line-height: 1.3; margin-top: 0; margin-bottom: 15px;">
                Ủy ban MTTQ Việt Nam Phường Tân Định - <br />
                Chung tay vì cộng đồng, minh bạch trong <br />
                từng đóng góp
            </h1>
            <p style="font-size: 1.1rem; line-height: 1.6; opacity: 0.9; max-width: 750px; margin-bottom: 25px; margin-left: auto; margin-right: auto;">
                "Đây là trang tiếp nhận và công khai thông tin ủng hộ Quỹ Vì Biển Đảo quê hương, phục vụ các hoạt động thăm hỏi cán bộ, chiến sĩ, hỗ trợ ngư dân bám biển và xây dựng các công trình biển đảo.
            </p>
            <div>
                <a href="#danh-sach-ung-ho" class="asxh-btn-white">Xem thông tin ủng hộ</a>
                <a href="#nhu-cau-tro-giup" class="asxh-btn-outline">Để lại nhu cầu trợ giúp</a>
            </div>
        </div>

        <div class="asxh-row" style="margin-bottom: 24px;">
            <div class="asxh-col-4">
                <div class="asxh-card">
                    <h3 class="asxh-font-serif" style="font-size: 1.5rem; font-weight: bold; margin-top: 0; margin-bottom: 25px;">Thông tin tiếp nhận ủng hộ</h3>
                    @if (ViewBag.DanhSachUngHo != null)
                    {
                        foreach (var item in ViewBag.DanhSachUngHo)
                        {
                            <div style="margin-bottom: 30px; border-bottom: 2px dashed #eee; padding-bottom: 10px;">
                                <div class="qr-card-red">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                                        <div style="font-size: 1.8rem; color: #ffc107; line-height: 1;">★</div>
                                        <div style="text-align: right;">
                                            <div style="font-weight: bold; font-size: 1.1rem; letter-spacing: 1px; text-transform: uppercase;">@item.TenNganHang</div>
                                            <div style="font-size: 0.75rem; color: #ddd;">Chi nhánh @item.ChiNhanh</div>
                                        </div>
                                    </div>
                                    <div style="text-align: center; color: #f9d857; font-family: 'Playfair Display', serif; font-style: italic; font-size: 0.9rem; line-height: 1.4; margin-bottom: 20px;">
                                        "Cùng viết tiếp câu chuyện hòa bình,<br> để Việt Nam vươn mình cất cánh"
                                    </div>
                                    <div style="text-align: center; margin-bottom: 20px;">
                                        <div style="background-color: white; padding: 10px; display: inline-block; border-radius: 12px;">
                                            @if (!string.IsNullOrEmpty(item.QrCodeUrl))
                                            {
                                                <img src="@item.QrCodeUrl" alt="QR Code @item.TenNganHang" style="width: 130px; height: 130px; display: block; object-fit: contain;" />
                                            }
                                            else
                                            {
                                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@(item.TenNganHang)-@(item.SoTaiKhoan)" alt="QR Code @item.TenNganHang" style="width: 130px; height: 130px; display: block; object-fit: contain;" />
                                            }
                                        </div>
                                    </div>
                                    <div style="text-align: center;">
                                        <div style="font-size: 0.75rem; color: #ddd; margin-bottom: 4px;">Tên tài khoản:</div>
                                        <div style="font-weight: bold; font-size: 0.85rem; margin-bottom: 15px; text-transform: uppercase;">@item.TenTaiKhoan</div>
                                        <div style="font-size: 0.75rem; color: #ddd; margin-bottom: 4px;">Số tài khoản:</div>
                                        <div style="font-weight: bold; font-size: 1.3rem;">@item.SoTaiKhoan</div>
                                    </div>
                                </div>
                                <div style="font-size: 0.9rem;">
                                    <div style="color: #999; font-size: 0.75rem; font-weight: bold; margin-bottom: 4px;">ĐƠN VỊ THỤ HƯỞNG</div>
                                    <div style="font-weight: bold; margin-bottom: 15px; text-transform: uppercase;">@item.DonViThuHuong</div>

                                    <div style="color: #999; font-size: 0.75rem; font-weight: bold; margin-bottom: 4px;">NGÂN HÀNG</div>
                                    <div style="font-weight: bold; margin-bottom: 15px;">@item.TenNganHang / Tài khoản tiếp nhận ủng hộ</div>

                                    <div style="color: #999; font-size: 0.75rem; font-weight: bold; margin-bottom: 4px;">SỐ TÀI KHOẢN</div>
                                    <div style="font-weight: bold; margin-bottom: 15px;">@item.SoTaiKhoan</div>

                                    <div style="color: #999; font-size: 0.75rem; font-weight: bold; margin-bottom: 4px;">NỘI DUNG CHUYỂN KHOẢN</div>
                                    <div style="font-weight: bold;">@(string.IsNullOrEmpty(item.NoiDungChuyenKhoan) ? "HO TEN - SO DIEN THOAI" : item.NoiDungChuyenKhoan)</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="asxh-col-8">
                <div class="asxh-card" style="margin-bottom: 24px;">
                    <h3 class="asxh-font-serif" style="font-size: 1.6rem; font-weight: bold; margin-top: 0; margin-bottom: 15px;">Lan tỏa nghĩa tình - Kết nối cộng đồng - Chung tay vì Phường Tân Định</h3>
                    <p style="font-size: 0.95rem; line-height: 1.6; color: #666; margin-bottom: 20px;">Mỗi khoản đóng góp là một sự sẻ chia thiết thực để MTTQ và các đoàn thể địa phương phối hợp chăm lo đúng người, đúng hoàn cảnh, đúng nhu cầu.</p>
                    <div class="asxh-row">
                        <div class="asxh-col-6">
                            <div class="stat-box-solid">
                                <div style="font-size: 0.8rem; color: #ddd; font-weight: bold; margin-bottom: 5px;">TỔNG GIÁ TRỊ TIẾP NHẬN</div>
                                <div style="font-size: 2rem; font-weight: bold;">@(((decimal)(ViewBag.TongTien ?? 0)).ToString("N0"))<span style="font-size: 1rem; font-weight: normal; margin-left: 3px;">đ</span></div>
                            </div>
                        </div>
                        <div class="asxh-col-6">
                            <div class="stat-box-solid">
                                <div style="font-size: 0.8rem; color: #ddd; font-weight: bold; margin-bottom: 5px;">LƯỢT ỦNG HỘ GHI NHẬN</div>
                                <div style="font-size: 2rem; font-weight: bold;">@(ViewBag.TongSoLuot ?? 0)</div>
                            </div>
                        </div>
                    </div>
                    <div style="text-align: center; margin-top: 15px; font-size: 0.8rem; color: #999; font-style: italic;">* Số liệu cập nhật đến ngày @ViewBag.NgayCapNhat</div>
                </div>

                <div class="asxh-card" style="margin-bottom: 24px;">
                    <h3 class="asxh-font-serif" style="font-size: 1.6rem; font-weight: bold; margin-top: 0; text-align: center; margin-bottom: 20px;">Công khai số dư Quỹ "Vì Biển Đảo quê hương, vì tuyến đầu tổ quốc"</h3>
                    @if (ViewBag.SoDuQuy != null)
                    {
                        <div style="text-align: center; margin-bottom: 20px;"><span class="asxh-badge-light">Số dư đến ngày @ViewBag.SoDuQuy.NgayCapNhat.ToString("dd/M/yyyy")</span></div>
                        <div class="asxh-row" style="margin-bottom: 10px;">
                            <div class="asxh-col-4"><div class="stat-box-outline"><div style="font-size: 0.8rem; font-weight: bold; color: #888; margin-bottom: 5px;">TIỀN MẶT</div><div class="val-red" style="font-size: 1.15rem;">@ViewBag.SoDuQuy.TienMat.ToString("N0")đ</div></div></div>
                            <div class="asxh-col-4"><div class="stat-box-outline"><div style="font-size: 0.8rem; font-weight: bold; color: #888; margin-bottom: 5px;">TIỀN GỬI NGÂN HÀNG</div><div class="val-red" style="font-size: 1.15rem;">@ViewBag.SoDuQuy.TienGuiNganHang.ToString("N0")đ</div></div></div>
                            <div class="asxh-col-4"><div class="stat-box-solid" style="padding: 15px; text-align: center;"><div style="font-size: 0.8rem; color: #ddd; font-weight: bold; margin-bottom: 5px;">TỔNG TỒN QUỸ</div><div style="font-size: 1.2rem; font-weight: bold; color: white;">@ViewBag.SoDuQuy.TongTonQuy.ToString("N0")đ</div></div></div>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted" style="font-style: italic;">Đang cập nhật số liệu mới nhất...</p>
                    }
                </div>

                <div class="asxh-card" id="danh-sach-ung-ho">
                    <h3 class="asxh-font-serif" style="font-size: 1.6rem; font-weight: bold; margin-top: 0; margin-bottom: 10px;">Danh sách ủng hộ</h3>
                    <div style="background-color: #faf6f0; border-radius: 12px; padding: 10px;">
                        <div class="table-responsive" id="vung-chua-bang-danh-sach">
                            <table class="asxh-table">
                                <thead>
                                    <tr>
                                        <th class="text-center">ĐƠN VỊ / CÁ NHÂN</th>
                                        <th class="text-center">THỜI GIAN</th>
                                        <th class="text-center">GIÁ TRỊ ỦNG HỘ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.DanhSachNguoiUngHo != null)
                                    {
                                        foreach (var item in ViewBag.DanhSachNguoiUngHo)
                                        {
                                            <tr>
                                                <td class="text-center" style="white-space: nowrap;">@item.TenNguoiUngHo</td>
                                                <td class="text-center" style="white-space: nowrap;">@item.NgayUngHo.ToString("dd/MM/yyyy")</td>
                                                <td class="text-center val-red" style="white-space: nowrap;">@item.SoTien.ToString("N0")đ</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            @if (ViewBag.TotalPages > 1)
                            {
                                <div class="asxh-pagination">
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <a href="javascript:void(0)" onclick="loadTrangDanhSach(@(ViewBag.CurrentPage - 1))" class="asxh-page-link">&laquo;</a>
                                    }
                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        <a href="javascript:void(0)" onclick="loadTrangDanhSach(@i)" class="asxh-page-link @(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
                                    }
                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <a href="javascript:void(0)" onclick="loadTrangDanhSach(@(ViewBag.CurrentPage + 1))" class="asxh-page-link">&raquo;</a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cl-container">
            <div class="chamlo-header">
                <div class="chamlo-eyebrow">Minh bạch · Kịp thời · Đúng đối tượng</div>
                <h2 class="chamlo-title">Kết quả hoạt động hướng về Biển Đảo</h2>
                <p class="chamlo-desc">Tổng hợp từ Sổ theo dõi chăm lo thường xuyên của Ban Thường trực UBMTTQ Việt Nam Phường Tân Định — các lượt trao quà, hỗ trợ hộ khó khăn theo từng tháng và từng đơn vị, nhà hảo tâm chung tay.</p>
                <div class="chamlo-badge">Cập nhật đến tháng @(ViewBag.ThangCapNhat ?? DateTime.Now.Month)/@(DateTime.Now.Year)</div>
            </div>

            <div class="cl-stats-grid">
                <div class="cl-stat-box-new">
                    <div class="cl-stat-title-new">Tổng kinh phí chăm lo</div>
                    <div class="cl-stat-val-new">
                        @(((decimal)(ViewBag.TongKinhPhiCL ?? 0)).ToString("N0"))
                        <span class="cl-stat-unit">đ</span>
                    </div>
                </div>
                <div class="cl-stat-box-new">
                    <div class="cl-stat-title-new">Lượt chiến sĩ/ngư dân được hỗ trợ</div>
                    <div class="cl-stat-val-new">
                        @(((int)(ViewBag.TongLuotHoCL ?? 0)).ToString("N0"))
                        <span class="cl-stat-unit">lượt</span>
                    </div>
                </div>
                <div class="cl-stat-box-new">
                    <div class="cl-stat-title-new">Hoạt động chăm lo</div>
                    <div class="cl-stat-val-new">@(ViewBag.TongHoatDongCL ?? 0)</div>
                </div>
                <div class="cl-stat-box-new">
                    <div class="cl-stat-title-new">Đơn vị, nhà hảo tâm chung tay</div>
                    <div class="cl-stat-val-new">@(ViewBag.TongDonViCL ?? 0)</div>
                </div>
            </div>

            <div class="cl-section-header">
                <h4 class="cl-section-title">Kinh phí chăm lo theo tháng</h4>
                <div class="cl-badge-stat">@ViewBag.ChuoiThang</div>
            </div>
            <div class="cl-chart-container">
                @if (ViewBag.ThongKeThang != null)
                {
                    foreach (var t in ViewBag.ThongKeThang)
                    {
                        var maxTien = (decimal)(ViewBag.MaxThangTien ?? 1);
                        var currentTien = (decimal)t.TongTien;
                        var heightPercent = maxTien > 0 ? (currentTien / maxTien) * 100 : 0;

                        // Quy đổi hiển thị Tr / Tỷ
                        string tienStr = currentTien >= 1000000000
                            ? (currentTien / 1000000000m).ToString("0.##") + " tỷ"
                            : (currentTien / 1000000m).ToString("0.##") + " tr";

                        <div class="cl-bar-wrapper">
                            <div class="cl-bar-val">@tienStr</div>
                            <div class="cl-bar-track">
                                <div class="cl-bar-fill" style="height: @(heightPercent)%;"></div>
                            </div>
                            <div class="cl-bar-month">T@(t.Thang)</div>
                            <div class="cl-bar-act">@(t.SoHoatDong) lượt</div>
                        </div>
                    }
                }
            </div>

            <div class="cl-section-header" style="margin-top: 50px;">
                <h4 class="cl-section-title">Đóng góp theo đơn vị</h4>
                <div class="cl-badge-stat">@(ViewBag.TongNhomDonVi ?? 0) nhóm đơn vị</div>
            </div>
            <div class="cl-unit-grid">
                @if (ViewBag.ThongKeDonVi != null)
                {
                    var tongKinhPhiCL = (decimal)(ViewBag.TongKinhPhiCL ?? 1);
                    foreach (var u in ViewBag.ThongKeDonVi)
                    {
                        var currentTien = (decimal)u.TongTien;
                        var pct = tongKinhPhiCL > 0 ? (currentTien / tongKinhPhiCL) * 100 : 0;

                        <div class="cl-unit-item">
                            <div class="cl-u-head">
                                <span>@u.TenLoai</span>
                                <span>@currentTien.ToString("N0")đ</span>
                            </div>
                            <div class="cl-u-track">
                                <div class="cl-u-fill" style="width: @(pct)%;"></div>
                            </div>
                            <div class="cl-u-meta">@(u.SoHoatDong) hoạt động · @pct.ToString("0.##")%</div>
                        </div>
                    }
                }
            </div>

            <div class="cl-section-header" style="margin-top: 50px;">
                <h4 class="cl-section-title">Chi tiết các lượt chăm lo</h4>
                <div class="cl-badge-stat">@(ViewBag.TongHoatDongCL ?? 0) hoạt động · @(((decimal)(ViewBag.TongKinhPhiCL ?? 0)).ToString("N0"))đ</div>
            </div>
            <div class="cl-filter-bar">
                <div class="cl-search-wrapper"><input type="text" id="clSearch" class="cl-input" placeholder="Tìm theo nội dung, đơn vị..." onkeyup="filterCL()"></div>

                <select id="clMonth" class="cl-select" onchange="filterCL()">
                    <option value="">Tất cả tháng</option>
                    @if (ViewBag.ThongKeThang != null)
                    {
                        foreach (var t in ViewBag.ThongKeThang)
                        {
                            <option value="Tháng @t.Thang">Tháng @t.Thang</option>
                        }
                    }
                </select>

                <select id="clUnit" class="cl-select" onchange="filterCL()">
                    <option value="">Tất cả đơn vị</option>
                    @if (ViewBag.ListNhomDonVi != null)
                    {
                        foreach (var u in ViewBag.ListNhomDonVi)
                        {
                            <option value="@u">@u</option>
                        }
                    }
                </select>
            </div>
            <div class="table-responsive cl-table-wrapper">
                <table class="cl-table" id="clTable">
                    <thead><tr><th width="80">Tháng</th><th width="180">Đơn vị</th><th>Nội dung</th><th width="60" style="text-align:center;">SL</th><th width="120" style="text-align:right;">Kinh phí</th></tr></thead>
                    <tbody>
                        @if (ViewBag.DanhSachChamLo != null)
                        {
                            foreach (var item in ViewBag.DanhSachChamLo)
                            {
                                <tr>
                                    <td style="color: #c43232; font-weight: bold; white-space: nowrap;">Tháng @item.Thang</td>
                                    <td><div style="font-weight: bold; color: #333;">@item.DonViUngHo</div><span class="cl-tag-sm">@item.PhanLoaiDonVi</span></td>
                                    <td style="min-width: 200px;">@item.NoiDung</td>
                                    <td style="text-align:center;">@item.SoLuongHo</td>
                                    <td style="text-align:right; color: #c43232; font-weight: bold; white-space: nowrap;">@item.KinhPhi.ToString("N0")đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (ViewBag.HienThiBanDo == true)
        {
            <div class="map-container-wrapper">
                <div class="map-header-row">
                    <div>
                        <h1 class="map-title" style="font-size: 1.8rem;">Bản đồ công tác an sinh</h1>
                        <p class="map-desc" style="font-size: 0.9rem;">Theo dõi các điểm hỗ trợ, hoạt động chăm lo trên địa bàn Phường Tân Định. Lọc theo đơn vị, tìm nhanh tên điểm hỗ trợ.</p>
                    </div>
                    <div class="map-stats-group">
                        <div class="map-stat-box"><div class="map-stat-label">Tổng địa điểm</div><div class="map-stat-value">@(ViewBag.TongDiaDiem ?? 0)</div></div>
                        <div class="map-stat-box"><div class="map-stat-label">Đang hiển thị</div><div class="map-stat-value" id="hienThiCount">@(ViewBag.TongDiaDiem ?? 0)</div></div>
                        <div class="map-stat-box"><div class="map-stat-label">Nhóm đơn vị</div><div class="map-stat-value">@(ViewBag.NhomDonVi ?? 0)</div></div>
                    </div>
                </div>

                <div class="map-search-bar">
                    <div class="search-input-wrap">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="searchInput" class="map-search-input" placeholder="Tìm theo tên địa điểm, nội dung hoặc đơn vị thực hiện..." onkeyup="applyFilters()">
                    </div>
                    <button class="btn-clear-filter" onclick="clearFilters()">Bỏ chọn bộ lọc</button>
                </div>

                <div class="info-tags-row">
                    <span class="info-tag"><span class="red-dot"></span> Bấm vào marker để xem chi tiết</span>
                </div>

                <div class="filter-chips" id="filterContainer"></div>

                <div class="mobile-map-tabs">
                    <button class="m-tab-btn active" id="btnShowMap" onclick="switchMobileTab('map')">Bản đồ</button>
                    <button class="m-tab-btn" id="btnShowList" onclick="switchMobileTab('list')">Danh sách <span class="m-badge" id="mListCountBadge">@(ViewBag.TongDiaDiem ?? 0)</span></button>
                </div>

                <div class="map-content-row" id="mapContentRow">
                    <div class="map-col"><div id="leafletMap"></div></div>
                    <div class="list-col">
                        <div class="list-header">
                            <h4>Danh sách điểm hỗ trợ</h4>
                            <div id="listCountBadge" style="background: #fdf0ea; color: var(--map-red); padding: 4px 10px; border-radius: 12px; font-weight: bold; font-size: 0.8rem;">@(ViewBag.TongDiaDiem ?? 0)</div>
                        </div>
                        <div class="list-wrapper" id="listWrapper"></div>
                    </div>
                </div>
            </div>
        }

        <div class="help-section" id="nhu-cau-tro-giup">
            <div class="asxh-row">
                <div class="asxh-col-6">
                    <h2 class="help-title">Người dân cần trợ giúp</h2>
                    <p class="help-desc">Nếu bạn hoặc người thân đang gặp khó khăn, vui lòng để lại thông tin tại đây. Mọi thông tin gửi đến sẽ được Ủy ban MTTQ Việt Nam Phường Tân Định tiếp nhận, xem xét và hỗ trợ kịp thời.</p>
                </div>
                <div class="asxh-col-6">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div style="background:#d4edda; color:#155724; padding:15px; border-radius:12px; margin-bottom:20px;">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div style="background:#f8d7da; color:#721c24; padding:15px; border-radius:12px; margin-bottom:20px;">@TempData["ErrorMessage"]</div>
                    }
                    <form action="@Url.Action("GuiYeuCauTroGiup", "CongThongTinAnSXH")" method="post">
                        @Html.AntiForgeryToken()
                        <div class="asxh-row">
                            <div class="asxh-col-6 form-group"><label class="form-label">Họ tên *</label><input type="text" name="HoTen" class="form-control" required></div>
                            <div class="asxh-col-6 form-group"><label class="form-label">Điện thoại *</label><input type="text" name="SoDienThoai" class="form-control" required></div>
                        </div>
                        <div class="form-group"><label class="form-label">Mức độ ưu tiên</label><select name="MucDoUuTien" class="form-select"><option value="Bình thường">Bình thường</option><option value="Khẩn cấp">Khẩn cấp</option></select></div>
                        <div class="form-group"><label class="form-label">Địa chỉ *</label><input type="text" name="DiaChi" class="form-control" required></div>
                        <div class="form-group"><label class="form-label">Nội dung *</label><textarea name="NoiDung" class="form-control" rows="4" required placeholder="Mô tả hoàn cảnh..."></textarea></div>
                        <button type="submit" class="btn-submit">Gửi thông tin trợ giúp</button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="custom-modal-overlay" id="mapModal" onclick="closeModal(event)">
    <div class="custom-modal-content" onclick="event.stopPropagation()">
        <button class="btn-close-modal" onclick="closeModal()">X</button>
        <div class="modal-title" id="mTitle">TÊN CHƯƠNG TRÌNH</div>
        <div class="modal-meta"><strong>Ngày:</strong> <span id="mDate"></span></div>
        <div class="modal-meta"><strong>Đơn vị:</strong> <span id="mUnit"></span></div>
        <img src="" id="mImage" class="modal-image" style="display:none;" />
        <div class="modal-desc" id="mDesc"></div>
    </div>
</div>

<!-- ==========================================
     ĐOẠN JAVASCRIPT CHUNG: LUÔN LUÔN HOẠT ĐỘNG
     ========================================== -->
<script>
    // 1. CHĂM LO FILTER
    function filterCL() {
        var input = document.getElementById("clSearch").value.toLowerCase();
        var monthVal = document.getElementById("clMonth").value.toLowerCase();
        var unitVal = document.getElementById("clUnit").value.toLowerCase();
        var table = document.getElementById("clTable");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var textThang = tr[i].cells[0].innerText.toLowerCase();
            var textDonVi = tr[i].cells[1].innerText.toLowerCase();
            var rowText = tr[i].innerText.toLowerCase();

            var matchSearch = rowText.indexOf(input) > -1;
            var matchMonth = monthVal === "" || textThang === monthVal;
            var matchUnit = unitVal === "" || textDonVi.indexOf(unitVal) > -1;

            if (matchSearch && matchMonth && matchUnit) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }

    // 2. HÀM CHUYỂN TRANG KHÔNG LOAD LẠI TRÌNH DUYỆT ĐÃ ĐƯỢC KÉO RA NGOÀI ĐỂ KHÔNG BỊ LỖI
    function loadTrangDanhSach(pageNumber) {
        var vungChua = document.getElementById('vung-chua-bang-danh-sach');
        if (!vungChua) return;

        // Làm mờ bảng để tạo hiệu ứng loading
        vungChua.style.transition = 'opacity 0.3s ease';
        vungChua.style.opacity = '0.4';
        vungChua.style.pointerEvents = 'none';

        // Lấy URL cần tải
        var fetchUrl = window.location.pathname + '?page=' + pageNumber;

        fetch(fetchUrl)
            .then(function(res) {
                return res.text();
            })
            .then(function(html) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');

                // Trích xuất đúng vùng bảng chứa danh sách
                var bangMoi = doc.getElementById('vung-chua-bang-danh-sach');

                if (bangMoi) {
                    // Đắp nội dung mới vào
                    vungChua.innerHTML = bangMoi.innerHTML;

                    // Cuộn nhẹ màn hình lên tiêu đề bảng để người dùng dễ nhìn
                    var theAnchor = document.getElementById('danh-sach-ung-ho');
                    if (theAnchor) {
                        theAnchor.scrollIntoView({ behavior: 'smooth' });
                    }

                    // Cập nhật đường dẫn trên thanh địa chỉ mà không làm giật trang
                    window.history.pushState(null, '', fetchUrl);
                }

                // Hiển thị lại bảng rõ ràng
                vungChua.style.opacity = '1';
                vungChua.style.pointerEvents = 'auto';
            })
            .catch(function(err) {
                console.error("Lỗi Fetch API:", err);
                // Phương án dự phòng: Nếu mạng lỗi, load lại trang bình thường
                window.location.href = fetchUrl;
            });
    }

    // Hàm phụ trợ đóng modal nếu không có Bản đồ
    function closeModal(e) {
        if (e && e.target.id !== 'mapModal' && e.type === 'click' && !e.target.classList.contains('btn-close-modal')) return;
        document.getElementById('mapModal').classList.remove('active');
    }
</script>

<!-- ==========================================
     ĐOẠN JAVASCRIPT RIÊNG CHO BẢN ĐỒ
     ========================================== -->
@if (ViewBag.HienThiBanDo == true)
{
    <script type="application/json" id="mapDataJson">
        @Html.Raw(ViewBag.MapDataJson ?? "[]")
    </script>
    <script>
        // 3. LEAFLET MAP & BỘ LỌC
        const mapDataElement = document.getElementById('mapDataJson').textContent;
        const rawData = JSON.parse(mapDataElement);
        let currentData = [...rawData];
        let activeFilter = "";
        const map = L.map('leafletMap').setView([10.7915, 106.6896], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        let markersLayer = L.layerGroup().addTo(map);

        fetch('https://nominatim.openstreetmap.org/lookup?osm_ids=R19260505&polygon_geojson=1&format=json')
            .then(res => res.json())
            .then(data => {
                if (data && data.length > 0 && data[0].geojson) {
                    const boundaryLayer = L.geoJSON(data[0].geojson, {
                        style: { color: "#e63946", weight: 3, fillColor: "#e63946", fillOpacity: 0.1 },
                        interactive: false
                    }).addTo(map);
                    map.fitBounds(boundaryLayer.getBounds());
                }
            });

        const unitLogos = {
            "Đoàn Thanh Niên": "/images/logo-doan.png",
            "Hội LHPN": "/images/logo-hoi-lhpn.jpg",
            "Mặt trận Tổ quốc": "https://upload.wikimedia.org/wikipedia/vi/thumb/b/b5/Mat_tran_To_quoc_Viet_Nam.svg/120px-Mat_tran_To_quoc_Viet_Nam.svg.png",
            "Default": "https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
        };

        function getLogoUrl(unitName) {
            if (!unitName) return unitLogos["Default"];
            let name = unitName.toLowerCase();
            if (name.includes("đoàn") || name.includes("thanh niên")) return unitLogos["Đoàn Thanh Niên"];
            if (name.includes("phụ nữ") || name.includes("lhpn")) return unitLogos["Hội LHPN"];
            if (name.includes("mặt trận") || name.includes("tổ quốc")) return unitLogos["Mặt trận Tổ quốc"];
            return unitLogos["Default"];
        }

        function openModal(item) {
            document.getElementById('mTitle').innerText = item.ten;
            document.getElementById('mDate').innerText = item.ngay;
            document.getElementById('mUnit').innerText = item.phanLoai;
            document.getElementById('mDesc').innerText = item.moTa;
            const imgEl = document.getElementById('mImage');
            if (item.hinhAnh) { imgEl.src = item.hinhAnh; imgEl.style.display = 'block'; } else { imgEl.style.display = 'none'; }
            document.getElementById('mapModal').classList.add('active');
        }

        function renderMap(data) {
            markersLayer.clearLayers();
            data.forEach(item => {
                if (item.viDo && item.kinhDo) {
                    const logoUrl = getLogoUrl(item.phanLoai);
                    const customIcon = L.divIcon({
                        className: 'custom-div-icon',
                        html: `<div style='background-color: white; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 2px solid #eaeaea; box-shadow: 0 4px 10px rgba(0,0,0,0.3); overflow: hidden;'>
                                                           <img src='${logoUrl}' style='width: 28px; height: 28px; object-fit: contain;' onerror="this.onerror=null; this.src='${unitLogos["Default"]}';" alt='Logo' />
                                                       </div>`,
                        iconSize: [40, 40], iconAnchor: [20, 20]
                    });
                    const marker = L.marker([item.viDo, item.kinhDo], { icon: customIcon }).addTo(markersLayer);
                    marker.on('click', () => { openModal(item); map.flyTo([item.viDo, item.kinhDo], 17, { duration: 1 }); });
                }
            });
        }

        function renderList(data) {
            const wrapper = document.getElementById('listWrapper');
            wrapper.innerHTML = "";
            data.forEach(item => {
                const card = document.createElement('div');
                card.className = "map-card";
                card.innerHTML = `<h5 class="card-title">${item.ten}</h5>
                                                          <div class="card-meta"><span style="color:#777;">📅 ${item.ngay}</span> <span class="unit-badge">${item.phanLoai}</span></div>
                                                          <div class="card-desc">${item.moTa.length > 80 ? item.moTa.substring(0, 80) + '...' : item.moTa}</div>`;
                card.onclick = () => {
                    openModal(item);
                    if (item.viDo) {
                        map.flyTo([item.viDo, item.kinhDo], 17, { duration: 1 });
                        if (window.innerWidth <= 992) switchMobileTab('map');
                    }
                };
                wrapper.appendChild(card);
            });
        }

        function renderFilterChips(units) {
            const container = document.getElementById('filterContainer');
            container.innerHTML = "";
            units.forEach(unit => {
                const chip = document.createElement('div');
                chip.className = "chip";
                chip.innerHTML = `<img src="${getLogoUrl(unit)}" onerror="this.onerror=null; this.src='${unitLogos["Default"]}';" /> ${unit}`;
                chip.onclick = () => {
                    document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
                    activeFilter = activeFilter === unit ? "" : unit;
                    if (activeFilter) chip.classList.add('active');
                    applyFilters();
                };
                container.appendChild(chip);
            });
        }

        function applyFilters() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            currentData = rawData.filter(item => {
                const matchSearch = item.ten.toLowerCase().includes(searchText) || item.phanLoai.toLowerCase().includes(searchText);
                const matchFilter = activeFilter === "" || item.phanLoai === activeFilter;
                return matchSearch && matchFilter;
            });
            renderMap(currentData);
            renderList(currentData);
            document.getElementById('hienThiCount').innerText = currentData.length;
            document.getElementById('listCountBadge').innerText = currentData.length;
            document.getElementById('mListCountBadge').innerText = currentData.length;
        }

        function clearFilters() {
            document.getElementById('searchInput').value = ""; activeFilter = "";
            document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
            applyFilters(); map.setView([10.7915, 106.6896], 15);
        }

        // 4. JS XỬ LÝ CHUYỂN TAB MOBILE
        function switchMobileTab(tab) {
            const row = document.getElementById('mapContentRow');
            const btnMap = document.getElementById('btnShowMap');
            const btnList = document.getElementById('btnShowList');

            if (tab === 'map') {
                row.classList.remove('show-list');
                btnMap.classList.add('active');
                btnList.classList.remove('active');
                setTimeout(() => { map.invalidateSize(); }, 100);
            } else {
                row.classList.add('show-list');
                btnList.classList.add('active');
                btnMap.classList.remove('active');
            }
        }

        function init() {
            renderFilterChips([...new Set(rawData.map(item => item.phanLoai))]);
            applyFilters();
        }
        init();
    </script>
}