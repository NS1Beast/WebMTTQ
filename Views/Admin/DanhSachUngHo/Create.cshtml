@model WebMTTQ.Models.DanhSachUngHo
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm lượt ủng hộ";
}

<div class="admin-page-header">
    <div>
        <h2>Thêm lượt ủng hộ mới</h2>
        <div class="subtitle">Nhập thông tin đơn vị/cá nhân ủng hộ</div>
    </div>
    <a href="/admin/danhsachungho" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card" style="max-width: 600px;">
    <div class="admin-card-body">
        <form asp-action="Create" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn lưu lượt ủng hộ mới này?');">
            @Html.AntiForgeryToken()
            <div class="admin-form-group">
                <label class="admin-form-label">Đơn vị / Cá nhân <span class="required">*</span></label>
                <input asp-for="TenNguoiUngHo" class="admin-form-control" placeholder="Nhập tên người/đơn vị ủng hộ" required />
                <span asp-validation-for="TenNguoiUngHo" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Thời gian <span class="required">*</span></label>
                <input asp-for="NgayUngHo" type="date" class="admin-form-control" required />
                <span asp-validation-for="NgayUngHo" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Giá trị ủng hộ (VNĐ) <span class="required">*</span></label>
                <input asp-for="SoTien" type="number" class="admin-form-control" placeholder="Ví dụ: 5000000" required />
                <span asp-validation-for="SoTien" class="admin-form-error"></span>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-success">
                    <i class="fas fa-save"></i> Lưu dữ liệu
                </button>
                <a href="/admin/danhsachungho" class="admin-btn admin-btn-ghost">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}