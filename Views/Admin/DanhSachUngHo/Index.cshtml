@model IEnumerable<WebMTTQ.Models.DanhSachUngHo>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách ủng hộ";
}

<div class="admin-page-header">
    <div>
        <h2>Danh sách ủng hộ</h2>
        <div class="subtitle">Quản lý các lượt ủng hộ từ tổ chức, cá nhân</div>
    </div>
    <a href="/admin/danhsachungho/Create" class="admin-btn admin-btn-primary">
        <i class="fas fa-plus"></i> Thêm lượt ủng hộ
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Đơn vị / Cá nhân</th>
                        <th>Thời gian</th>
                        <th class="cell-right">Giá trị ủng hộ</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.TenNguoiUngHo</strong></td>
                            <td>@item.NgayUngHo.ToString("dd/MM/yyyy")</td>
                            <td class="cell-right"><span class="admin-money red">@item.SoTien.ToString("N0") đ</span></td>
                            <td class="cell-actions">
                                <a href="/admin/danhsachungho/Edit/@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <form action="/admin/danhsachungho/Delete/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa?');">
                                    <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="admin-empty">
                                    <i class="fas fa-inbox"></i>
                                    <p>Chưa có dữ liệu ủng hộ nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>