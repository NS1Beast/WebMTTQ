@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan Dashboard";

    // Hàm format tiền tệ
    var culture = new System.Globalization.CultureInfo("vi-VN");
    string FormatVND(decimal amount) => amount.ToString("C0", culture);
}

<style>
    /* CSS CHO DASHBOARD HIỆN ĐẠI */
    .admin-welcome {
        background: linear-gradient(135deg, #8a1527 0%, #4a0a11 100%);
        color: white; padding: 25px 30px; border-radius: 12px; margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1); position: relative; overflow: hidden;
    }
    .admin-welcome::after {
        content: '\f19c'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
        position: absolute; right: 30px; top: -10px; font-size: 8rem; opacity: 0.1; transform: rotate(-15deg);
    }
    .admin-welcome h2 { margin: 0 0 8px 0; font-size: 1.6rem; font-family: 'Playfair Display', serif; }
    .admin-welcome p { margin: 0; font-size: 0.95rem; opacity: 0.9; }

    /* LƯỚI KPI CARDS */
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .kpi-card {
        background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.04);
        display: flex; align-items: center; transition: transform 0.3s ease;
    }
    .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
    .kpi-icon {
        width: 55px; height: 55px; border-radius: 10px; display: flex; justify-content: center; align-items: center;
        font-size: 1.6rem; margin-right: 15px; flex-shrink: 0;
    }
    .icon-money { background: rgba(212, 149, 68, 0.15); color: #d49544; }
    .icon-alert { background: rgba(220, 53, 69, 0.15); color: #dc3545; }
    .icon-news { background: rgba(0, 123, 255, 0.15); color: #007bff; }
    .icon-doc { background: rgba(111, 66, 193, 0.15); color: #6f42c1; }

    .kpi-info h4 { margin: 0; font-size: 0.85rem; color: #888; text-transform: uppercase; font-weight: bold; }
    .kpi-info p { margin: 4px 0 0 0; font-size: 1.5rem; font-weight: 700; color: #222; line-height: 1; }

    /* LƯỚI BIỂU ĐỒ */
    .dashboard-row { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 30px; }
    .dash-box { background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.04); }
    .dash-box-title { margin: 0 0 20px 0; font-size: 1.1rem; color: #333; font-weight: bold; padding-bottom: 12px; border-bottom: 1px solid #f0f0f0; }

    /* BẢNG DỮ LIỆU NHANH */
    .table-quick { width: 100%; border-collapse: collapse; }
    .table-quick th { text-align: left; padding: 12px; color: #888; font-size: 0.85rem; border-bottom: 2px solid #eee; }
    .table-quick td { padding: 12px; border-bottom: 1px solid #eee; font-size: 0.9rem; color: #444; }
    .badge { padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; }
    .bg-warning { background: #ffeeba; color: #856404; }
    .bg-success { background: #d4edda; color: #155724; }

    @@media (max-width: 992px) { .dashboard-row { grid-template-columns: 1fr; } }
</style>

<div class="admin-welcome">
    <h2>Chào mừng đến với Trung tâm Quản trị</h2>
    <p>Hệ thống Cổng thông tin Ủy ban Mặt trận Tổ quốc Việt Nam Phường Tân Định.</p>
</div>

<!-- 1. THẺ THỐNG KÊ (KPIs) -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon icon-money"><i class="fas fa-hand-holding-usd"></i></div>
        <div class="kpi-info">
            <h4>Tổng Số Dư Các Quỹ</h4>
            <p style="color:#d49544; font-size: 1.25rem;">@FormatVND(ViewBag.TongTienCacQuy ?? 0)</p>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon icon-alert"><i class="fas fa-bell"></i></div>
        <div class="kpi-info">
            <h4>Chờ xử lý (Yêu cầu & Góp ý)</h4>
            <p>@(ViewBag.TongTuongTacMoi ?? 0)</p>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon icon-news"><i class="fas fa-newspaper"></i></div>
        <div class="kpi-info">
            <h4>Tin Tức Đã Đăng</h4>
            <p>@(ViewBag.TongTinTuc ?? 0)</p>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon icon-doc"><i class="fas fa-file-signature"></i></div>
        <div class="kpi-info">
            <h4>Văn Bản Ban Hành</h4>
            <p>@(ViewBag.TongVanBan ?? 0)</p>
        </div>
    </div>
</div>

<!-- 2. KHU VỰC BIỂU ĐỒ -->
<div class="dashboard-row">
    <!-- Biểu đồ cột: Tỉ trọng các Quỹ -->
    <div class="dash-box">
        <h3 class="dash-box-title">Thống kê Số dư các Quỹ An sinh</h3>
        <canvas id="quyChart" height="110"></canvas>
    </div>

    <!-- Biểu đồ tròn: Tình trạng xử lý yêu cầu -->
    <div class="dash-box">
        <h3 class="dash-box-title">Tiến độ Phản ánh / Yêu cầu</h3>
        <div style="height: 220px; display: flex; justify-content: center;">
            <canvas id="tuongTacChart"></canvas>
        </div>
    </div>
</div>

<!-- 3. DANH SÁCH MỚI NHẤT -->
<div class="dash-box">
    <h3 class="dash-box-title" style="display: flex; justify-content: space-between; align-items: center;">
        Yêu cầu trợ giúp mới nhất
        <a href="/AdminNguoiDanCanTroGiup/Index" style="font-size: 0.85rem; color: #007bff; text-decoration: none;">Xem tất cả <i class="fas fa-arrow-right"></i></a>
    </h3>
    <div style="overflow-x:auto;">
        <table class="table-quick">
            <thead>
                <tr>
                    <th>Họ Tên</th>
                    <th>Số điện thoại</th>
                    <th>Nội dung tóm tắt</th>
                    <th>Ngày gửi</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.ListYeuCauMoi != null && Enumerable.Count(ViewBag.ListYeuCauMoi) > 0)
                {
                    foreach (var item in ViewBag.ListYeuCauMoi)
                    {
                        <tr>
                            <td style="font-weight: bold; color: #8a1527;">@item.HoTen</td>
                            <td>@item.SoDienThoai</td>
                            <td style="max-width: 350px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @item.NoiDung
                            </td>
                            <td>@(item.NgayGui?.ToString("dd/MM/yyyy"))</td>
                            <td>
                                @if (item.TrangThai == "Chưa xử lý" || string.IsNullOrEmpty(item.TrangThai))
                                {
                                    <span class="badge bg-warning">Chờ xử lý</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-check"></i> Đã xử lý</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; color: #999; padding: 20px;">Hiện tại chưa có yêu cầu phản ánh nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- THƯ VIỆN VẼ BIỂU ĐỒ CHART.JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof Chart === 'undefined') return; // Chống lỗi nếu không load được thư viện

            // --- 1. BIỂU ĐỒ CỘT (QUỸ) ---
            var ctxQuy = document.getElementById('quyChart');
            if (ctxQuy) {
                new Chart(ctxQuy.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Quỹ Vì Người Nghèo', 'Quỹ Vì Biển Đảo', 'Quỹ Cứu Trợ'],
                        datasets: [{
                            label: 'Số dư hiện tại (VNĐ)',
                            data: [
                                @(ViewBag.TienNguoiNgheo ?? 0),
                                @(ViewBag.TienBienDao ?? 0),
                                @(ViewBag.TienCuuTro ?? 0)
                            ],
                            backgroundColor: [
                                'rgba(212, 149, 68, 0.85)', // Vàng Gold
                                'rgba(0, 123, 255, 0.85)',  // Xanh dương
                                'rgba(220, 53, 69, 0.85)'   // Đỏ
                            ],
                            borderColor: ['#d49544', '#007bff', '#dc3545'],
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        if (value >= 1000000) return (value / 1000000).toLocaleString('vi-VN') + ' Triệu';
                                        return value.toLocaleString('vi-VN');
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // --- 2. BIỂU ĐỒ TRÒN (TƯƠNG TÁC) ---
            var ctxTuongTac = document.getElementById('tuongTacChart');
            if (ctxTuongTac) {
                new Chart(ctxTuongTac.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Đang chờ xử lý', 'Đã giải quyết'],
                        datasets: [{
                            data: [
                                @(ViewBag.TongTuongTacMoi ?? 0),
                                @(ViewBag.TongTuongTacDaXuLy ?? 0)
                            ],
                            backgroundColor: ['#ffc107', '#28a745'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } },
                        cutout: '65%' // Làm mỏng viền
                    }
                });
            }
        });
    </script>
}