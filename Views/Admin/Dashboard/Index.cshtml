@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng quan Dashboard";
}

<div class="admin-welcome">
    <h2>Chào mừng đến với Trung tâm Quản trị</h2>
    <p>Bảng điều khiển tổng quan hệ thống Mặt trận Tổ quốc Việt Nam Phường Tân Định. Vui lòng chọn chức năng từ thanh menu bên trái để quản lý nội dung.</p>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-newspaper"></i>
        </div>
        <div class="stat-info">
            <h4>Tổng số bài viết</h4>
            <p class="stat-number red">100</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon gold">
            <i class="fas fa-hand-holding-heart"></i>
        </div>
        <div class="stat-info">
            <h4>Lượt ủng hộ mới</h4>
            <p class="stat-number gold">100</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-info">
            <h4>Đã xử lý</h4>
            <p class="stat-number green">100</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-envelope"></i>
        </div>
        <div class="stat-info">
            <h4>Góp ý chờ xử lý</h4>
            <p class="stat-number">100</p>
        </div>
    </div>
</div>