@model IEnumerable<WebMTTQ.Models.DanhSachUngHoCuuTro>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách ủng hộ Cứu trợ";
}

<div class="admin-page-header">
    <div>
        <h2>Danh sách ủng hộ</h2>
        <div class="subtitle">Quản lý các lượt ủng hộ từ tổ chức, cá nhân</div>
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        <!-- Nút xử lý Import Excel ngầm (Không làm xấu giao diện) -->
        <form action="@Url.Action("ImportExcel")" method="post" enctype="multipart/form-data" id="formImportExcel_@ViewData["Title"].GetHashCode()" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="file" name="file" accept=".xlsx" style="display:none;" id="fileExcel_@ViewData["Title"].GetHashCode()" onchange="document.getElementById('formImportExcel_@ViewData["Title"].GetHashCode()').submit();" />
            <button type="button" class="admin-btn" style="background-color: #28a745; color: white; border: none;" onclick="document.getElementById('fileExcel_@ViewData["Title"].GetHashCode()').click();">
                <i class="fas fa-file-excel"></i> Nhập từ Excel
            </button>
        </form>

        <!-- Nút thêm thủ công bằng tay (Đổi URL href tùy theo từng quỹ) -->
        <a href="Url_To_Action_Create" class="admin-btn admin-btn-primary">
            <i class="fas fa-plus"></i> Thêm lượt ủng hộ
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Đơn vị / Cá nhân</th>
                        <th class="cell-center">Thời gian</th>
                        <th class="cell-right">Số tiền</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.TenNguoiUngHo</strong>
                                </td>
                                <td class="cell-center">
                                    <span class="admin-badge gray">@(item.NgayUngHo?.ToString("dd/MM/yyyy"))</span>
                                </td>
                                <td class="cell-right"><span class="admin-money green">@(item.SoTien?.ToString("N0"))đ</span></td>
                                <td class="cell-actions">
                                    <a href="/Admin/QuyCuuTro/SuaDanhSach/@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form action="/Admin/QuyCuuTro/XoaDanhSach" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lượt ủng hộ này?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="admin-empty">
                                    <i class="fas fa-hand-holding-usd"></i>
                                    <p>Chưa có dữ liệu ủng hộ Cứu trợ nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>