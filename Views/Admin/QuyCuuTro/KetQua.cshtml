@model IEnumerable<WebMTTQ.Models.KetQuaHoatDong>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Hoạt động Cứu trợ";
    var tongKinhPhi = Model?.Sum(x => x.KinhPhi) ?? 0;
    var tongHoatDong = Model?.Count() ?? 0;
    var tongDoiTuong = Model?.Sum(x => x.SoLuongHo) ?? 0;
}

<div class="fund-hero-bar">
    <div class="fund-hero-content">
        <h2>Hoạt động Cứu trợ</h2>
        <p>Quản lý các chương trình, hoạt động hỗ trợ cộng đồng</p>
    </div>
    <div class="fund-hero-stats">
        <div class="fund-hero-stat">
            <div class="stat-label">Số hoạt động</div>
            <div class="stat-number">@tongHoatDong <small>hoạt động</small></div>
        </div>
        <div class="fund-hero-stat">
            <div class="stat-label">Tổng kinh phí</div>
            <div class="stat-number">@tongKinhPhi.ToString("N0")<small>đ</small></div>
        </div>
        <div class="fund-hero-stat">
            <div class="stat-label">Đối tượng hỗ trợ</div>
            <div class="stat-number">@tongDoiTuong <small>lượt</small></div>
        </div>
    </div>
    <div class="fund-hero-actions">
        <a href="/Admin/QuyCuuTro/ThemKetQua" class="admin-btn admin-btn-primary">
            <i class="fas fa-plus"></i> Thêm hoạt động mới
        </a>
    </div>
</div>

<div class="fund-tabs">
    <a href="/Admin/QuyCuuTro/ThongTin" class="fund-tab"><i class="fas fa-university"></i> Tài khoản tiếp nhận</a>
    <a href="/Admin/QuyCuuTro/DanhSach" class="fund-tab"><i class="fas fa-hand-holding-usd"></i> Danh sách ủng hộ</a>
    <a href="/Admin/QuyCuuTro/SoDu" class="fund-tab"><i class="fas fa-wallet"></i> Số dư quỹ</a>
    <a href="/Admin/QuyCuuTro/KetQua" class="fund-tab is-active"><i class="fas fa-shield-alt"></i> Hoạt động</a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="cell-center">Tháng</th>
                        <th>Đơn vị thực hiện</th>
                        <th>Nội dung</th>
                        <th class="cell-center">SL</th>
                        <th class="cell-right">Kinh phí</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="cell-center">
                                    <span class="admin-badge blue">Tháng @item.Thang/@item.Nam</span>
                                </td>
                                <td>
                                    <strong>@item.DonViUngHo</strong>
                                    <div style="font-size:0.78rem;color:var(--admin-muted);">Nhóm: @item.PhanLoaiDonVi</div>
                                </td>
                                <td>@item.NoiDung</td>
                                <td class="cell-center">@item.SoLuongHo</td>
                                <td class="cell-right"><span class="admin-money blue">@(item.KinhPhi?.ToString("N0"))đ</span></td>
                                <td class="cell-actions">
                                    <div class="admin-row-actions">
                                        <a href="/Admin/QuyCuuTro/SuaKetQua/@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <form action="/Admin/QuyCuuTro/XoaKetQua" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa hoạt động này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                                <i class="fas fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty">
                                    <i class="fas fa-shield-alt"></i>
                                    <p>Chưa có dữ liệu hoạt động Cứu trợ nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-result-info" style="padding: 14px 16px;">
            <span>Tổng số hoạt động: <strong>@tongHoatDong</strong></span>
            <span>Tổng kinh phí: <strong>@tongKinhPhi.ToString("N0")đ</strong></span>
        </div>
    </div>
</div>