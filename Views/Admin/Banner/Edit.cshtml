@model WebMTTQ.Models.Banner

@{
    ViewData["Title"] = "Cập nhật Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card" style="background:#fff; padding:30px; border-radius:12px; max-width: 800px; margin: 0 auto; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
    <h2 style="margin-bottom: 25px; color: #333; border-bottom: 1px solid #eee; padding-bottom: 15px;">Cập nhật Banner #@Model.IdBanner</h2>

    <!-- THÊM enctype="multipart/form-data" -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="IdBanner" />
        <input type="hidden" asp-for="HinhAnh" /> <!-- Giữ lại ảnh cũ ẩn đi để tránh mất data -->

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">Tiêu đề Banner <span style="color:red;">*</span></label>
            <input asp-for="TieuDe" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;" required />
        </div>

        <!-- UPLOAD FILE TÙY CHỌN -->
        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">Đổi Hình ảnh mới (Dưới 3MB - Bỏ trống nếu muốn giữ ảnh cũ)</label>
            <input type="file" name="FileAnh" id="FileAnh" accept="image/*" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px;" />
            @Html.ValidationMessage("HinhAnh", "", new { @style = "color:red; font-size: 0.9rem; display:block; margin-top:5px;" })

            <div style="margin-top: 15px;">
                <p style="margin-bottom: 5px; font-size: 0.9rem; color: #666;">Ảnh hiện tại đang xem trước:</p>
                <img id="imagePreview" src="@Model.HinhAnh" style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 1px solid #ddd;" />
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">Liên kết khi click vào</label>
            <input asp-for="LienKet" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 8px;">Vị trí sắp xếp</label>
                <input asp-for="ThuTu" type="number" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 8px;">Trạng thái hiển thị</label>
                <select asp-for="TrangThai" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;">
                    <option value="true">Hiển thị</option>
                    <option value="false">Ẩn</option>
                </select>
            </div>
        </div>

        <div style="display: flex; gap: 15px;">
            <button type="submit" style="background: #17a2b8; color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer;">Lưu thay đổi</button>
            <a href="@Url.Action("Index", "AdminBanner")" style="background: #6c757d; color: white; padding: 12px 25px; border-radius: 6px; text-decoration: none; font-weight: bold;">Hủy / Quay lại</a>
        </div>
    </form>
</div>

<!-- JAVASCRIPT KIỂM TRA FILE VÀ ĐỔI ẢNH XEM TRƯỚC -->
<script>
    document.getElementById('FileAnh').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            // Kiểm tra dung lượng (3MB)
            if (file.size > 3145728) {
                alert('Dung lượng ảnh vượt quá 3MB. Vui lòng chọn ảnh nhẹ hơn.');
                this.value = ''; // Reset input
                return;
            }

            // Thay đổi ảnh xem trước ngay lập tức
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imagePreview').src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
</script>