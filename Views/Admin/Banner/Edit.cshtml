@model WebMTTQ.Models.Banner

@{
    ViewData["Title"] = "Cập nhật Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card" style="background:#fff; padding:30px; border-radius:12px; max-width: 900px; margin: 0 auto; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 15px;">
        <a href="@Url.Action("Banner", "AdminTrangChu")" style="color: #666; text-decoration: none; font-size: 1.2rem;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h2 style="margin: 0; color: #333;">Cập nhật Banner #@Model.IdBanner</h2>
    </div>

    <form asp-action="BannerEdit" asp-controller="AdminTrangChu" method="post" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn lưu các thay đổi của Banner này?');">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdBanner" />
        <input type="hidden" asp-for="HinhAnh" />

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">Đổi Hình ảnh mới (Dưới 3MB - Bỏ trống nếu muốn giữ ảnh cũ)</label>
            <input type="file" name="FileAnh" id="FileAnh" accept="image/*" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px;" />
            @Html.ValidationMessage("HinhAnh", "", new { @style = "color:red; font-size: 0.9rem; display:block; margin-top:5px;" })

            <div style="margin-top: 15px;">
                <p style="margin-bottom: 5px; font-size: 0.9rem; color: #666;">Ảnh hiện tại:</p>
                <img id="imagePreview" src="@Model.HinhAnh" style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 1px solid #ddd;" />
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">Liên kết khi click vào</label>
            <input asp-for="LienKet" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 8px;">Vị trí sắp xếp</label>
                <input asp-for="ThuTu" type="number" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;" />
            </div>
            <div>
                <label style="display: block; font-weight: bold; margin-bottom: 8px;">Trạng thái hiển thị</label>
                <select asp-for="TrangThai" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;">
                    <option value="true">Hiển thị</option>
                    <option value="false">Ẩn</option>
                </select>
            </div>
        </div>

        <!-- Advanced Settings -->
        <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h3 style="margin: 0 0 15px; font-size: 1rem; color: #555; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-sliders-h"></i> Cài đặt hiệu ứng nâng cao
            </h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem;">Hiệu ứng chuyển</label>
                    <select asp-for="HieuUng" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px;">
                        <option value="slide">Trượt ngang (Slide)</option>
                        <option value="fade">Mờ dần (Fade)</option>
                        <option value="zoom">Thu phóng (Zoom)</option>
                        <option value="centered">Carousel căn giữa (Centered Carousel)</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem;">Tốc độ chuyển (ms)</label>
                    <input asp-for="TocDo" type="number" min="200" step="100" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px;" />
                    <small style="color: #888;">Càng nhỏ càng nhanh</small>
                </div>
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem;">Thời gian dừng (ms)</label>
                    <input asp-for="ThoiGianDung" type="number" min="1000" step="500" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px;" />
                    <small style="color: #888;">Thời gian hiển thị mỗi slide</small>
                </div>
            </div>
            <div style="margin-top: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem;">Màu nền (khi ảnh chưa tải)</label>
                    <input asp-for="MauNen" type="color" class="form-control" style="width: 100%; padding: 4px; border: 1px solid #ccc; border-radius: 6px; height: 40px;" />
                </div>
            </div>
        </div>

        <div style="display: flex; gap: 15px; justify-content: flex-end;">
            <a href="@Url.Action("Banner", "AdminTrangChu")" style="background: #6c757d; color: white; padding: 12px 25px; border-radius: 6px; text-decoration: none; font-weight: bold;">Hủy / Quay lại</a>
            <button type="submit" style="background: #17a2b8; color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer;">
                <i class="fas fa-save"></i> Lưu thay đổi
            </button>
        </div>
    </form>
</div>

<script>
    document.getElementById('FileAnh').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            if (file.size > 3145728) {
                alert('Dung lượng ảnh vượt quá 3MB. Vui lòng chọn ảnh nhẹ hơn.');
                this.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imagePreview').src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
</script>