@model IEnumerable<WebMTTQ.Models.Banner>

@{
    ViewData["Title"] = "Quản lý Banner Trang chủ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .tc-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 0; }
    .tc-tab {
        padding: 12px 24px; border-radius: 8px 8px 0 0; text-decoration: none;
        font-weight: 600; font-size: 0.95rem; color: #666; background: #f8f9fa;
        border: 1px solid #eee; border-bottom: none; transition: all 0.3s;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .tc-tab:hover { background: #e9ecef; color: #333; }
    .tc-tab.active { background: #8b1a2b; color: white; border-color: #8b1a2b; }
</style>

<div class="admin-card" style="background:#fff; padding:25px; border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="margin: 0; color: #333; font-size: 1.5rem;">Quản lý Banner</h2>
        <a href="@Url.Action("BannerCreate", "AdminTrangChu")" class="btn" style="background: #28a745; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold;">
            <i class="fas fa-plus"></i> Thêm Banner mới
        </a>
    </div>

    <!-- Tabs -->
    <div class="tc-tabs">
        <a href="@Url.Action("Index", "AdminTrangChu")" class="tc-tab"><i class="fas fa-layer-group"></i> Mục nội dung</a>
        <a href="@Url.Action("Banner", "AdminTrangChu")" class="tc-tab active"><i class="fas fa-images"></i> Quản lý Banner</a>
        <a href="@Url.Action("Timeline", "AdminTrangChu")" class="tc-tab"><i class="fas fa-stream"></i> Hành trình chuyển đổi số</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #f8f9fa; text-align: left; border-bottom: 2px solid #ddd;">
                <th style="padding: 15px;">Hình ảnh</th>
                <th style="padding: 15px;">Hiệu ứng</th>
                <th style="padding: 15px;">Thứ tự</th>
                <th style="padding: 15px;">Trạng thái</th>
                <th style="padding: 15px; text-align: center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 15px; width: 250px;">
                            <img src="@item.HinhAnh" alt="Banner" style="width: 100%; height: auto; max-height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" />
                        </td>
                        <td style="padding: 15px;">
                            @switch (item.HieuUng)
                            {
                                case "fade":
                                    <span style="background: #e2e3e5; color: #383d41; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Mờ dần (Fade)</span>
                                    break;
                                case "zoom":
                                    <span style="background: #d1ecf1; color: #0c5460; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Thu phóng (Zoom)</span>
                                    break;
                                case "centered":
                                    <span style="background: #cce5ff; color: #004085; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Centered Carousel</span>
                                    break;
                                default:
                                    <span style="background: #f8f9fa; color: #495057; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Trượt ngang (Slide)</span>
                                    break;
                            }
                        </td>
                        <td style="padding: 15px;">@item.ThuTu</td>
                        <td style="padding: 15px;">
                            @if (item.TrangThai)
                            {
                                <span style="background: #d4edda; color: #155724; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Hiển thị</span>
                            }
                            else
                            {
                                <span style="background: #f8d7da; color: #721c24; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Đang ẩn</span>
                            }
                        </td>
                        <td style="padding: 15px; text-align: center;">
                            <form asp-action="BannerToggleStatus" asp-controller="AdminTrangChu" asp-route-id="@item.IdBanner" method="post" style="display:inline;" onsubmit="return confirm('Đổi trạng thái hiển thị?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="color: @(item.TrangThai ? "#856404" : "#28a745"); background: @(item.TrangThai ? "#fff3cd" : "#d4edda"); border: none; cursor: pointer; font-size: 0.9rem; padding: 5px 10px; border-radius: 6px; font-weight: 600; margin-right: 8px;">
                                    <i class="fas fa-eye@(item.TrangThai ? "-slash" : "")"></i> @(item.TrangThai ? "Ẩn" : "Hiện")
                                </button>
                            </form>
                            <a href="@Url.Action("BannerEdit", "AdminTrangChu", new { id = item.IdBanner })" style="color: #17a2b8; margin-right: 15px; text-decoration: none;"><i class="fas fa-edit"></i> Sửa</a>

                            <form asp-action="BannerDelete" asp-controller="AdminTrangChu" asp-route-id="@item.IdBanner" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa Banner này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="color: #dc3545; background: none; border: none; cursor: pointer; font-size: 1rem;"><i class="fas fa-trash"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align: center; padding: 30px; color: #888;">Chưa có Banner nào được thêm.</td>
                </tr>
            }
        </tbody>
    </table>
</div>