@model WebMTTQ.Models.DoanTheToChuc
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa thành viên tổ chức";
}

<style>
    /* CSS TÙY CHỈNH CHO FORM HIỆN ĐẠI (GIỐNG CREATE) */
    .admin-form-container {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        padding: 30px;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0f0f0;
    }

        .form-header h2 {
            margin: 0;
            font-size: 1.4rem;
            color: #333;
        }

        .form-header .back-btn {
            color: #555;
            text-decoration: none;
            font-size: 1.2rem;
            transition: 0.2s;
        }

            .form-header .back-btn:hover {
                color: #8a1527;
                transform: translateX(-3px);
            }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .admin-form-group {
        margin-bottom: 15px;
    }

        .admin-form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #444;
            font-size: 0.9rem;
        }

    .admin-input, .admin-select, .admin-textarea {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: border-color 0.3s;
        box-sizing: border-box;
    }

        .admin-input:focus, .admin-select:focus, .admin-textarea:focus {
            border-color: #8a1527;
            outline: none;
            box-shadow: 0 0 0 3px rgba(138, 21, 39, 0.1);
        }

    .color-picker-wrapper {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .color-input {
        width: 50px;
        height: 40px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        padding: 0;
        background: transparent;
    }

        .color-input::-webkit-color-swatch-wrapper {
            padding: 0;
        }

        .color-input::-webkit-color-swatch {
            border: none;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #f0f0f0;
    }

    .btn-cancel {
        padding: 10px 20px;
        border: 1px solid #ddd;
        background: #fff;
        color: #555;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #f5f5f5;
            color: #333;
        }

    .btn-save {
        padding: 10px 25px;
        border: none;
        background: #28a745;
        color: #fff;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-save:hover {
            background: #218838;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(40, 167, 69, 0.3);
        }

    .img-preview-box {
        margin-top: 10px;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        border: 2px dashed #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f9f9f9;
    }

        .img-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-form-container">
    <div class="form-header">
        <a href="/admin/doanthe" class="back-btn"><i class="fas fa-arrow-left"></i></a>
        <h2>Sửa thông tin thành viên</h2>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-grid">
            <div class="admin-form-group">
                <label>Họ và Tên</label>
                <input asp-for="HoTen" class="admin-input" required />
            </div>

            <div class="admin-form-group">
                <label>Cấp độ hiển thị</label>
                <select asp-for="CapDo" class="admin-select">
                    <option value="1">Cấp 1 (Chủ tịch - Trên cùng)</option>
                    <option value="2">Cấp 2 (Thành viên - Khối dưới)</option>
                </select>
            </div>

            <div class="admin-form-group">
                <label>Chức vụ chính</label>
                <input asp-for="ChucVu" class="admin-input" />
            </div>

            <div class="admin-form-group">
                <label>Cơ quan / Tổ chức</label>
                <input asp-for="CoQuan" class="admin-input" />
            </div>

            <div class="admin-form-group full-width">
                <label>Vai trò bổ sung (Mỗi vai trò 1 dòng)</label>
                <textarea asp-for="VaiTroBoSung" class="admin-textarea" rows="3"></textarea>
            </div>

            <div class="admin-form-group">
                <label>Màu sắc chủ đạo (Viền khung)</label>
                <div class="color-picker-wrapper">
                    <input type="color" asp-for="MauSac" class="color-input" />
                    <span style="color: #666; font-size: 0.85rem;">Chọn màu đặc trưng</span>
                </div>
            </div>

            <div class="admin-form-group">
                <label>Thứ tự sắp xếp</label>
                <input asp-for="ThuTu" type="number" class="admin-input" />
            </div>

            <div class="admin-form-group full-width">
                <label>Ảnh đại diện / Logo (Để trống nếu giữ nguyên)</label>
                <input type="file" name="FileAnh" class="admin-input" accept="image/*" id="imgInp" />
                <div class="img-preview-box" style="border-color: @Model.MauSac;">
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img id="preview" src="@Model.HinhAnh" alt="Preview" />
                        <i class="fas fa-image" id="previewIcon" style="display:none;"></i>
                    }
                    else
                    {
                        <img id="preview" src="#" alt="Preview" style="display:none;" />
                        <i class="fas fa-image" id="previewIcon" style="color: #ccc; font-size: 1.5rem;"></i>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/admin/doanthe" class="btn-cancel">Hủy</a>
            <button type="submit" class="btn-save"><i class="fas fa-save"></i> Cập nhật</button>
        </div>
    </form>
</div>

<script>
    imgInp.onchange = evt => {
        const [file] = imgInp.files
        if (file) {
            preview.src = URL.createObjectURL(file)
            preview.style.display = "block";
            var icon = document.getElementById("previewIcon");
            if (icon) icon.style.display = "none";
        }
    }
</script>