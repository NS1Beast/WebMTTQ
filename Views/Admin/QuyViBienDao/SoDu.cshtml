@model IEnumerable<WebMTTQ.Models.SoDuQuy>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Số dư Quỹ Biển Đảo";
    var latest = Model?.FirstOrDefault();
    var tongCong = Model?.Count() ?? 0;
}

<div class="fund-hero-bar">
    <div class="fund-hero-content">
        <h2>Số dư Quỹ Biển Đảo</h2>
        <p>Theo dõi số dư quỹ qua các thời điểm để minh bạch, công khai</p>
    </div>
    <div class="fund-hero-stats">
        @if (latest != null)
        {
            <div class="fund-hero-stat">
                <div class="stat-label">Tổng tồn quỹ hiện tại</div>
                <div class="stat-number">@latest.TongTonQuy?.ToString("N0")<small>đ</small></div>
                <div class="stat-sub">Cập nhật: @latest.NgayCapNhat?.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="fund-hero-stat">
                <div class="stat-label">Tiền mặt</div>
                <div class="stat-number">@latest.TienMat?.ToString("N0")<small>đ</small></div>
            </div>
            <div class="fund-hero-stat">
                <div class="stat-label">Tiền gửi ngân hàng</div>
                <div class="stat-number">@latest.TienGuiNganHang?.ToString("N0")<small>đ</small></div>
            </div>
        }
    </div>
    <div class="fund-hero-actions">
        <a href="/AdminQuyBienDao/ThemSoDu" class="admin-btn admin-btn-primary">
            <i class="fas fa-plus"></i> Cập nhật số dư mới
        </a>
    </div>
</div>

<div class="fund-tabs">
    <a href="/AdminQuyBienDao/ThongTin" class="fund-tab"><i class="fas fa-university"></i> Tài khoản tiếp nhận</a>
    <a href="/AdminQuyBienDao/DanhSach" class="fund-tab"><i class="fas fa-hand-holding-usd"></i> Danh sách ủng hộ</a>
    <a href="/AdminQuyBienDao/SoDu" class="fund-tab is-active"><i class="fas fa-wallet"></i> Số dư quỹ</a>
    <a href="/AdminQuyBienDao/KetQua" class="fund-tab"><i class="fas fa-ship"></i> Hoạt động</a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ngày cập nhật</th>
                        <th class="cell-right">Tiền mặt</th>
                        <th class="cell-right">Tiền gửi ngân hàng</th>
                        <th class="cell-right">Tổng tồn quỹ</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item == Model.First() ? "admin-table-highlight" : "")">
                                <td>
                                    <strong>@(item.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm"))</strong>
                                    @if (item == Model.First())
                                    {
                                        <span class="admin-badge green" style="margin-left:6px;">Mới nhất</span>
                                    }
                                </td>
                                <td class="cell-right"><span class="admin-money green">@(item.TienMat?.ToString("N0"))đ</span></td>
                                <td class="cell-right"><span class="admin-money blue">@(item.TienGuiNganHang?.ToString("N0"))đ</span></td>
                                <td class="cell-right"><span class="admin-money red" style="font-size: 1.1rem;">@(item.TongTonQuy?.ToString("N0"))đ</span></td>
                                <td class="cell-actions">
                                    <div class="admin-row-actions">
                                        <a href="/AdminQuyBienDao/SuaSoDu/@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <form action="/AdminQuyBienDao/XoaSoDu" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa số dư này?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                                <i class="fas fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="admin-empty">
                                    <i class="fas fa-wallet"></i>
                                    <p>Chưa có lịch sử cập nhật số dư nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-result-info" style="padding: 14px 16px;">
            <span>Tổng số lần cập nhật: <strong>@tongCong</strong></span>
        </div>
    </div>
</div>