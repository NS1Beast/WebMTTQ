@model WebMTTQ.Models.ThongTinNhanUngHoBienDao
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa tài khoản Biển Đảo";
}

<div class="admin-page-header">
    <div>
        <h2>Chỉnh sửa thông tin tài khoản</h2>
        <div class="subtitle">Cập nhật thông tin tài khoản ngân hàng tiếp nhận</div>
    </div>
    <a href="/AdminQuyBienDao/ThongTin" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form action="/AdminQuyBienDao/SuaThongTin" method="post" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn lưu các thay đổi của tài khoản này?');">
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="TrangThai" value="true" />
            <!-- Lưu giữ URL ảnh cũ trong trường hợp người dùng không chọn ảnh mới -->
            <input type="hidden" name="QrCodeUrl" value="@Model.QrCodeUrl" />

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Tên ngân hàng <span class="required">*</span></label>
                    <input type="text" name="TenNganHang" value="@Model.TenNganHang" class="admin-form-control" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Chi nhánh <span class="required">*</span></label>
                    <input type="text" name="ChiNhanh" value="@Model.ChiNhanh" class="admin-form-control" required />
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Số tài khoản <span class="required">*</span></label>
                    <input type="text" name="SoTaiKhoan" value="@Model.SoTaiKhoan" class="admin-form-control" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Tên tài khoản <span class="required">*</span></label>
                    <input type="text" name="TenTaiKhoan" value="@Model.TenTaiKhoan" class="admin-form-control" required />
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Đơn vị thụ hưởng <span class="required">*</span></label>
                <input type="text" name="DonViThuHuong" value="@Model.DonViThuHuong" class="admin-form-control" required />
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Cập nhật Ảnh QR Code (Để trống nếu muốn giữ ảnh cũ - Tối đa 2MB)</label>
                <input type="file" name="QrCodeFile" id="QrCodeFile" class="admin-form-control" accept="image/*" style="padding: 7px 14px;" onchange="checkFileSize(this)" />
            </div>

            @if (!string.IsNullOrEmpty(Model.QrCodeUrl))
            {
                <div class="admin-form-group">
                    <label class="admin-form-label" style="color: #666;">Ảnh hiện tại:</label>
                    <div style="border: 1px solid #d6eaff; padding: 10px; border-radius: 8px; display: inline-block; background: #fdfdfd;">
                        <img src="@Model.QrCodeUrl" alt="QR Code" style="max-width: 150px; max-height: 150px; object-fit: contain; display: block;" />
                    </div>
                </div>
            }

            <div class="admin-form-group">
                <label class="admin-form-label">Nội dung chuyển khoản mẫu <span class="required">*</span></label>
                <input type="text" name="NoiDungChuyenKhoan" value="@Model.NoiDungChuyenKhoan" class="admin-form-control" required />
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary" style="background: #0056b3;">
                    <i class="fas fa-save"></i> Cập nhật thay đổi
                </button>
                <a href="/AdminQuyBienDao/ThongTin" class="admin-btn admin-btn-ghost">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

<script>
    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            var fileSize = input.files[0].size;
            var maxSize = 2 * 1024 * 1024; // 2MB
            if (fileSize > maxSize) {
                alert("Kích thước ảnh vượt quá 2MB. Vui lòng chọn ảnh khác nhẹ hơn!");
                input.value = "";
            }
        }
    }
</script>