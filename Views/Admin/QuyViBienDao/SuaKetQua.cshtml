@model WebMTTQ.Models.KetQuaHoatDong
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa Hoạt động Biển Đảo";
}

<div class="admin-page-header">
    <div>
        <h2>Chỉnh sửa Hoạt động Biển Đảo</h2>
        <div class="subtitle">Cập nhật thông tin chi tiết chương trình</div>
    </div>
    <a href="/AdminQuyBienDao/KetQua" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form action="/AdminQuyBienDao/SuaKetQua" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn lưu các thay đổi của hoạt động này?');">
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="TrangThai" value="true" />

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Tháng <span class="required">*</span></label>
                    <input type="number" name="Thang" value="@Model.Thang" min="1" max="12" class="admin-form-control" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Năm <span class="required">*</span></label>
                    <input type="number" name="Nam" value="@Model.Nam" class="admin-form-control" required />
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Đơn vị thực hiện <span class="required">*</span></label>
                    <input type="text" name="DonViUngHo" value="@Model.DonViUngHo" class="admin-form-control" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Nhóm đơn vị <span class="required">*</span></label>
                    <select name="PhanLoaiDonVi" class="admin-form-control" required>
                        <option value="Mặt trận Tổ quốc" selected="@(Model.PhanLoaiDonVi == "Mặt trận Tổ quốc")">Mặt trận Tổ quốc</option>
                        <option value="Đoàn Thanh Niên" selected="@(Model.PhanLoaiDonVi == "Đoàn Thanh Niên")">Đoàn Thanh Niên</option>
                        <option value="Hội LHPN" selected="@(Model.PhanLoaiDonVi == "Hội LHPN")">Hội LHPN</option>
                        <option value="Khối Doanh nghiệp" selected="@(Model.PhanLoaiDonVi == "Khối Doanh nghiệp")">Khối Doanh nghiệp</option>
                        <option value="Khác" selected="@(Model.PhanLoaiDonVi == "Khác")">Khác</option>
                    </select>
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Nội dung hoạt động <span class="required">*</span></label>
                <textarea name="NoiDung" class="admin-form-control" required>@Model.NoiDung</textarea>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Số lượng đối tượng thụ hưởng <span class="required">*</span></label>
                    <input type="number" name="SoLuongHo" value="@Model.SoLuongHo" class="admin-form-control" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Kinh phí (VNĐ) <span class="required">*</span></label>
                    <input type="number" name="KinhPhi" value="@Model.KinhPhi" class="admin-form-control" required />
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="fas fa-save"></i> Cập nhật thay đổi
                </button>
                <a href="/AdminQuyBienDao/KetQua" class="admin-btn admin-btn-ghost">Hủy</a>
            </div>
        </form>
    </div>
</div>