@model WebMTTQ.Models.DanhSachUngHoBienDao
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm lượt ủng hộ Biển Đảo";
}

<div class="admin-page-header">
    <div>
        <h2>Thêm lượt ủng hộ mới</h2>
        <div class="subtitle">Ghi nhận thông tin đóng góp của cá nhân/tổ chức</div>
    </div>
    <a href="/AdminQuyBienDao/DanhSach" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form action="/AdminQuyBienDao/ThemDanhSach" method="post">

            <div class="admin-form-group">
                <label class="admin-form-label">Cá nhân / Đơn vị ủng hộ <span class="required">*</span></label>
                <input type="text" name="TenNguoiUngHo" class="admin-form-control" required />
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Thời gian ủng hộ <span class="required">*</span></label>
                    <input type="date" name="NgayUngHo" class="admin-form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Số tiền ủng hộ (VNĐ) <span class="required">*</span></label>
                    <input type="number" name="SoTien" class="admin-form-control" required />
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="fas fa-save"></i> Thêm dữ liệu
                </button>
                <a href="/AdminQuyBienDao/DanhSach" class="admin-btn admin-btn-ghost">Hủy</a>
            </div>
        </form>
    </div>
</div>