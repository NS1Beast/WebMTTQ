@model IEnumerable<WebMTTQ.Models.KetQuaHoatDongBienDao>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Kết quả hoạt động Biển Đảo";
}

<div class="admin-page-header">
    <div>
        <h2>Lịch sử Hoạt động hướng về Biển Đảo</h2>
        <div class="subtitle">Quản lý các chương trình hỗ trợ chiến sĩ, ngư dân và bảo vệ biển đảo</div>
    </div>
    <a href="/AdminQuyBienDao/ThemKetQua" class="admin-btn admin-btn-primary">
        <i class="fas fa-plus"></i> Thêm hoạt động mới
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="cell-center">Tháng</th>
                        <th>Đơn vị thực hiện</th>
                        <th>Nội dung</th>
                        <th class="cell-center">SL</th>
                        <th class="cell-right">Kinh phí</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="cell-center">
                                    <span class="admin-badge blue">Tháng @item.Thang/@item.Nam</span>
                                </td>
                                <td>
                                    <strong>@item.DonViUngHo</strong>
                                    <div style="font-size:0.78rem;color:var(--admin-muted);">Nhóm: @item.PhanLoaiDonVi</div>
                                </td>
                                <td>@item.NoiDung</td>
                                <td class="cell-center">@item.SoLuongHo</td>
                                <td class="cell-right"><span class="admin-money blue">@(item.KinhPhi?.ToString("N0"))đ</span></td>
                                <td class="cell-actions">
                                    <a href="/AdminQuyBienDao/SuaKetQua/@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form action="/AdminQuyBienDao/XoaKetQua" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa hoạt động này?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty">
                                    <i class="fas fa-shield-alt"></i>
                                    <p>Chưa có dữ liệu hoạt động Biển Đảo nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>