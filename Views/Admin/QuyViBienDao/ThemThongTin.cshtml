@model WebMTTQ.Models.ThongTinNhanUngHoBienDao
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm tài khoản Biển Đảo";
}

<div class="admin-page-header">
    <div>
        <h2>Thêm thông tin tài khoản</h2>
        <div class="subtitle">Thêm mới thông tin tài khoản ngân hàng tiếp nhận Quỹ Biển Đảo</div>
    </div>
    <a href="/AdminQuyBienDao/ThongTin" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form action="/AdminQuyBienDao/ThemThongTin" method="post" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn thêm tài khoản mới này?');">
            @Html.AntiForgeryToken()

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Tên ngân hàng <span class="required">*</span></label>
                    <input type="text" name="TenNganHang" class="admin-form-control" required placeholder="VD: Agribank" />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Chi nhánh <span class="required">*</span></label>
                    <input type="text" name="ChiNhanh" class="admin-form-control" required placeholder="VD: Tp. Hồ Chí Minh" />
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Số tài khoản <span class="required">*</span></label>
                    <input type="text" name="SoTaiKhoan" class="admin-form-control" required />
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Tên tài khoản <span class="required">*</span></label>
                    <input type="text" name="TenTaiKhoan" class="admin-form-control" required placeholder="QUỸ VÌ BIỂN ĐẢO QUÊ HƯƠNG..." />
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Đơn vị thụ hưởng <span class="required">*</span></label>
                <input type="text" name="DonViThuHuong" class="admin-form-control" value="Quỹ vì biển đảo quê hương Phường Tân Định" required />
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Ảnh QR Code (Tối đa 2MB)</label>
                <input type="file" name="QrCodeFile" id="QrCodeFile" class="admin-form-control" accept="image/*" style="padding: 7px 14px;" onchange="checkFileSize(this)" />
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Nội dung chuyển khoản mẫu <span class="required">*</span></label>
                <input type="text" name="NoiDungChuyenKhoan" class="admin-form-control" value="HO TEN - SODIENTHOAI" required />
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary" style="background: #0056b3;">
                    <i class="fas fa-save"></i> Cập nhật (Lưu mới)
                </button>
                <a href="/AdminQuyBienDao/ThongTin" class="admin-btn admin-btn-ghost">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

<script>
    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            var fileSize = input.files[0].size; // Kích thước tính bằng byte
            var maxSize = 2 * 1024 * 1024; // 2MB
            if (fileSize > maxSize) {
                alert("Kích thước ảnh vượt quá 2MB. Vui lòng chọn ảnh khác nhẹ hơn!");
                input.value = ""; // Xóa file đã chọn để người dùng không gửi lên được
            }
        }
    }
</script>