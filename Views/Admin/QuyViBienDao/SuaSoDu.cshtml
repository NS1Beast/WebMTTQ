@model WebMTTQ.Models.SoDuQuy
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa số dư Quỹ Biển Đảo";
}

<div class="admin-page-header">
    <div>
        <h2>Chỉnh sửa số dư Quỹ Biển Đảo</h2>
        <div class="subtitle">Cập nhật lại thông tin số dư đã lưu</div>
    </div>
    <a href="/AdminQuyBienDao/SoDu" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form action="/AdminQuyBienDao/SuaSoDu" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn lưu các thay đổi của số dư này?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="NgayCapNhat" value="@Model.NgayCapNhat?.ToString("yyyy-MM-ddTHH:mm:ss")" />

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Tiền mặt (VNĐ) <span class="required">*</span></label>
                    <input type="number" name="TienMat" value="@Model.TienMat" class="admin-form-control" required />
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Tiền gửi ngân hàng (VNĐ) <span class="required">*</span></label>
                    <input type="number" name="TienGuiNganHang" value="@Model.TienGuiNganHang" class="admin-form-control" required />
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary" style="background: #0056b3; border: none; box-shadow: 0 2px 8px rgba(0, 86, 179, 0.2);">
                    <i class="fas fa-save"></i> Cập nhật thay đổi
                </button>
                <a href="/AdminQuyBienDao/SoDu" class="admin-btn admin-btn-ghost">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>