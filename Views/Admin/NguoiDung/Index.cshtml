@model WebMTTQ.Models.QuanLyNguoiDungIndexViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quan ly nguoi dung";
}

<div class="admin-page-header" style="margin-bottom:20px;">
    <div>
        <h2><i class="fas fa-users"></i> Quan ly nguoi dung</h2>
        <div class="subtitle">Tao, chinh sua, phan quyen va quan ly tai khoan truy cap</div>
    </div>
    <div style="display:flex; gap:10px;">
        <a href="/AdminNguoiDung/VaiTro" class="admin-btn" style="padding:10px 20px;border-radius:10px;background:rgba(139,26,43,0.1);color:#8b1a2b;">
            <i class="fas fa-users-cog"></i> Quan ly vai tro
        </a>
            <a href="/AdminNguoiDung/Create" class="admin-btn admin-btn-success" style="padding:10px 20px;border-radius:10px;">
            <i class="fas fa-user-plus"></i> Tao nguoi dung
        </a>
    </div>
</div>

<!-- Bo loc tim kiem -->
<div class="admin-filter-bar" style="background:#fff; border:1px solid #eae5e1; border-radius:12px; padding:16px 20px; margin-bottom:20px; display:flex; gap:12px; flex-wrap:wrap; align-items:end;">
    <form asp-action="Index" method="get" style="display:flex; gap:12px; flex-wrap:wrap; align-items:end; width:100%;">
        <div style="flex:1; min-width:200px;">
            <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:6px; font-weight:600;">Tim kiem</label>
            <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="admin-form-control" placeholder="Ten dang nhap, ho ten, email..." />
        </div>
        <div style="min-width:160px;">
            <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:6px; font-weight:600;">Vai tro</label>
            <select name="idVaiTro" class="admin-form-control">
                <option value="">-- Tat ca --</option>
                @foreach (var vaiTro in Model.VaiTros)
                {
                    <option value="@vaiTro.IdvaiTro" selected="@(Model.IdVaiTroFilter == vaiTro.IdvaiTro)">@vaiTro.TenVaiTro</option>
                }
            </select>
        </div>
        <button type="submit" class="admin-btn" style="padding:10px 20px;border-radius:10px;">
            <i class="fas fa-search"></i> Loc
        </button>
        <a href="/AdminNguoiDung/Index" class="admin-btn" style="padding:10px 20px;border-radius:10px; background:#f8f8f8; color:#666;">
            <i class="fas fa-undo"></i> Reset
        </a>
    </form>
</div>

<!-- Bang danh sach nguoi dung -->
<div style="background:#fff; border:1px solid #eae5e1; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <div style="overflow-x:auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ten dang nhap</th>
                    <th>Ho ten</th>
                    <th>Email</th>
                    <th>Vai tro</th>
                    <th>So quyen</th>
                    <th>Trang thai</th>
                    <th>Ngay tao</th>
                    <th style="width:120px;">Thao tac</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.NguoiDungs.Count == 0)
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:40px; color:#999;">
                            <i class="fas fa-inbox" style="font-size:2rem; display:block; margin-bottom:12px;"></i>
                            Khong co nguoi dung nao
                        </td>
                    </tr>
                }
                @foreach (var user in Model.NguoiDungs)
                {
                    <tr>
                        <td>@user.IdnguoiDung</td>
                        <td>
                            <strong>@user.TenDangNhap</strong>
                            @if (user.LaAdmin)
                            {
                                <span style="display:inline-block; margin-left:6px; background:rgba(139,26,43,0.1); color:#8b1a2b; padding:2px 8px; border-radius:12px; font-size:0.7rem; font-weight:600;">ADMIN</span>
                            }
                        </td>
                        <td>@user.HoTen</td>
                        <td>@(string.IsNullOrEmpty(user.Email) ? "<span style='color:#aaa'>Chua co</span>" : user.Email)</td>
                        <td>@user.TenVaiTro</td>
                        <td>
                            <span style="display:inline-block; background:rgba(16,185,129,0.1); color:#059669; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600;">
                                @user.SoModuleDuocQuyen module
                            </span>
                        </td>
                        <td>
                            @if (user.TrangThai == "HoatDong")
                            {
                                <span style="display:inline-block; background:rgba(16,185,129,0.1); color:#059669; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600;">Hoat dong</span>
                            }
                            else
                            {
                                <span style="display:inline-block; background:rgba(239,68,68,0.1); color:#dc2626; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600;">@user.TrangThai</span>
                            }
                        </td>
                        <td>@(user.NgayTao?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            <div style="display:flex; gap:6px; align-items:center;">
                                <a href="/AdminNguoiDung/Details/@user.IdnguoiDung" class="admin-btn-icon" title="Xem chi tiet" style="padding:6px 10px; border-radius:8px; font-size:0.8rem; background:rgba(59,130,246,0.1); color:#2563eb;">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (!user.LaChinhMinh)
                                {
                                    <a href="/AdminNguoiDung/Edit/@user.IdnguoiDung" class="admin-btn-icon" title="Chinh sua (bao gom doi mat khau)" style="padding:6px 10px; border-radius:8px; font-size:0.8rem; background:rgba(245,158,11,0.1); color:#d97706;">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (!user.LaAdmin)
                                    {
                                        <form asp-action="Delete" asp-route-id="@user.IdnguoiDung" method="post" style="margin:0;" onsubmit="return confirm('Ban chac chan muon xoa nguoi dung nay?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="admin-btn-icon" title="Xoa" style="padding:6px 10px; border-radius:8px; font-size:0.8rem; background:rgba(239,68,68,0.1); color:#dc2626; border:none; cursor:pointer;">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                else if (user.LaChinhMinh)
                                {
                                    <span style="display:inline-block; padding:6px 10px; border-radius:8px; font-size:0.7rem; background:rgba(16,185,129,0.08); color:#059669; font-weight:600;">
                                        <i class="fas fa-user-check"></i> Chinh minh
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .admin-page-header { display: flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
    .admin-page-header h2 { margin:0 0 4px; font-size:1.4rem; color:#1e1a1d; }
    .admin-page-header .subtitle { font-size:0.85rem; color:#7a6e72; }
    .admin-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
    .admin-table th { background:#faf8f7; color:#6b7280; font-weight:600; text-align:left; padding:12px 16px; border-bottom:2px solid #eae5e1; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.03em; white-space:nowrap; }
    .admin-table td { padding:12px 16px; border-bottom:1px solid #f0ece8; color:#333; vertical-align:middle; }
    .admin-table tbody tr:hover { background:#fcfaf9; }
    .admin-table tbody tr:last-child td { border-bottom:none; }
</style>
