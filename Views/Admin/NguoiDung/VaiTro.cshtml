@model List<WebMTTQ.Models.VaiTro>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý vai trò";
}

<div class="admin-page-header" style="margin-bottom: 20px;">
    <div>
        <h2><i class="fas fa-users-cog"></i> Quản lý vai trò</h2>
        <div class="subtitle">Tạo, chỉnh sửa vai trò và phân quyền truy cập cho từng vai trò</div>
    </div>
    <div style="display:flex; gap:10px;">
        <a href="/AdminNguoiDung/VaiTro/Create" class="admin-btn admin-btn-success" style="padding:10px 20px; border-radius:10px;">
            <i class="fas fa-plus"></i> Tạo vai trò mới
        </a>
        <a href="/AdminNguoiDung/Index" class="admin-btn" style="padding:10px 20px; border-radius:10px;">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div style="background:#fff; border:1px solid #eae5e1; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    <div style="overflow-x:auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên vai trò</th>
                    <th>Số module quyền</th>
                    <th>Ngày tạo</th>
                    <th style="width:120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding:40px; color:#999;">
                            <i class="fas fa-inbox" style="font-size:2rem; display:block; margin-bottom:12px;"></i>
                            Không có vai trò nào
                        </td>
                    </tr>
                }
                @foreach (var vaiTro in Model)
                {
                    var isAdmin = WebMTTQ.Models.QuyenHelper.IsAdminVaiTro(vaiTro.TenVaiTro);
                    var moduleCounts = ViewBag.ModuleCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
                    var soQuyen = moduleCounts.ContainsKey(vaiTro.IdvaiTro) ? moduleCounts[vaiTro.IdvaiTro] : 0;
                    <tr>
                        <td>@vaiTro.IdvaiTro</td>
                        <td>
                            <strong>@vaiTro.TenVaiTro</strong>
                            @if (isAdmin)
                            {
                                <span style="display:inline-block; margin-left:6px; background:rgba(139,26,43,0.1); color:#8b1a2b; padding:2px 8px; border-radius:12px; font-size:0.7rem; font-weight:600;">ADMIN</span>
                            }
                        </td>
                        <td>
                            <span style="display:inline-block; background:rgba(16,185,129,0.1); color:#059669; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600;">
                                @soQuyen module
                            </span>
                        </td>
                        <td>@(vaiTro.NgayTao?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            <div style="display:flex; gap:6px; align-items:center;">
                                @if (!isAdmin)
                                {
                                    <a href="/AdminNguoiDung/VaiTro/Edit/@vaiTro.IdvaiTro" class="admin-btn-icon" title="Chỉnh sửa" style="padding:6px 10px; border-radius:8px; font-size:0.8rem; background:rgba(245,158,11,0.1); color:#d97706;">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="VaiTroDelete" asp-route-id="@vaiTro.IdvaiTro" method="post" style="margin:0;" onsubmit="return confirm('Bạn chắc chắn muốn xóa vai trò này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="admin-btn-icon" title="Xóa" style="padding:6px 10px; border-radius:8px; font-size:0.8rem; background:rgba(239,68,68,0.1); color:#dc2626; border:none; cursor:pointer;">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="display:inline-block; padding:6px 10px; border-radius:8px; font-size:0.7rem; background:rgba(139,26,43,0.08); color:#8b1a2b; font-weight:600;">
                                        <i class="fas fa-lock"></i> Bất khả xâm phạm
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .admin-page-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .admin-page-header h2 { margin: 0 0 4px; font-size: 1.4rem; color: #1e1a1d; }
    .admin-page-header .subtitle { font-size: 0.85rem; color: #7a6e72; }
    .admin-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .admin-table th { background: #faf8f7; color: #6b7280; font-weight: 600; text-align: left; padding: 12px 16px; border-bottom: 2px solid #eae5e1; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; white-space: nowrap; }
    .admin-table td { padding: 12px 16px; border-bottom: 1px solid #f0ece8; color: #333; vertical-align: middle; }
    .admin-table tbody tr:hover { background: #fcfaf9; }
    .admin-table tbody tr:last-child td { border-bottom: none; }
</style>