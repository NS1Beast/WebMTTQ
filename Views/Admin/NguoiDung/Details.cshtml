@model WebMTTQ.Models.NguoiDung
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chi tiết người dùng";
    var quyens = ViewBag.Quyens as List<WebMTTQ.Models.ModuleQuyenInfo> ?? new List<WebMTTQ.Models.ModuleQuyenInfo>();
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="admin-page-header" style="margin-bottom: 20px;">
    <div>
        <h2><i class="fas fa-user-circle"></i> Chi tiết người dùng</h2>
        <div class="subtitle">Thông tin chi tiết và quyền truy cập của tài khoản @Model.TenDangNhap</div>
    </div>
    <div style="display:flex; gap:10px;">
        <a href="/AdminNguoiDung/Edit/@Model.IdnguoiDung" class="admin-btn" style="padding:10px 20px; border-radius:10px; background:rgba(245,158,11,0.1); color:#d97706;">
            <i class="fas fa-edit"></i> Chỉnh sửa
        </a>
        <a href="/AdminNguoiDung/Index" class="admin-btn" style="padding:10px 20px; border-radius:10px;">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px;">
    <!-- Thông tin tài khoản -->
    <div style="background:#fff; border:1px solid #eae5e1; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <h3 style="margin:0 0 20px; font-size:1rem; color:#1e1a1d; display:flex; align-items:center; gap:8px;">
            <i class="fas fa-user" style="color:#8b1a2b;"></i> Thông tin tài khoản
        </h3>

        <div class="info-row">
            <span class="info-label">Tên đăng nhập</span>
            <span class="info-value">@Model.TenDangNhap @(isAdmin ? "<span style='background:rgba(139,26,43,0.1); color:#8b1a2b; padding:2px 8px; border-radius:12px; font-size:0.7rem; font-weight:600; margin-left:6px;'>ADMIN</span>" : "")</span>
        </div>
        <div class="info-row">
            <span class="info-label">Họ tên</span>
            <span class="info-value">@Model.HoTen</span>
        </div>
        <div class="info-row">
            <span class="info-label">Email</span>
            <span class="info-value">@(string.IsNullOrEmpty(Model.Email) ? "<span style='color:#aaa'>Chưa có email</span>" : Model.Email)</span>
        </div>
        <div class="info-row">
            <span class="info-label">Số điện thoại</span>
            <span class="info-value">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "-" : Model.SoDienThoai)</span>
        </div>
        <div class="info-row">
            <span class="info-label">Vai trò</span>
            <span class="info-value">@Model.IdvaiTroNavigation?.TenVaiTro</span>
        </div>
        <div class="info-row">
            <span class="info-label">Trạng thái</span>
            <span class="info-value">
                @if (Model.TrangThai == "HoatDong")
                {
                    <span style="background:rgba(16,185,129,0.1); color:#059669; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600;">✓ Hoạt động</span>
                }
                else
                {
                    <span style="background:rgba(239,68,68,0.1); color:#dc2626; padding:3px 10px; border-radius:12px; font-size:0.75rem; font-weight:600;">✕ @Model.TrangThai</span>
                }
            </span>
        </div>
        <div class="info-row">
            <span class="info-label">Ngày tạo</span>
            <span class="info-value">@(Model.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
        </div>
        <div class="info-row">
            <span class="info-label">Ngày cập nhật</span>
            <span class="info-value">@(Model.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
        </div>
    </div>

    <!-- Quyền truy cập -->
    <div style="background:#fff; border:1px solid #eae5e1; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <h3 style="margin:0 0 20px; font-size:1rem; color:#1e1a1d; display:flex; align-items:center; gap:8px;">
            <i class="fas fa-shield-alt" style="color:#8b1a2b;"></i> Quyền truy cập (@quyens.Count module)
        </h3>

        @if (isAdmin)
        {
            <div class="admin-alert" style="background:rgba(139,26,43,0.08); border:1px solid rgba(139,26,43,0.2); color:#8b1a2b; padding:12px 16px; border-radius:8px; font-size:0.8rem; margin-bottom:16px;">
                <i class="fas fa-crown"></i>
                Người dùng này là <strong>ADMIN</strong> - có toàn quyền truy cập tất cả các chức năng.
            </div>
        }
        else if (quyens.Count == 0)
        {
            <div class="admin-alert" style="background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.2); color:#b45309; padding:12px 16px; border-radius:8px; font-size:0.8rem;">
                <i class="fas fa-exclamation-triangle"></i>
                Vai trò này chưa được cấp quyền truy cập vào module nào.
            </div>
        }
        else
        {
            <div style="display:grid; gap:20px;">
                @foreach (var quyen in quyens)
                {
                    <div style="border:1px solid #eae5e1; border-radius:8px; padding:12px 16px;">
                        <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                            <i class="fas fa-check-circle" style="color:#059669;"></i>
                            <strong style="font-size:0.85rem; color:#333;">@quyen.TenModule</strong>
                        </div>
                        <div style="display:flex; gap:12px; font-size:0.75rem; color:#7a6e72; flex-wrap:wrap;">
                            <span style="color:@(quyen.CoQuyenXem ? "#059669" : "#ccc");">
                                <i class="fas fa-eye"></i> Xem @(quyen.CoQuyenXem ? "✓" : "✕")
                            </span>
                            <span style="color:@(quyen.CoQuyenThem ? "#059669" : "#ccc");">
                                <i class="fas fa-plus-circle"></i> Thêm @(quyen.CoQuyenThem ? "✓" : "✕")
                            </span>
                            <span style="color:@(quyen.CoQuyenSua ? "#059669" : "#ccc");">
                                <i class="fas fa-edit"></i> Sửa @(quyen.CoQuyenSua ? "✓" : "✕")
                            </span>
                            <span style="color:@(quyen.CoQuyenXoa ? "#059669" : "#ccc");">
                                <i class="fas fa-trash-alt"></i> Xóa @(quyen.CoQuyenXoa ? "✓" : "✕")
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .admin-page-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .admin-page-header h2 { margin: 0 0 4px; font-size: 1.4rem; color: #1e1a1d; }
    .admin-page-header .subtitle { font-size: 0.85rem; color: #7a6e72; }
    .info-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f5f0ec; gap: 20px; }
    .info-row:last-child { border-bottom: none; }
    .info-label { font-size: 0.82rem; color: #7a6e72; font-weight: 500; flex-shrink: 0; }
    .info-value { font-size: 0.85rem; color: #333; font-weight: 500; text-align: right; }
    @@media (max-width: 900px) {
        div[style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
    }
</style>