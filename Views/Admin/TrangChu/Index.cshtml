@model IEnumerable<WebMTTQ.Models.TrangChuMuc>

@{
    ViewData["Title"] = "Cài đặt Trang chủ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .tc-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 0; }
    .tc-tab {
        padding: 12px 24px; border-radius: 8px 8px 0 0; text-decoration: none;
        font-weight: 600; font-size: 0.95rem; color: #666; background: #f8f9fa;
        border: 1px solid #eee; border-bottom: none; transition: all 0.3s;
        display: inline-flex; align-items: center; gap: 8px;
    }
    .tc-tab:hover { background: #e9ecef; color: #333; }
    .tc-tab.active { background: #8b1a2b; color: white; border-color: #8b1a2b; }
</style>

<div class="admin-card" style="background:#fff; padding:25px; border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
        <div>
            <h2 style="margin: 0; color: #333; font-size: 1.5rem;">Cài đặt Trang chủ</h2>
            <p style="margin: 5px 0 0; color: #888; font-size: 0.9rem;">Quản lý các mục nội dung, banner và hành trình chuyển đổi số trên trang chủ</p>
        </div>
        <a href="@Url.Action("Create", "AdminTrangChu")" class="btn" style="background: #28a745; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fas fa-plus"></i> Thêm mục mới
        </a>
    </div>

    <!-- Tabs -->
    <div class="tc-tabs">
        <a href="@Url.Action("Index", "AdminTrangChu")" class="tc-tab active"><i class="fas fa-layer-group"></i> Mục nội dung</a>
        <a href="@Url.Action("Banner", "AdminTrangChu")" class="tc-tab"><i class="fas fa-images"></i> Quản lý Banner</a>
        <a href="@Url.Action("Timeline", "AdminTrangChu")" class="tc-tab"><i class="fas fa-stream"></i> Hành trình chuyển đổi số</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="table-responsive">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f8f9fa; text-align: left; border-bottom: 2px solid #ddd;">
                    <th style="padding: 15px; min-width: 120px;">Hình ảnh</th>
                    <th style="padding: 15px;">Tiêu đề</th>
                    <th style="padding: 15px;">Loại</th>
                    <th style="padding: 15px; width: 80px;">Thứ tự</th>
                    <th style="padding: 15px; width: 100px;">Số nội dung</th>
                    <th style="padding: 15px; width: 120px;">Trạng thái</th>
                    <th style="padding: 15px; text-align: center; min-width: 220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 10px 15px;">
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="@item.HinhAnh" alt="@item.TieuDe" style="width: 120px; height: 70px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" />
                                }
                                else
                                {
                                    <div style="width: 120px; height: 70px; background: #f0f0f0; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 0.8rem;">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }
                            </td>
                            <td style="padding: 15px; font-weight: bold; max-width: 250px; overflow: hidden; text-overflow: ellipsis;">
                                @item.TieuDe
                                <div style="font-weight: normal; font-size: 0.8rem; color: #888; margin-top: 3px;">
                                    @(item.NoiDung?.Length > 100 ? item.NoiDung.Substring(0, 100) + "..." : item.NoiDung ?? "")
                                </div>
                            </td>
                            <td style="padding: 15px;">
                                @switch (item.Loai)
                                {
                                    case "tin-tuc":
                                        <span style="background: #cce5ff; color: #004085; padding: 3px 10px; border-radius: 20px; font-size: 0.8rem;">Tin tức</span>
                                        break;
                                    case "hinh-anh":
                                        <span style="background: #d4edda; color: #155724; padding: 3px 10px; border-radius: 20px; font-size: 0.8rem;">Hình ảnh</span>
                                        break;
                                    case "video":
                                        <span style="background: #f8d7da; color: #721c24; padding: 3px 10px; border-radius: 20px; font-size: 0.8rem;">Video</span>
                                        break;
                                    default:
                                        <span style="background: #e9ecef; color: #495057; padding: 3px 10px; border-radius: 20px; font-size: 0.8rem;">@item.Loai</span>
                                        break;
                                }
                            </td>
                            <td style="padding: 15px; text-align: center;">@item.ThuTu</td>
                            <td style="padding: 15px; text-align: center;">
                                <span style="background: #e9ecef; padding: 4px 10px; border-radius: 20px; font-size: 0.85rem;">@(item.TinTucs?.Count ?? 0)</span>
                                @if (item.TinTucs != null && item.TinTucs.Count > 0)
                                {
                                    <div style="font-size: 0.7rem; color: #dc3545; margin-top: 4px;">@item.TinTucs.Count nội dung</div>
                                }
                            </td>
                            <td style="padding: 15px;">
                                @if (item.TrangThai)
                                {
                                    <span style="background: #d4edda; color: #155724; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Hiển thị</span>
                                }
                                else
                                {
                                    <span style="background: #f8d7da; color: #721c24; padding: 5px 10px; border-radius: 20px; font-size: 0.85rem;">Đang ẩn</span>
                                }
                            </td>
                            <td style="padding: 15px; text-align: center;">
                                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                                    @if (item.Loai == "tin-tuc" || item.Loai == "hinh-anh" || item.Loai == "video" || item.Loai == "van-ban")
                                    {
                                        <a href="@Url.Action("ItemList", "AdminTrangChu", new { id = item.Id })" style="color: #28a745; text-decoration: none; padding: 5px 12px; border: 1px solid #28a745; border-radius: 4px; font-size: 0.85rem;">
                                            <i class="fas @(item.Loai == "tin-tuc" ? "fa-newspaper" : item.Loai == "hinh-anh" ? "fa-images" : item.Loai == "video" ? "fa-video" : "fa-file-alt")"></i> Quản lý nội dung
                                        </a>
                                    }
                                    <a href="@Url.Action("Edit", "AdminTrangChu", new { id = item.Id })" style="color: #17a2b8; text-decoration: none; padding: 5px 12px; border: 1px solid #17a2b8; border-radius: 4px; font-size: 0.85rem;">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái hiển thị mục @item.TieuDe?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="color: @(item.TrangThai ? "#ffc107" : "#28a745"); background: none; border: 1px solid @(item.TrangThai ? "#ffc107" : "#28a745"); cursor: pointer; font-size: 0.85rem; padding: 5px 12px; border-radius: 4px;">
                                            <i class="fas @(item.TrangThai ? "fa-eye-slash" : "fa-eye")"></i> @(item.TrangThai ? "Ẩn" : "Hiện")
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="color: #dc3545; background: none; border: 1px solid #dc3545; cursor: pointer; font-size: 0.85rem; padding: 5px 12px; border-radius: 4px;">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #888;">
                            <div style="font-size: 3rem; margin-bottom: 15px; opacity: 0.3;">
                                <i class="fas fa-layer-group"></i>
                            </div>
                            <p style="font-size: 1.1rem; margin-bottom: 5px;">Chưa có mục nào được thêm cho Trang chủ.</p>
                            <p style="font-size: 0.9rem;">Nhấn nút "Thêm mục mới" để bắt đầu tạo nội dung cho trang chủ.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-responsive {
        overflow-x: auto;
    }
    .table-responsive table {
        min-width: 700px;
    }
</style>