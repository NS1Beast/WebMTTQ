@model WebMTTQ.Models.TrangChuMuc

@{
    ViewData["Title"] = "Sửa mục - Trang chủ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card" style="background:#fff; padding:25px; border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.05); max-width: 900px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px;">
        <a href="@Url.Action("Index", "AdminTrangChu")" style="color: #666; text-decoration: none; font-size: 1.2rem;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h2 style="margin: 0; color: #333; font-size: 1.4rem;">Sửa mục: @Model.TieuDe</h2>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div class="form-group">
                <label asp-for="TieuDe" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Tiêu đề mục</label>
                <input asp-for="TieuDe" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" required />
                <span asp-validation-for="TieuDe" style="color: #dc3545; font-size: 0.85rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Loai" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Loại mục</label>
                <select asp-for="Loai" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; background: white;">
                    <option value="tin-tuc">Tin tức nổi bật</option>
                    <option value="hinh-anh">Thư viện hình ảnh</option>
                    <option value="thong-tin">Thông tin giới thiệu</option>
                    <option value="video">Video</option>
                    <option value="lien-ket">Liên kết nhanh</option>
                    <option value="van-ban">Văn bản</option>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="NoiDung" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Nội dung (HTML hoặc mô tả)</label>
            <textarea asp-for="NoiDung" class="form-control" rows="6" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; font-family: monospace;" placeholder="Nhập nội dung HTML hoặc mô tả cho mục này..."></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="ThuTu" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Thứ tự hiển thị</label>
            <input asp-for="ThuTu" class="form-control" type="number" min="0" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" />
            <small style="color: #888;">Số càng nhỏ hiển thị càng trước.</small>
        </div>

        @if (Model.Loai == "tin-tuc")
        {
            <div style="margin-top: 15px; padding: 15px; background: #e7f7ff; border-radius: 8px; border-left: 4px solid #17a2b8;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                    <i class="fas fa-newspaper" style="color: #17a2b8; font-size: 1.1rem;"></i>
                    <strong style="color: #004085; font-size: 0.95rem;">
                        Mục tin tức này có @Model.TinTucs?.Count(t => t.TrangThai) mục tin đang hiển thị
                    </strong>
                </div>
                <a href="@Url.Action("TinTucList", "AdminTrangChu", new { id = Model.Id })" style="display: inline-flex; align-items: center; gap: 6px; color: #004085; text-decoration: none; font-weight: 500; padding: 6px 14px; border: 1px solid #bee5eb; border-radius: 6px;">
                    <i class="fas fa-list"></i> Xem & quản lý tin tức trong mục này
                </a>
            </div>
        }

        <div class="form-group" style="margin-bottom: 25px; margin-top: 20px;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                <input asp-for="TrangThai" type="checkbox" style="width: 18px; height: 18px;" />
                <span style="font-weight: 600; color: #333;">Hiển thị trên trang chủ</span>
            </label>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end; border-top: 1px solid #eee; padding-top: 20px;">
            <a href="@Url.Action("Index", "AdminTrangChu")" class="btn" style="padding: 10px 24px; border: 1px solid #ddd; border-radius: 6px; text-decoration: none; color: #666; font-weight: 500;">Hủy</a>
            <button type="submit" class="btn" style="padding: 10px 24px; background: #17a2b8; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                <i class="fas fa-save"></i> Cập nhật
            </button>
        </div>
    </form>
</div>