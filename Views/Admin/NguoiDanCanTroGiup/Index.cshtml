@model IEnumerable<WebMTTQ.Models.NguoiDanCanTroGiup>
@{
    ViewData["Title"] = "Quản lý yêu cầu trợ giúp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Thay bằng layout admin của bạn
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách Người dân cần trợ giúp</h6>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>Ngày gửi</th>
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        <th>Ưu tiên</th>
                        <th>Trạng thái</th>
                        <th width="150">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.NgayGui?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td><strong>@item.HoTen</strong></td>
                            <td>@item.SoDienThoai</td>
                            <td>
                                @if (item.MucDoUuTien == "Khẩn cấp")
                                {
                                    <span class="badge bg-danger text-white">Khẩn cấp</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary text-white">Bình thường</span>
                                }
                            </td>
                            <td>
                                @if (item.TrangThai == "Chưa xử lý")
                                {
                                    <span class="badge bg-warning text-dark">Chưa xử lý</span>
                                }
                                else if (item.TrangThai == "Đang xử lý")
                                {

                                    <span class="badge bg-info text-white">Đang xử lý</span>
                                }
                                else
                                {

                                    <span class="badge bg-success text-white">Đã xử lý</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-warning">Xem/Sửa</a>
                                <form action="@Url.Action("Delete", new { id = item.Id })" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa yêu cầu này?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>