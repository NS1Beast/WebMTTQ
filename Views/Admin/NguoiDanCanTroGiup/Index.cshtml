@model IEnumerable<WebMTTQ.Models.NguoiDanCanTroGiup>
@{
    ViewData["Title"] = "Quản lý yêu cầu trợ giúp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div>
        <h2>Danh sách Người dân cần trợ giúp</h2>
        <div class="subtitle">Tiếp nhận và xử lý các yêu cầu hỗ trợ từ người dân</div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ngày gửi</th>
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        <th>Ưu tiên</th>
                        <th>Trạng thái</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.NgayGui?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td><strong>@item.HoTen</strong></td>
                            <td>@item.SoDienThoai</td>
                            <td>
                                @if (item.MucDoUuTien == "Khẩn cấp")
                                {
                                    <span class="admin-badge warning">Khẩn cấp</span>
                                }
                                else
                                {
                                    <span class="admin-badge gray">Bình thường</span>
                                }
                            </td>
                            <td>
                                @if (item.TrangThai == "Chưa xử lý")
                                {
                                    <span class="admin-badge warning">Chưa xử lý</span>
                                }
                                else if (item.TrangThai == "Đang xử lý")
                                {
                                    <span class="admin-badge info">Đang xử lý</span>
                                }
                                else
                                {
                                    <span class="admin-badge green">Đã xử lý</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="admin-btn admin-btn-warning admin-btn-sm">
                                    <i class="fas fa-eye"></i> Xem/Sửa
                                </a>
                                <form action="@Url.Action("Delete", new { id = item.Id })" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa yêu cầu này?');">
                                    <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty">
                                    <i class="fas fa-inbox"></i>
                                    <p>Chưa có yêu cầu trợ giúp nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>