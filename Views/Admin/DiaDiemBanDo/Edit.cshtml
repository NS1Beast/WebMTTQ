@model WebMTTQ.Models.DiaDiemBanDo
@{
    ViewData["Title"] = "Sửa Điểm An Sinh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="admin-page-header">
    <div>
        <h2>Cập nhật Điểm Hỗ Trợ</h2>
        <div class="subtitle">Chỉnh sửa thông tin và vị trí điểm an sinh</div>
    </div>
    <a href="/AdminDiaDiemBanDo/Index" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="IddiaDiem" />

            <div style="display:flex;gap:24px;flex-wrap:wrap;">
                <!-- Cột 1: Thông tin -->
                <div style="flex:1;min-width:320px;">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Tên chương trình / Địa điểm <span class="required">*</span></label>
                        <input asp-for="TenDiaDiem" class="admin-form-control" required />
                    </div>

                    <div class="admin-form-group">
                        <label class="admin-form-label">Đơn vị thực hiện <span class="required">*</span></label>
                        <select asp-for="PhanLoaiBanDo" class="admin-form-control" required>
                            <option value="Hội LHPN">Hội Liên hiệp Phụ nữ</option>
                            <option value="Đoàn Thanh Niên">Đoàn Thanh Niên</option>
                            <option value="Mặt trận Tổ quốc">Mặt trận Tổ quốc Việt Nam</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label class="admin-form-label">Ngày thực hiện</label>
                        <input asp-for="NgayThucHien" type="date" class="admin-form-control" />
                    </div>

                    <div class="admin-form-group">
                        <label class="admin-form-label">Nội dung / Mô tả</label>
                        <textarea asp-for="MoTaChiTiet" class="admin-form-control" rows="4"></textarea>
                    </div>

                    <div class="admin-form-group">
                        <label class="admin-form-label">Hình ảnh mới (Bỏ trống nếu không muốn đổi ảnh)</label>
                        <input type="file" name="HinhAnhUpload" class="admin-form-control" accept="image/*" style="padding-top:8px;" />

                        @if (Model.HinhAnhThucTe != null)
                        {
                            var base64 = Convert.ToBase64String(Model.HinhAnhThucTe);
                            var imgSrc = String.Format("data:image/jpeg;base64,{0}", base64);
                            <div style="margin-top: 10px;">
                                <small style="color:var(--admin-muted);">Ảnh hiện tại:</small><br />
                                <img src="@imgSrc" style="max-width:100%;max-height:120px;border-radius:8px;border:1px solid var(--admin-line);margin-top:4px;" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Cột 2: Bản đồ chọn tọa độ -->
                <div style="flex:1;min-width:320px;">
                    <label class="admin-form-label" style="color:var(--admin-red);">📌 Click vào bản đồ để đổi tọa độ mới</label>
                    <div id="adminMap" style="height: 320px; border-radius: 8px; border: 2px solid var(--admin-line); margin-bottom: 15px; width: 100%;"></div>

                    <div style="display:flex;gap:16px;">
                        <div class="admin-form-group" style="flex:1;">
                            <label class="admin-form-label">Vĩ độ (Latitude)</label>
                            <input asp-for="ViDo" id="inputViDo" class="admin-form-control" readonly required />
                        </div>
                        <div class="admin-form-group" style="flex:1;">
                            <label class="admin-form-label">Kinh độ (Longitude)</label>
                            <input asp-for="KinhDo" id="inputKinhDo" class="admin-form-control" readonly required />
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-form-actions" style="justify-content:flex-end;">
                <a href="/AdminDiaDiemBanDo/Index" class="admin-btn admin-btn-ghost">Quay lại</a>
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var curLat = @Model.ViDo.ToString(System.Globalization.CultureInfo.InvariantCulture)
        var curLng = @Model.KinhDo.ToString(System.Globalization.CultureInfo.InvariantCulture);

        var map = L.map('adminMap').setView([curLat, curLng], 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        fetch('https://nominatim.openstreetmap.org/lookup?osm_ids=R19260505&polygon_geojson=1&format=json')
            .then(res => res.json())
            .then(data => {
                if (data && data.length > 0 && data[0].geojson) {
                    const boundaryLayer = L.geoJSON(data[0].geojson, {
                        style: { color: "#e63946", weight: 3, fillColor: "#e63946", fillOpacity: 0.1, dashArray: '' },
                        interactive: false
                    }).addTo(map);
                    map.fitBounds(boundaryLayer.getBounds());
                }
            })
            .catch(err => console.error("Lỗi tải ranh giới:", err));
        var marker = L.marker([curLat, curLng]).addTo(map);
        map.on('click', function(e) {
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;
            document.getElementById('inputViDo').value = lat.toFixed(6);
            document.getElementById('inputKinhDo').value = lng.toFixed(6);
            if (marker) { map.removeLayer(marker); }
            marker = L.marker([lat, lng]).addTo(map);
        });
    </script>
}