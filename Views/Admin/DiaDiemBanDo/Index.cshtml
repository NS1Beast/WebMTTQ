@model IEnumerable<WebMTTQ.Models.DiaDiemBanDo>
@{
    ViewData["Title"] = "Quản lý Bản đồ An sinh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div>
        <h2>Danh sách Điểm Hỗ Trợ / Chăm Lo</h2>
        <div class="subtitle">Quản lý các địa điểm an sinh xã hội trên bản đồ</div>
    </div>
    <a href="/AdminDiaDiemBanDo/Create" class="admin-btn admin-btn-success">
        <i class="fas fa-plus"></i> Thêm địa điểm mới
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên chương trình/địa điểm</th>
                        <th>Đơn vị</th>
                        <th>Ngày thực hiện</th>
                        <th>Tọa độ</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IddiaDiem</td>
                                <td><strong>@item.TenDiaDiem</strong></td>
                                <td><span class="admin-badge blue">@item.PhanLoaiBanDo</span></td>
                                <td>@(item.NgayThucHien.HasValue ? item.NgayThucHien.Value.ToString("dd/MM/yyyy") : "")</td>
                                <td><span style="font-size:0.8rem;color:var(--admin-muted);">@item.ViDo, @item.KinhDo</span></td>
                                <td class="cell-actions">
                                    <a href="/AdminDiaDiemBanDo/Edit/@item.IddiaDiem" class="admin-btn admin-btn-warning admin-btn-sm">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.IddiaDiem" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa điểm này không?');">
                                        <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty">
                                    <i class="fas fa-map-marked-alt"></i>
                                    <p>Chưa có dữ liệu địa điểm nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>