@model IEnumerable<WebMTTQ.Models.VanBanTaiLieu>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var chuyenMucs = ViewBag.ChuyenMucs as List<WebMTTQ.Models.ChuyenMuc> ?? new List<WebMTTQ.Models.ChuyenMuc>();
    var hasEnoughCategories = chuyenMucs.Count >= 2;
}

<div class="admin-page-header">
    <div>
        <h2>Quản lý Văn bản & Tài liệu</h2>
        <div class="subtitle">Quản lý kho văn bản, biểu mẫu công khai trên hệ thống</div>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/AdminVanBanTaiLieu/Categories" class="admin-btn admin-btn-ghost">
            <i class="fas fa-folder"></i> Quản lý chuyên mục
        </a>
        <a href="/AdminVanBanTaiLieu/Create" class="admin-btn admin-btn-primary">
            <i class="fas fa-plus"></i> Thêm văn bản mới
        </a>
    </div>
</div>

@if (!hasEnoughCategories)
{
    <div style="background: #fff3cd; color: #856404; padding: 12px 15px; border-radius: 8px; margin-bottom: 20px; font-size: 0.9rem;">
        <i class="fas fa-info-circle"></i> Cần ít nhất 2 chuyên mục để chuyển văn bản qua lại giữa các chuyên mục. Hiện có @chuyenMucs.Count chuyên mục.
    </div>
}

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="120">Số hiệu</th>
                        <th>Tên văn bản / Trích yếu</th>
                        <th>Chuyên mục</th>
                        <th class="cell-center">Ngày ban hành</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.SoHieu</strong></td>
                                <td>
                                    <strong style="color: var(--admin-red);">@item.TenVanBan</strong>
                                    @if (!string.IsNullOrEmpty(item.CoQuanBanHanh))
                                    {
                                        <div style="font-size:0.8rem; color:var(--admin-muted); margin-top:4px;">
                                            <i class="fas fa-building"></i> @item.CoQuanBanHanh
                                        </div>
                                    }
                                </td>
                                <td><span class="admin-badge gray">@(item.IdchuyenMucNavigation?.TenChuyenMuc ?? "Không phân loại")</span></td>
                                <td class="cell-center">@(item.NgayBanHanh?.ToString("dd/MM/yyyy"))</td>
                                <td class="cell-actions">
                                    @if (hasEnoughCategories)
                                    {
                                        <button type="button"
                                            class="admin-btn admin-btn-info admin-btn-sm"
                                            onclick="openMoveModal(@item.IdvanBan, @(item.IdchuyenMuc ?? 0), '@(item.TenVanBan?.Replace("'", "\\'") ?? "")')">
                                            <i class="fas fa-share-alt"></i> Chuyển
                                        </button>
                                    }
                                    <a href="/AdminVanBanTaiLieu/Edit/@item.IdvanBan" class="admin-btn admin-btn-warning admin-btn-sm">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form action="/AdminVanBanTaiLieu/Delete" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa văn bản này?');">
                                        <input type="hidden" name="id" value="@item.IdvanBan" />
                                        <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="admin-empty">
                                    <i class="fas fa-file-signature"></i>
                                    <p>Chưa có văn bản tài liệu nào trong hệ thống.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal chuyển chuyên mục -->
<div id="moveModal" class="modal-overlay" style="display:none;" onclick="closeMoveModal(event)">
    <div class="modal-box" style="background:#fff; border-radius:12px; max-width:500px; width:90%; padding:0; box-shadow:0 10px 40px rgba(0,0,0,0.2);" onclick="event.stopPropagation()">
        <div style="padding:20px 25px; border-bottom:1px solid #eee; display:flex; justify-content:space-between; align-items:center;">
            <h3 style="margin:0; color:#333; font-size:1.2rem;">
                <i class="fas fa-share-alt"></i> Chuyển văn bản sang chuyên mục khác
            </h3>
            <button type="button" onclick="document.getElementById('moveModal').style.display='none'" style="background:none; border:none; font-size:1.5rem; color:#999; cursor:pointer;line-height:1;">&times;</button>
        </div>
        <div style="padding:25px;">
            <p id="moveDocumentName" style="color:#555; font-size:0.95rem; margin-bottom:20px; line-height:1.5;"></p>
            <form method="post" action="/AdminVanBanTaiLieu/MoveCategory" id="moveForm" onsubmit="return confirmMove(event)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="moveDocId" />
                <input type="hidden" name="newCategoryId" id="moveNewCategoryId" />
                <div style="margin-bottom:25px;">
                    <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:8px; color:#333;">Chuyên mục đích:</label>
                    <select id="moveCategorySelect" class="admin-input" style="width:100%; padding:10px 12px; border:1px solid #ddd; border-radius:8px; font-size:0.95rem;" onchange="document.getElementById('moveNewCategoryId').value = this.value;">
                        <option value="">-- Chọn chuyên mục --</option>
                        @foreach (var cat in chuyenMucs)
                        {
                            <option value="@cat.IdchuyenMuc">@cat.TenChuyenMuc</option>
                        }
                    </select>
                </div>
                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" onclick="document.getElementById('moveModal').style.display='none'" class="admin-btn" style="background:#fff; color:#666; border:1px solid #ddd;">
                        Hủy
                    </button>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        <i class="fas fa-check"></i> Xác nhận chuyển
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@section Scripts {
    <script>
        function openMoveModal(docId, currentCatId, docTitle) {
            document.getElementById('moveDocId').value = docId;
            document.getElementById('moveNewCategoryId').value = '';
            document.getElementById('moveDocumentName').innerHTML = 'Chọn chuyên mục đích để chuyển văn bản: <strong>"' + docTitle + '"</strong>';

            var select = document.getElementById('moveCategorySelect');
            var options = select.options;
            for (var i = 0; i < options.length; i++) {
                var val = parseInt(options[i].value);
                if (!isNaN(val) && val === currentCatId) {
                    options[i].disabled = true;
                    options[i].textContent = options[i].textContent + ' (đang chứa văn bản này)';
                } else {
                    options[i].disabled = false;
                }
            }
            select.value = '';
            document.getElementById('moveModal').style.display = 'flex';
        }

        function closeMoveModal(event) {
            if (!event || event.target === event.currentTarget) {
                document.getElementById('moveModal').style.display = 'none';
            }
        }

        function confirmMove(event) {
            var newCatId = document.getElementById('moveNewCategoryId').value;
            if (!newCatId) {
                event.preventDefault();
                alert('Vui lòng chọn chuyên mục đích để chuyển!');
                return false;
            }

            var select = document.getElementById('moveCategorySelect');
            var selText = select.options[select.selectedIndex].textContent;

            if (!confirm('Bạn có chắc chắn muốn chuyển văn bản này sang chuyên mục "' + selText + '" không?')) {
                event.preventDefault();
                return false;
            }
            return true;
        }
    </script>
}
