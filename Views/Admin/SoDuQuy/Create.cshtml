@model WebMTTQ.Models.SoDuQuy
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm số dư quỹ";
}

<div class="admin-page-header">
    <div>
        <h2>Nhập thông tin số dư quỹ mới</h2>
        <div class="subtitle">Cập nhật biến động số dư Quỹ "Vì người nghèo"</div>
    </div>
    <a href="/admin/soduquy" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card" style="max-width: 600px;">
    <div class="admin-card-body">
        <form asp-action="Create" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn lưu bản ghi số dư mới này?');">
            @Html.AntiForgeryToken()
            <div class="admin-form-group">
                <label class="admin-form-label">Tiền mặt (VNĐ) <span class="required">*</span></label>
                <input asp-for="TienMat" type="number" class="admin-form-control" placeholder="Ví dụ: 100000000" required />
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Tiền gửi ngân hàng (VNĐ) <span class="required">*</span></label>
                <input asp-for="TienGuiNganHang" type="number" class="admin-form-control" placeholder="Ví dụ: 500000000" required />
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-success">
                    <i class="fas fa-save"></i> Lưu dữ liệu
                </button>
                <a href="/admin/soduquy" class="admin-btn admin-btn-ghost">Hủy</a>
            </div>
        </form>
    </div>
</div>