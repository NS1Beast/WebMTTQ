@model WebMTTQ.Models.SoDuQuyViNguoiNgheo
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Thêm số dư";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4" style="max-width: 500px;">
        <h4 class="mb-4 text-center">Nhập thông tin số dư quỹ mới</h4>

        <form asp-action="Create" method="post">
            <div class="form-group mb-3">
                <label class="font-weight-bold">Tiền mặt (VNĐ)</label>
                <input asp-for="TienMat" type="number" class="form-control" required />
            </div>

            <div class="form-group mb-4">
                <label class="font-weight-bold">Tiền gửi ngân hàng (VNĐ)</label>
                <input asp-for="TienGuiNganHang" type="number" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-success w-100 mb-2">Lưu dữ liệu</button>
            <a href="/admin/soduquy" class="btn btn-secondary w-100">Quay lại</a>
        </form>
    </div>
</div>