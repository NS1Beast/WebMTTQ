@model IEnumerable<WebMTTQ.Models.SoDuQuy>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Số dư Quỹ Vì người nghèo";
}

<div class="admin-page-header">
    <div>
        <h2>Lịch sử Số dư Quỹ "Vì người nghèo"</h2>
        <div class="subtitle">Theo dõi biến động số dư quỹ qua các thời điểm</div>
    </div>
    <a href="/admin/soduquy/Create" class="admin-btn admin-btn-primary">
        <i class="fas fa-plus"></i> Cập nhật số dư mới
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ngày cập nhật</th>
                        <th class="cell-right">Tiền mặt</th>
                        <th class="cell-right">Tiền gửi Ngân hàng</th>
                        <th class="cell-right">Tổng tồn quỹ</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item == Model.First() ? "admin-table-highlight" : "")">
                            <td>@item.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="cell-right"><span class="admin-money green">@item.TienMat?.ToString("N0")đ</span></td>
                            <td class="cell-right"><span class="admin-money blue">@item.TienGuiNganHang?.ToString("N0")đ</span></td>
                            <td class="cell-right"><span class="admin-money red">@item.TongTonQuy?.ToString("N0")đ</span></td>
                            <td class="cell-actions">
                                <a href="/admin/soduquy/Edit/@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <form action="/admin/soduquy/Delete/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Xóa bản ghi này?');">
                                    <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="admin-empty">
                                    <i class="fas fa-wallet"></i>
                                    <p>Chưa có dữ liệu số dư quỹ.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>