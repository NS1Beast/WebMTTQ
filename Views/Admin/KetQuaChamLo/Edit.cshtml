@model WebMTTQ.Models.KetQuaChamLo
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa hoạt động chăm lo";
}

<div class="admin-page-header">
    <div>
        <h2>Chỉnh sửa thông tin chăm lo</h2>
        <div class="subtitle">Cập nhật thông tin hoạt động chăm lo an sinh xã hội</div>
    </div>
    <a href="/admin/ketquachamlo" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card" style="max-width: 800px;">
    <div class="admin-card-body">
        <form asp-action="Edit" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn lưu các thay đổi của hoạt động chăm lo này?');">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Nam" />

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Tháng thực hiện <span class="required">*</span></label>
                    <input asp-for="Thang" type="number" min="1" max="12" class="admin-form-control" required />
                    <span asp-validation-for="Thang" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Phân loại đơn vị <span class="required">*</span></label>
                    <select asp-for="PhanLoaiDonVi" class="admin-form-control" required>
                        <option value="MTTQ">MTTQ</option>
                        <option value="Ban CTMT ấp">Ban CTMT ấp</option>
                        <option value="Doanh nghiệp, nhà hảo tâm">Doanh nghiệp, nhà hảo tâm</option>
                        <option value="Hội Chữ thập đỏ">Hội Chữ thập đỏ</option>
                        <option value="Hội LHPN">Hội LHPN</option>
                        <option value="Hội Cựu chiến binh">Hội Cựu chiến binh</option>
                        <option value="Công đoàn">Công đoàn</option>
                        <option value="Đoàn Thanh niên">Đoàn Thanh niên</option>
                        <option value="Hội Người cao tuổi">Hội Người cao tuổi</option>
                        <option value="Chưa ghi đơn vị">Chưa ghi đơn vị</option>
                    </select>
                    <span asp-validation-for="PhanLoaiDonVi" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Tên đơn vị thực hiện chi tiết <span class="required">*</span></label>
                <input asp-for="DonViUngHo" class="admin-form-control" required />
                <span asp-validation-for="DonViUngHo" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Nội dung chăm lo <span class="required">*</span></label>
                <textarea asp-for="NoiDung" class="admin-form-control" rows="3" required></textarea>
                <span asp-validation-for="NoiDung" class="admin-form-error"></span>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label class="admin-form-label">Số lượng (hộ/phần) <span class="required">*</span></label>
                    <input asp-for="SoLuongHo" type="number" min="1" class="admin-form-control" required />
                    <span asp-validation-for="SoLuongHo" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Tổng kinh phí (VNĐ) <span class="required">*</span></label>
                    <input asp-for="KinhPhi" type="number" min="0" class="admin-form-control" required />
                    <span asp-validation-for="KinhPhi" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="fas fa-save"></i> Cập nhật dữ liệu
                </button>
                <a href="/admin/ketquachamlo" class="admin-btn admin-btn-ghost">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}