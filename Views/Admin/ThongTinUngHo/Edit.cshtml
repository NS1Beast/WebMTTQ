@model WebMTTQ.Models.ThongTinNhanUngHo
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Cập nhật thông tin ủng hộ";
}

<div class="admin-page-header">
    <div>
        <h2>Chỉnh sửa thông tin tài khoản</h2>
        <div class="subtitle">Cập nhật thông tin tài khoản ngân hàng tiếp nhận</div>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card" style="max-width: 800px;">
    <div class="admin-card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label asp-for="TenNgânHang" class="admin-form-label"></label>
                    <input asp-for="TenNgânHang" class="admin-form-control" />
                    <span asp-validation-for="TenNgânHang" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="ChiNhanh" class="admin-form-label"></label>
                    <input asp-for="ChiNhanh" class="admin-form-control" />
                    <span asp-validation-for="ChiNhanh" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label asp-for="SoTaiKhoan" class="admin-form-label"></label>
                    <input asp-for="SoTaiKhoan" class="admin-form-control" />
                    <span asp-validation-for="SoTaiKhoan" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="TenTaiKhoan" class="admin-form-label"></label>
                    <input asp-for="TenTaiKhoan" class="admin-form-control" />
                    <span asp-validation-for="TenTaiKhoan" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-group">
                <label asp-for="DonViThuHuong" class="admin-form-label"></label>
                <input asp-for="DonViThuHuong" class="admin-form-control" />
                <span asp-validation-for="DonViThuHuong" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="QrCodeUrl" class="admin-form-label"></label>
                <input asp-for="QrCodeUrl" class="admin-form-control" />
                <span asp-validation-for="QrCodeUrl" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="NoiDungChuyenKhoan" class="admin-form-label"></label>
                <input asp-for="NoiDungChuyenKhoan" class="admin-form-control" />
                <span asp-validation-for="NoiDungChuyenKhoan" class="admin-form-error"></span>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="fas fa-save"></i> Cập nhật thay đổi
                </button>
                <a asp-action="Index" class="admin-btn admin-btn-ghost">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}