@model WebMTTQ.Models.ThongTinNhanUngHo
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm tài khoản nhận ủng hộ";
}

<div class="admin-page-header">
    <div>
        <h2>Thêm mới tài khoản nhận ủng hộ</h2>
        <div class="subtitle">Nhập thông tin tài khoản ngân hàng tiếp nhận</div>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="admin-card" style="max-width: 800px;">
    <div class="admin-card-body">
        <!-- Đã thêm enctype để gửi file ảnh -->
        <form asp-action="Create" method="post" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn lưu tài khoản mới này?');">
            <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger"></div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label asp-for="TenNgânHang" class="admin-form-label"></label>
                    <input asp-for="TenNgânHang" class="admin-form-control" placeholder="VD: BIDV" />
                    <span asp-validation-for="TenNgânHang" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="ChiNhanh" class="admin-form-label"></label>
                    <input asp-for="ChiNhanh" class="admin-form-control" placeholder="VD: Chi nhánh Củ Chi" />
                    <span asp-validation-for="ChiNhanh" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-row">
                <div class="admin-form-group">
                    <label asp-for="SoTaiKhoan" class="admin-form-label"></label>
                    <input asp-for="SoTaiKhoan" class="admin-form-control" placeholder="VD: 8675789789" />
                    <span asp-validation-for="SoTaiKhoan" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="TenTaiKhoan" class="admin-form-label"></label>
                    <input asp-for="TenTaiKhoan" class="admin-form-control" placeholder="Chủ tài khoản" />
                    <span asp-validation-for="TenTaiKhoan" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-group">
                <label asp-for="DonViThuHuong" class="admin-form-label"></label>
                <input asp-for="DonViThuHuong" class="admin-form-control" placeholder="VD: QUỸ VÌ NGƯỜI NGHÈO PHƯỜNG TÂN ĐỊNH" />
                <span asp-validation-for="DonViThuHuong" class="admin-form-error"></span>
            </div>

            <!-- Đã sửa thành nút Tải ảnh -->
            <div class="admin-form-group">
                <label class="admin-form-label">Tải lên Ảnh QR Code</label>
                <input type="file" name="FileQr" id="FileQr" accept="image/*" class="admin-form-control" />

                <div id="previewContainer" style="display:none; margin-top: 15px;">
                    <p style="margin-bottom: 5px; font-size: 0.9rem; color: #666;">Ảnh xem trước:</p>
                    <img id="imagePreview" src="" style="max-width: 200px; border-radius: 8px; border: 1px solid #ddd;" />
                </div>
            </div>

            <div class="admin-form-group">
                <label asp-for="NoiDungChuyenKhoan" class="admin-form-label"></label>
                <input asp-for="NoiDungChuyenKhoan" class="admin-form-control" placeholder="VD: HO TEN - SO DIEN THOAI" />
                <span asp-validation-for="NoiDungChuyenKhoan" class="admin-form-error"></span>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-success">
                    <i class="fas fa-save"></i> Lưu thông tin
                </button>
                <a asp-action="Index" class="admin-btn admin-btn-ghost">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('FileQr').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('previewContainer').style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}