@model IEnumerable<WebMTTQ.Models.ThongTinNhanUngHo>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý thông tin ủng hộ";
}

<div class="admin-page-header">
    <div>
        <h2>Danh sách tài khoản tiếp nhận</h2>
        <div class="subtitle">Quản lý các tài khoản ngân hàng tiếp nhận ủng hộ</div>
    </div>
    <a asp-action="Create" class="admin-btn admin-btn-primary">
        <i class="fas fa-plus"></i> Thêm tài khoản
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ngân hàng</th>
                        <th>Tài khoản</th>
                        <th>Đơn vị thụ hưởng</th>
                        <th class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.TenNgânHang</strong>
                                    <div style="font-size:0.8rem;color:var(--admin-muted);">@item.ChiNhanh</div>
                                </td>
                                <td>
                                    <span class="admin-badge red" style="font-size:0.85rem;">@item.SoTaiKhoan</span>
                                    <div style="font-size:0.82rem;font-weight:600;margin-top:4px;">@item.TenTaiKhoan</div>
                                </td>
                                <td>@item.DonViThuHuong</td>
                                <td class="cell-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn admin-btn-warning admin-btn-sm">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này không?');">
                                        <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="admin-empty">
                                    <i class="fas fa-university"></i>
                                    <p>Chưa có dữ liệu thông tin ủng hộ nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>