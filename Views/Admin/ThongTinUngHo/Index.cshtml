@model IEnumerable<WebMTTQ.Models.ThongTinNhanUngHo>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Code cũ của bạn giữ nguyên ở bên dưới -->
@{
    ViewData["Title"] = "Quản lý thông tin ủng hộ";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase">Danh sách tài khoản tiếp nhận</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            + Thêm mới tài khoản
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ngân hàng</th>
                        <th>Tài khoản</th>
                        <th>Đơn vị thụ hưởng</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <strong>@item.TenNgânHang</strong>
                                    <div class="text-muted small">@item.ChiNhanh</div>
                                </td>
                                <td>
                                    <span class="badge bg-danger fs-6 mb-1">@item.SoTaiKhoan</span>
                                    <div class="small fw-bold">@item.TenTaiKhoan</div>
                                </td>
                                <td>@item.DonViThuHuong</td>
                                <td class="text-center pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2">Sửa</a>

                                    <!-- Form Xóa trực tiếp -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu thông tin ủng hộ nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>