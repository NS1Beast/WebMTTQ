@model WebMTTQ.Models.HopThuGopY

@{
    ViewData["Title"] = "Chi tiết góp ý";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-card {
        background: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 30px;
    }

    .admin-title {
        font-size: 1.5rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 25px;
        border-bottom: 2px solid #eee;
        padding-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-back {
        background: #6c757d;
        color: white;
        padding: 8px 15px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
    }

        .btn-back:hover {
            background: #5a6268;
            color: white;
        }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        background: #fcfcfc;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #eee;
    }

    .detail-label {
        font-size: 0.85rem;
        color: #888;
        font-weight: bold;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .detail-value {
        font-size: 1rem;
        color: #222;
    }

    .full-width {
        grid-column: span 2;
    }

    .content-box {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        border: 1px solid #ddd;
        line-height: 1.6;
        color: #333;
        white-space: pre-wrap;
    }

    .action-box {
        background: #f8f9fa;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #e9ecef;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: bold;
        margin-bottom: 8px;
        display: block;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        font-size: 1rem;
        box-sizing: border-box;
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .btn-save {
        background: #28a745;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-save:hover {
            background: #218838;
        }

    .btn-danger {
        background: #dc3545;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: span 1;
        }
    }
</style>

<div class="admin-card">
    <div class="admin-title">
        <span>Chi tiết ý kiến góp ý #@Model.IdgopY</span>
        <a href="@Url.Action("Index", "AdminGopY")" class="btn-back">← Quay lại danh sách</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="detail-grid">
        <div class="detail-item">
            <div class="detail-label">Người gửi</div>
            <div class="detail-value"><strong>@Model.HoTen</strong></div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Ngày gửi</div>
            <div class="detail-value">@(Model.NgayGui?.ToString("dd/MM/yyyy HH:mm"))</div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Số điện thoại</div>
            <div class="detail-value">@Model.SoDienThoai</div>
        </div>
        <div class="detail-item">
            <div class="detail-label">Email</div>
            <div class="detail-value">@(string.IsNullOrEmpty(Model.Email) ? "Không có" : Model.Email)</div>
        </div>
        <div class="detail-item full-width">
            <div class="detail-label">Địa chỉ</div>
            <div class="detail-value">@Model.DiaChi</div>
        </div>
        <div class="detail-item full-width">
            <div class="detail-label">Lĩnh vực</div>
            <div class="detail-value">
                <span style="background: #e2e3e5; padding: 5px 12px; border-radius: 12px; font-weight: bold;">@Model.LinhVuc</span>
            </div>
        </div>
        <div class="detail-item full-width">
            <div class="detail-label">Tiêu đề</div>
            <div class="detail-value" style="font-size: 1.1rem; font-weight: bold;">@Model.TieuDe</div>
        </div>
        <div class="detail-item full-width" style="background: transparent; border: none; padding: 0;">
            <div class="detail-label" style="margin-bottom: 10px;">Nội dung chi tiết</div>
            <div class="content-box">@Model.NoiDung</div>
        </div>

        @if (Model.TepMinhChung != null && Model.TepMinhChung.Length > 0)
        {
            <div class="detail-item full-width">
                <div class="detail-label">Tệp đính kèm (Ảnh minh chứng)</div>
                <div style="margin-top: 10px;">
                    <!-- Chuyển byte array thành ảnh Base64 để hiển thị trực tiếp trên Admin -->
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.TepMinhChung)" style="max-width: 100%; max-height: 400px; border-radius: 8px; border: 1px solid #ddd;" />
                </div>
            </div>
        }
    </div>

    <!-- KHU VỰC XỬ LÝ DÀNH CHO ADMIN -->
    <div class="action-box">
        <h4 style="margin-top: 0; margin-bottom: 20px; color: #333;">Cập nhật xử lý</h4>

        <form asp-action="XuLy" asp-controller="AdminGopY" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdgopY" />

            <div class="form-group">
                <label class="form-label">Trạng thái hiện tại</label>
                <select name="TrangThai" class="form-control">
                    <option value="Chưa xử lý" selected="@(Model.TrangThai == "Chưa xử lý" ? "selected" : null)">Chưa xử lý</option>
                    <option value="Đang xử lý" selected="@(Model.TrangThai == "Đang xử lý" ? "selected" : null)">Đang xử lý</option>
                    <option value="Đã xử lý" selected="@(Model.TrangThai == "Đã xử lý" ? "selected" : null)">Đã xử lý</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Ghi chú / Nội dung phản hồi</label>
                <textarea name="NoiDungPhanHoi" class="form-control" placeholder="Nhập kết quả xử lý hoặc ghi chú nội bộ...">@Model.NoiDungPhanHoi</textarea>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
                <button type="submit" class="btn-save">Lưu trạng thái</button>
            </div>
        </form>

        <!-- FORM XÓA GÓP Ý (Nút riêng biệt) -->
        <form asp-action="Delete" asp-controller="AdminGopY" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn XÓA góp ý này khỏi hệ thống không?');" style="margin-top: 20px; border-top: 1px solid #ddd; padding-top: 20px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdgopY" />
            <button type="submit" class="btn-danger">Xóa góp ý này</button>
        </form>
    </div>
</div>