@model WebMTTQ.Models.HopThuGopY

@{
    ViewData["Title"] = "Chi tiết góp ý";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div>
        <h2>Chi tiết ý kiến góp ý #@Model.IdgopY</h2>
        <div class="subtitle">Xem thông tin và xử lý ý kiến đóng góp</div>
    </div>
    <a href="@Url.Action("Index", "AdminGopY")" class="admin-btn admin-btn-ghost">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="admin-alert admin-alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["SuccessMessage"]
    </div>
}

<div class="admin-card">
    <div class="admin-card-body">
        <div class="admin-detail-grid">
            <div class="admin-detail-item">
                <div class="admin-detail-label">Người gửi</div>
                <div class="admin-detail-value"><strong>@Model.HoTen</strong></div>
            </div>
            <div class="admin-detail-item">
                <div class="admin-detail-label">Ngày gửi</div>
                <div class="admin-detail-value">@(Model.NgayGui?.ToString("dd/MM/yyyy HH:mm"))</div>
            </div>
            @if (Model.IdnguoiXuLyNavigation != null)
            {
                <div class="admin-detail-item">
                    <div class="admin-detail-label">Người xử lý</div>
                    <div class="admin-detail-value"><strong>@Model.IdnguoiXuLyNavigation.HoTen</strong></div>
                </div>
            }
            <div class="admin-detail-item">
                <div class="admin-detail-label">Số điện thoại</div>
                <div class="admin-detail-value"><strong>@Model.SoDienThoai</strong></div>
            </div>
            <div class="admin-detail-item">
                <div class="admin-detail-label">Email</div>
                <div class="admin-detail-value">@(string.IsNullOrEmpty(Model.Email) ? "Không có" : Model.Email)</div>
            </div>
            <div class="admin-detail-item full-width">
                <div class="admin-detail-label">Địa chỉ</div>
                <div class="admin-detail-value">@Model.DiaChi</div>
            </div>
            <div class="admin-detail-item full-width">
                <div class="admin-detail-label">Lĩnh vực</div>
                <div class="admin-detail-value">
                    <span class="admin-badge blue">@Model.LinhVuc</span>
                </div>
            </div>
            <div class="admin-detail-item full-width">
                <div class="admin-detail-label">Tiêu đề</div>
                <div class="admin-detail-value" style="font-size:1.05rem;font-weight:700;">@Model.TieuDe</div>
            </div>
            <div class="admin-detail-item full-width" style="background:transparent;border:none;padding:0;">
                <div class="admin-detail-label" style="margin-bottom:8px;">Nội dung chi tiết</div>
                <div style="background:#f8f6f4;padding:20px;border-radius:8px;border:1px solid var(--admin-line);line-height:1.7;white-space:pre-wrap;color:var(--admin-ink);">
                    @Model.NoiDung
                </div>
            </div>

            @if (Model.TepMinhChung != null && Model.TepMinhChung.Length > 0)
            {
                <div class="admin-detail-item full-width">
                    <div class="admin-detail-label">Tệp đính kèm (Ảnh minh chứng)</div>
                    <div style="margin-top: 8px;">
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.TepMinhChung)" style="max-width:100%;max-height:400px;border-radius:8px;border:1px solid var(--admin-line);" />
                    </div>
                </div>
            }
        </div>

        <!-- KHU VỰC XỬ LÝ -->
        <div style="margin-top:24px;padding:24px;background:#fcfaf9;border-radius:var(--admin-radius-sm);border:1px solid var(--admin-line);">
            <h5 style="margin:0 0 20px;font-weight:600;color:var(--admin-ink);">Cập nhật xử lý</h5>

            <form asp-action="XuLy" asp-controller="AdminGopY" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật trạng thái xử lý cho góp ý này?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdgopY" />

                <div class="admin-form-group" style="max-width:400px;">
                    <label class="admin-form-label">Trạng thái hiện tại</label>
                    <select name="TrangThai" class="admin-form-control">
                        <option value="Chưa xử lý" selected="@(Model.TrangThai == "Chưa xử lý" ? "selected" : null)">Chưa xử lý</option>
                        <option value="Đang xử lý" selected="@(Model.TrangThai == "Đang xử lý" ? "selected" : null)">Đang xử lý</option>
                        <option value="Đã xử lý" selected="@(Model.TrangThai == "Đã xử lý" ? "selected" : null)">Đã xử lý</option>
                        <option value="Từ chối" selected="@(Model.TrangThai == "Từ chối" ? "selected" : null)">Từ chối</option>
                    </select>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Ghi chú / Nội dung phản hồi</label>
                    <textarea name="NoiDungPhanHoi" class="admin-form-control" rows="4" placeholder="Nhập kết quả xử lý hoặc ghi chú nội bộ...">@Model.NoiDungPhanHoi</textarea>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="admin-btn admin-btn-success">
                        <i class="fas fa-save"></i> Lưu trạng thái
                    </button>
                </div>
            </form>

            <!-- FORM XÓA -->
            <form asp-action="Delete" asp-controller="AdminGopY" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn XÓA góp ý này khỏi hệ thống không?');" style="margin-top:24px;padding-top:20px;border-top:1px solid var(--admin-line);">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdgopY" />
                <button type="submit" class="admin-btn admin-btn-danger">
                    <i class="fas fa-trash"></i> Xóa góp ý này
                </button>
            </form>
        </div>
    </div>
</div>