@model IEnumerable<WebMTTQ.Models.HopThuGopY>

@{
    ViewData["Title"] = "Quản lý Hộp Thư Góp Ý";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div>
        <h2>Hộp thư góp ý</h2>
        <div class="subtitle">Tiếp nhận và xử lý các ý kiến đóng góp từ người dân</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="admin-alert admin-alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["SuccessMessage"]
    </div>
}

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="50">#</th>
                        <th width="140">Ngày gửi</th>
                        <th width="160">Người gửi</th>
                        <th width="130">Lĩnh vực</th>
                        <th>Tiêu đề</th>
                        <th width="110">Trạng thái</th>
                        <th width="120" class="cell-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@(item.NgayGui?.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>
                                    <strong>@item.HoTen</strong><br />
                                    <span style="font-size:0.78rem;color:var(--admin-muted);">@item.SoDienThoai</span>
                                </td>
                                <td>
                                    <span class="admin-badge gray" style="font-size:0.72rem;">@item.LinhVuc</span>
                                </td>
                                <td>@item.TieuDe</td>
                                <td>
                                    @if (item.TrangThai == "Đã xử lý")
                                    {
                                        <span class="admin-badge green">Đã xử lý</span>
                                    }
                                    else if (item.TrangThai == "Đang xử lý")
                                    {
                                        <span class="admin-badge info">Đang xử lý</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge warning">Chưa xử lý</span>
                                    }
                                </td>
                                <td class="cell-actions">
                                    <a href="@Url.Action("Details", "AdminGopY", new { id = item.IdgopY })" class="admin-btn admin-btn-primary admin-btn-sm">
                                        <i class="fas fa-eye"></i> Xem
                                    </a>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty">
                                    <i class="fas fa-envelope-open-text"></i>
                                    <p>Chưa có dữ liệu góp ý nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>