@model WebMTTQ.Models.BaiViet

@{
    ViewData["Title"] = "Sửa bài viết";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<WebMTTQ.Models.ChuyenMuc> ?? new();
}

<style>
    .news-editor-wrap { border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background: #fff; }
    .video-url-input { display: flex; gap: 10px; align-items: center; }
    .video-url-input input { flex: 1; }
    .video-preview { margin-top: 10px; }
    .video-preview iframe { max-width: 100%; border-radius: 8px; border: 1px solid #ddd; }
    .editor-hint { font-size: 0.8rem; color: #888; margin-top: 6px; }
</style>

<div class="admin-card" style="background:#fff; padding:30px; border-radius:12px; max-width: 1100px; margin: 0 auto; box-shadow:0 4px 15px rgba(0,0,0,0.05);">
    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 15px;">
        <a href="@Url.Action("Index", "AdminNews")" style="color: #666; text-decoration: none; font-size: 1.2rem;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h2 style="margin: 0; color: #333; font-size: 1.4rem;">Sửa bài viết: @Model.TieuDe</h2>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="newsForm" onsubmit="return confirm('Xác nhận lưu các thay đổi này? Kiểm tra lại nội dung trước khi cập nhật.');">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdbaiViet" />

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="TieuDe" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Tiêu đề bài viết <span style="color:red;">*</span></label>
            <input asp-for="TieuDe" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" placeholder="Nhập tiêu đề bài viết..." required />
            <span asp-validation-for="TieuDe" style="color: #dc3545; font-size: 0.85rem;"></span>
        </div>

        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div class="form-group">
                <label asp-for="IdchuyenMuc" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Chuyên mục <span style="color:red;">*</span></label>
                <select asp-for="IdchuyenMuc" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; background: white;" required>
                    <option value="">-- Chọn chuyên mục --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.IdchuyenMuc" selected="@(cat.IdchuyenMuc == Model.IdchuyenMuc)">@cat.TenChuyenMuc</option>
                    }
                </select>
                <span asp-validation-for="IdchuyenMuc" style="color: #dc3545; font-size: 0.85rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="TrangThai" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Trạng thái</label>
                <select asp-for="TrangThai" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; background: white;">
                    <option value="DaDang">Hiển thị</option>
                    <option value="BanNhap">Bản nháp</option>
                    <option value="An">Ẩn</option>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="TomTat" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Tóm tắt</label>
            <textarea asp-for="TomTat" class="form-control" rows="3" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" placeholder="Nhập tóm tắt ngắn gọn..."></textarea>
            <span asp-validation-for="TomTat" style="color: #dc3545; font-size: 0.85rem;"></span>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Đổi hình ảnh mới (Bỏ trống nếu giữ ảnh cũ)</label>
            <input type="file" name="FileAnh" id="FileAnh" class="form-control" accept="image/*" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; background: white;" />
            <small style="color: #888;">Chấp nhận JPG, PNG, GIF. Tối đa 5MB.</small>

            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <div style="margin-top: 10px;">
                    <img src="@Model.HinhAnh" alt="Current" style="max-width: 200px; max-height: 120px; border-radius: 6px; border: 1px solid #ddd;" onerror="this.onerror=null;this.src='https://via.placeholder.com/200x120/cccccc/999999?text=No+Image'" />
                    <p style="font-size: 0.8rem; color: #888; margin: 5px 0 0;">Ảnh hiện tại</p>
                </div>
            }
            <div id="imagePreview" style="margin-top: 10px; display: none;">
                <img id="previewImg" src="#" alt="Preview" style="max-width: 200px; max-height: 120px; border-radius: 6px; border: 1px solid #ddd;" />
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">
                <i class="fas fa-video" style="color: #17a2b8; margin-right: 5px;"></i> Video bài viết (Tùy chọn)
            </label>
            <div class="video-url-input">
                <input type="text" id="VideoUrl" name="VideoUrl" class="form-control" value="@Model.VideoUrl" placeholder="Dán đường dẫn video (YouTube, Facebook, Vimeo...)" style="padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;" />
                <button type="button" id="btnPreviewVideo" class="btn" style="padding: 10px 16px; background: #17a2b8; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; white-space: nowrap;">
                    <i class="fas fa-eye"></i> Xem trước
                </button>
            </div>
            <div id="videoPreview" class="video-preview" style="display: none;"></div>
            <small style="color: #888;">Hỗ trợ: YouTube, Facebook, Vimeo, hoặc file video trực tiếp (.mp4, .webm)</small>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="NoiDung" style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Nội dung bài viết</label>
            <div class="news-editor-wrap">
                <textarea asp-for="NoiDung" id="NoiDung" style="min-height: 400px;"></textarea>
            </div>
            <div class="editor-hint">
                <i class="fas fa-info-circle"></i> Sử dụng thanh công cụ để định dạng văn bản, chèn ảnh, video, bảng biểu...
                Bạn có thể chèn ảnh trực tiếp vào bất kỳ vị trí nào trong bài viết bằng nút <i class="fas fa-image"></i> trên thanh công cụ.
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #333;">Tin nổi bật</label>
            <select asp-for="LaTinNoiBat" class="form-control" style="width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; background: white;">
                <option value="false">Không</option>
                <option value="true">Có</option>
            </select>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end; border-top: 1px solid #eee; padding-top: 20px;">
            <a href="@Url.Action("Index", "AdminNews")" class="btn" style="padding: 10px 24px; border: 1px solid #ddd; border-radius: 6px; text-decoration: none; color: #666; font-weight: 500;">Hủy</a>
            <button type="submit" class="btn" style="padding: 10px 24px; background: #17a2b8; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                <i class="fas fa-save"></i> Cập nhật
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/news-editor.js"></script>
    <script>
        // Xem trước ảnh đại diện
        document.getElementById('FileAnh').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                document.getElementById('imagePreview').style.display = 'none';
            }
        });

        // Xem trước video
        document.getElementById('btnPreviewVideo').addEventListener('click', function() {
            const url = document.getElementById('VideoUrl').value.trim();
            const preview = document.getElementById('videoPreview');
            if (!url) {
                preview.style.display = 'none';
                preview.innerHTML = '';
                return;
            }
            const embedHtml = getVideoEmbed(url);
            if (embedHtml) {
                preview.innerHTML = embedHtml;
                preview.style.display = 'block';
            } else {
                preview.innerHTML = '<p style="color:#dc3545; font-size:0.85rem;">Không thể nhúng video từ đường dẫn này. Vui lòng kiểm tra lại.</p>';
                preview.style.display = 'block';
            }
        });

        function getVideoEmbed(url) {
            // YouTube
            let match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
            if (match) {
                return '<iframe width="560" height="315" src="https://www.youtube.com/embed/' + match[1] + '" frameborder="0" allowfullscreen></iframe>';
            }
            // Vimeo
            match = url.match(/vimeo\.com\/(\d+)/);
            if (match) {
                return '<iframe src="https://player.vimeo.com/video/' + match[1] + '" width="560" height="315" frameborder="0" allowfullscreen></iframe>';
            }
            // Facebook
            if (url.includes('facebook.com') || url.includes('fb.watch')) {
                return '<iframe src="https://www.facebook.com/plugins/video.php?href=' + encodeURIComponent(url) + '&show_text=false" width="560" height="315" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>';
            }
            // File trực tiếp
            if (url.match(/\.(mp4|webm|ogg)(\?.*)?$/i)) {
                return '<video controls width="560" style="max-width:100%;"><source src="' + url + '" type="video/mp4">Trình duyệt không hỗ trợ video.</video>';
            }
            return null;
        }

        // Khởi tạo NewsEditor (thay thế TinyMCE - miễn phí, không cần API key)
        var editor = new NewsEditor('NoiDung', {
            uploadUrl: '@Url.Action("UploadImage", "AdminNews")',
            height: 500,
            placeholder: 'Nhập nội dung bài viết...'
        });
    </script>
}