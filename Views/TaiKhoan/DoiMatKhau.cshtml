@model WebMTTQ.Models.DoiMatKhauViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="admin-page-header" style="margin-bottom: 20px;">
    <div>
        <h2><i class="fas fa-key"></i> Đổi mật khẩu</h2>
        <div class="subtitle">Thay đổi mật khẩu đăng nhập của tài khoản</div>
    </div>
    <a href="/TaiKhoan/ThongTin" class="admin-btn" style="padding:10px 20px; border-radius:10px;">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="admin-alert admin-alert-success" style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.2); color:#059669; padding:12px 16px; border-radius:8px; margin-bottom:16px; display:flex; gap:8px; align-items:center;">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<div style="max-width: 500px;">
    <div style="background:#fff; border:1px solid #eae5e1; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
        <form asp-action="DoiMatKhau" method="post">
            @Html.AntiForgeryToken()

            <div class="admin-form-group">
                <label class="admin-form-label">Mật khẩu hiện tại <span style="color:#dc2626;">*</span></label>
                <input asp-for="MatKhauHienTai" type="password" class="admin-form-control" placeholder="Nhập mật khẩu hiện tại" />
                <span asp-validation-for="MatKhauHienTai" style="color:#dc2626; font-size:0.75rem;"></span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Mật khẩu mới <span style="color:#dc2626;">*</span></label>
                <input asp-for="MatKhauMoi" type="password" class="admin-form-control" placeholder="Ít nhất 6 ký tự" />
                <span asp-validation-for="MatKhauMoi" style="color:#dc2626; font-size:0.75rem;"></span>
            </div>

            <div class="admin-form-group">
                <label class="admin-form-label">Xác nhận mật khẩu mới <span style="color:#dc2626;">*</span></label>
                <input asp-for="XacNhanMatKhauMoi" type="password" class="admin-form-control" placeholder="Nhập lại mật khẩu mới" />
                <span asp-validation-for="XacNhanMatKhauMoi" style="color:#dc2626; font-size:0.75rem;"></span>
            </div>

            <div class="admin-alert admin-alert-warning" style="margin-top:16px; background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.2); color:#b45309; padding:10px 14px; border-radius:8px; font-size:0.78rem;">
                <i class="fas fa-exclamation-triangle"></i>
                Sau khi đổi mật khẩu, bạn sẽ cần sử dụng mật khẩu mới cho lần đăng nhập tiếp theo.
            </div>

            <div style="margin-top:20px; display:flex; justify-content:flex-end; gap:10px;">
                <a href="/TaiKhoan/ThongTin" class="admin-btn" style="padding:10px 20px; border-radius:10px;">Hủy</a>
                <button type="submit" class="admin-btn admin-btn-success" style="padding:10px 24px; border-radius:10px;">
                    <i class="fas fa-key"></i> Đổi mật khẩu
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    .admin-page-header h2 {
        margin: 0 0 4px;
        font-size: 1.4rem;
        color: #1e1a1d;
    }
    .admin-page-header .subtitle {
        font-size: 0.85rem;
        color: #7a6e72;
    }
    .admin-form-group {
        margin-bottom: 16px;
    }
    .admin-form-label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 6px;
    }
    .admin-form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e0dcd8;
        border-radius: 8px;
        font-size: 0.85rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }
    .admin-form-control:focus {
        border-color: #8b1a2b;
    }
</style>