@model List<WebMTTQ.Models.ModuleQuyenCheckbox>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quyền của tôi";
}

<div class="admin-page-header" style="margin-bottom: 20px;">
    <div>
        <h2><i class="fas fa-shield-alt"></i> Quyền truy cập của tôi</h2>
        <div class="subtitle">Danh sách các module bạn được phép truy cập và thao tác</div>
    </div>
    <a href="/TaiKhoan/ThongTin" class="admin-btn" style="padding:10px 20px; border-radius:10px;">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div style="background:#fff; border:1px solid #eae5e1; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
    @{
        var duocQuyenModules = Model.Where(m => m.DuocChon).ToList();
    }

    @if (duocQuyenModules.Count == 0)
    {
        <div style="text-align:center; padding:40px; color:#999;">
            <i class="fas fa-shield-alt" style="font-size:3rem; display:block; margin-bottom:16px; color:#ddd;"></i>
            <p style="font-size:1rem;">Bạn chưa được cấp quyền truy cập vào module nào.</p>
            <p style="font-size:0.85rem;">Vui lòng liên hệ quản trị viên hệ thống để được cấp quyền.</p>
        </div>
    }
    else
    {
        <!-- Admin full access -->
        @if (ViewBag.IsAdmin == true)
        {
            <div class="admin-alert" style="background:rgba(139,26,43,0.08); border:1px solid rgba(139,26,43,0.2); color:#8b1a2b; padding:12px 16px; border-radius:8px; font-size:0.85rem; margin-bottom:20px;">
                <i class="fas fa-crown"></i>
                Bạn là <strong>ADMIN</strong> - có toàn quyền truy cập tất cả các chức năng của hệ thống.
            </div>
        }

        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap:16px;">
            @foreach (var module in duocQuyenModules)
            {
                <div style="border:1px solid #eae5e1; border-radius:12px; padding:16px 20px; background:#fcfaf9;">
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                        <div style="width:36px; height:36px; border-radius:10px; background:rgba(139,26,43,0.1); display:flex; align-items:center; justify-content:center;">
                            <i class="fas @module.Icon" style="color:#8b1a2b; font-size:0.95rem;"></i>
                        </div>
                        <div>
                            <strong style="font-size:0.9rem; color:#333; display:block;">@module.TenModule</strong>
                            <span style="font-size:0.72rem; color:#999;">@module.MoTa</span>
                        </div>
                    </div>
                    <div style="display:flex; gap:10px; flex-wrap:wrap;">
                        <span style="display:inline-flex; align-items:center; gap:5px; font-size:0.75rem; padding:4px 10px; border-radius:20px; background:@(module.CoQuyenXem ? "rgba(16,185,129,0.1)" : "#f2f2f2"); color:@(module.CoQuyenXem ? "#059669" : "#aaa");">
                            <i class="fas fa-eye"></i> Xem
                        </span>
                        <span style="display:inline-flex; align-items:center; gap:5px; font-size:0.75rem; padding:4px 10px; border-radius:20px; background:@(module.CoQuyenThem ? "rgba(16,185,129,0.1)" : "#f2f2f2"); color:@(module.CoQuyenThem ? "#059669" : "#aaa");">
                            <i class="fas fa-plus"></i> Thêm
                        </span>
                        <span style="display:inline-flex; align-items:center; gap:5px; font-size:0.75rem; padding:4px 10px; border-radius:20px; background:@(module.CoQuyenSua ? "rgba(16,185,129,0.1)" : "#f2f2f2"); color:@(module.CoQuyenSua ? "#059669" : "#aaa");">
                            <i class="fas fa-edit"></i> Sửa
                        </span>
                        <span style="display:inline-flex; align-items:center; gap:5px; font-size:0.75rem; padding:4px 10px; border-radius:20px; background:@(module.CoQuyenXoa ? "rgba(16,185,129,0.1)" : "#f2f2f2"); color:@(module.CoQuyenXoa ? "#059669" : "#aaa");">
                            <i class="fas fa-trash"></i> Xóa
                        </span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    .admin-page-header h2 {
        margin: 0 0 4px;
        font-size: 1.4rem;
        color: #1e1a1d;
    }
    .admin-page-header .subtitle {
        font-size: 0.85rem;
        color: #7a6e72;
    }
</style>