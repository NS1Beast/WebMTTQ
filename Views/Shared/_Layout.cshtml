@using WebMTTQ.Models
@using System.Linq
@inject DataMTTQContext _context

@{
    // Lấy cấu hình hệ thống từ Database
    var configs = _context.CauHinhHeThongs.ToList();

    // Hàm tiện ích để lấy giá trị cấu hình, nếu null thì gán mặc định
    string GetConfig(string key, string defaultVal = "")
    {
        return configs.FirstOrDefault(c => c.MaCauHinh == key)?.GiaTriCauHinh ?? defaultVal;
    }

    // Gán dữ liệu vào các biến
    var tenCoQuan = GetConfig("TenCoQuan", "Ủy ban MTTQ Việt Nam Phường Tân Định");
    var diaChi = GetConfig("DiaChi", "PHƯỜNG TÂN ĐỊNH, TP.HCM");
    var soDienThoai = GetConfig("SoDienThoai", "0123456789");
    var email = GetConfig("Email", "mttq@gmail.com");
    var linkFb = GetConfig("LinkFacebook", "#");
    var linkZalo = GetConfig("LinkZalo", "#");

    // Logic Active Menu
    var isHome = ViewContext.RouteData.Values["action"]?.ToString() == "Index"
        && ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
    var isAbout = ViewContext.RouteData.Values["action"]?.ToString() == "Index"
        && ViewContext.RouteData.Values["controller"]?.ToString() == "About";
    var isNews = ViewContext.RouteData.Values["controller"]?.ToString() == "News";

    // Lấy danh sách chuyên mục TIN TỨC hiển thị (tối đa 10) - không lấy chuyên mục văn bản
    var newsCategories = _context.ChuyenMucs
        .Where(c => c.DaXoa == false && c.HienThi == true && c.LoaiChuyenMuc == LoaiChuyenMucConstants.TinTuc)
        .OrderBy(c => c.ThuTu)
        .ThenBy(c => c.TenChuyenMuc)
        .Take(10)
        .ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - " : "")@tenCoQuan</title>
    <meta name="description" content="Trang thông tin chính thức của @tenCoQuan – cập nhật tin tức và hoạt động địa phương." />
    <meta name="theme-color" content="#3C0709" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,700&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap&subset=vietnamese" rel="stylesheet" />

    <!-- THÊM THƯ VIỆN FONTAWESOME ĐỂ HIỂN THỊ ICON CHO MENU -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="icon" href="~/images/LogoGioiThieu/logoMTTQ.png" sizes="32x32" />
    <link rel="stylesheet" href="~/css/mttq.css" asp-append-version="true" />

    <style>
            /* ==============================================
                       1. NÚT LÊN ĐẦU TRANG & TRỢ LÝ AI
                       ============================================== */
            .m26-top {
                position: fixed;
                bottom: 100px;
                right: 30px;
                width: 48px;
                height: 48px;
                background-color: #9a2123;
                color: #ffffff;
                border: none;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
                z-index: 9998;
                cursor: pointer;
                transition: all 0.3s ease;
            }

                .m26-top:hover {
                    background-color: #701416;
                    transform: translateY(-3px);
                }

            .m26-ai-btn {
                position: fixed;
                bottom: 30px;
                right: 30px;
                display: inline-flex;
                align-items: center;
                background: linear-gradient(90deg, #b02a2c 0%, #701416 100%);
                color: #ffffff;
                padding: 4px 18px 4px 4px;
                border-radius: 50px;
                text-decoration: none;
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25);
                z-index: 9998;
                transition: all 0.3s ease;
            }

                .m26-ai-btn:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
                    color: #ffffff;
                    text-decoration: none;
                }

            .m26-ai-icon {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background-color: #ffffff;
                border: 2px solid #d49544;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 12px;
                overflow: hidden;
                box-shadow: inset 0 0 5px rgba(0,0,0,0.1);
            }

                .m26-ai-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    border-radius: 50%;
                }

            .m26-ai-text {
                font-family: 'Be Vietnam Pro', sans-serif;
                font-weight: 700;
                font-size: 16px;
                white-space: nowrap;
            }

            /* ==============================================
                       2. CSS MOBILE MENU (PHONG CÁCH CARD GIỐNG ẢNH 2)
                       ============================================== */
            /* Nền menu gradient đỏ sẫm */
            .m26-drawer-in {
                background: linear-gradient(180deg, #7a0c16 0%, #3d0308 100%) !important;
                color: #ffffff;
            }

            /* Chỉnh màu header của menu */
            .m26-drawer-head {
                border-bottom: 1px solid rgba(255,255,255,0.1);
            }

                .m26-drawer-head .m26-drawer-brand span strong,
                .m26-drawer-head .m26-drawer-brand span small {
                    color: #ffffff !important;
                }

                .m26-drawer-head .x {
                    color: #ffffff;
                }

            /* Reset padding list */
            .m26-mnav {
                list-style: none;
                padding: 15px 0;
                margin: 0;
            }

                .m26-mnav > li {
                    border-bottom: none !important;
                    margin-bottom: 12px;
                    padding: 0 15px;
                }

                /* Thẻ a và thẻ toggle biến thành dạng Card mờ */
                .m26-mnav a, .m-dropdown-toggle {
                    display: flex !important;
                    align-items: center;
                    background: rgba(255, 255, 255, 0.08) !important; /* Nền mờ trong suốt */
                    border: 1px solid rgba(255, 255, 255, 0.05);
                    border-radius: 12px;
                    padding: 10px 15px !important;
                    color: #ffffff !important;
                    font-weight: 600;
                    font-size: 0.95rem;
                    text-decoration: none;
                    transition: all 0.3s ease;
                    box-sizing: border-box;
                    width: 100%;
                }

                    .m26-mnav a:active, .m-dropdown-toggle:active {
                        background: rgba(255, 255, 255, 0.15) !important;
                    }

                    /* Span bọc chữ để dãn khoảng cách */
                    .m26-mnav a span:not(.m-caret), .m-dropdown-toggle span:not(.m-caret) {
                        flex-grow: 1;
                    }

            /* Khối icon vuông màu vàng bên trái */
            .m26-mnav-icon {
                width: 36px;
                height: 36px;
                background-color: #d49544; /* Vàng cam */
                border-radius: 8px;
                display: flex;
                justify-content: center;
                align-items: center;
                margin-right: 15px;
                color: #3d0308; /* Icon bên trong màu đỏ sẫm */
                font-size: 1.1rem;
                flex-shrink: 0;
            }

            /* Mũi tên bên phải */
            .m26-mnav-arrow {
                margin-left: auto;
                font-size: 0.85rem;
                color: rgba(255, 255, 255, 0.4);
            }

            /* Chỉnh riêng phần Toggle Dropdown */
            .m-dropdown-toggle {
                cursor: pointer;
            }

            .m-caret {
                padding: 0 !important;
                color: rgba(255, 255, 255, 0.4) !important;
                transition: transform 0.3s;
            }

            .m-dropdown.open .m-caret {
                color: #d49544 !important;
                transform: rotate(180deg);
            }

            /* Menu con ẩn mặc định */
            .m-dropdown-menu {
                display: none;
                list-style: none;
                padding: 5px 0 0 0;
                margin: 0;
                background-color: transparent !important;
                border-top: none !important;
            }

            .m-dropdown.open .m-dropdown-menu {
                display: block;
                animation: fadeInDown 0.3s ease forwards;
            }

            .m-dropdown-menu li {
                margin-bottom: 6px !important;
                padding: 0 !important;
            }

                .m-dropdown-menu li a {
                    background: rgba(0, 0, 0, 0.15) !important; /* Nền tối hơn card mẹ */
                    padding: 12px 15px 12px 65px !important; /* Thụt đầu dòng */
                    font-size: 0.85rem !important;
                    font-weight: 500 !important;
                    border: none !important;
                    border-radius: 10px;
                }

                    .m-dropdown-menu li a::before {
                        display: none;
                    }
            /* Tắt dấu chấm cũ */

            /* Làm mờ các phần tử ở footer của Menu */
            .m26-drawer-foot {
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                background: transparent !important;
            }

            .drawer-cta {
                background: #d49544 !important;
                color: #3d0308 !important;
                border-radius: 12px !important;
                font-weight: bold;
                border: none;
            }

            .m26-drawer-hot {
                color: #ffffff !important;
            }

                .m26-drawer-hot b {
                    color: #d49544 !important;
                }

            @@keyframes fadeInDown {
                from {
                    opacity: 0;
                    transform: translateY(-5px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ==============================================
                       3. RESPONSIVE ĐIỆN THOẠI
                       ============================================== */
            @@media (max-width: 768px) {
                .m26-ai-btn {
                    bottom: 85px;
                    right: 15px;
                }

                .m26-top {
                    bottom: 155px;
                    right: 15px;
                }
            }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="mttq2026 @(isHome ? "mttq2026-has-hero" : "")">

    <div id="m26-splash" role="status" aria-label="Đang tải">
        <div class="m26-splash-in">
            <div class="m26-splash-badge"><img src="~/images/LogoGioiThieu/logoMTTQ.png" alt="" width="82" height="82" /></div>
            <span class="m26-splash-txt">@tenCoQuan</span>
        </div>
    </div>

    <div class="m26">
        <div class="m26-util">
            <div class="wrap">
                <div class="u-left">
                    <span><span class="dot"></span><span id="m26-date">Đang tải…</span></span>
                    <a class="hide-sm" href="tel:@soDienThoai.Replace(".", "").Replace(" ", "")">Đường dây nóng: <b>@soDienThoai</b></a>
                </div>
                <div class="u-right">
                    <a class="hide-sm u-mail" href="mailto:@email">@email</a>
                    <div class="soc">
                        <a href="@linkFb" target="_blank" rel="noopener" aria-label="Facebook">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z" /></svg>
                        </a>
                        <a href="@linkZalo" target="_blank" rel="noopener" aria-label="Zalo"><b style="font-size:.6rem;font-weight:800">Zalo</b></a>
                    </div>
                </div>
            </div>
        </div>

        <header class="m26-head" id="m26-head">
            <div class="wrap head-inner">
                <a class="m26-brand" asp-controller="Home" asp-action="Index">
                    <img class="logo" src="~/images/LogoGioiThieu/logoMTTQ.png" alt="Biểu trưng MTTQ Việt Nam" />
                    <span>
                        <strong>Mặt trận Tổ quốc Việt Nam</strong>
                        <span>PHƯỜNG TÂN ĐỊNH</span>
                    </span>
                </a>

                <ul class="m26-nav">
                    <li class="nav-item"><a class="nav-link @(isHome ? "" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link @(isAbout ? "is-active" : "")" asp-controller="About" asp-action="Index">Giới thiệu</a></li>
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle @(isNews ? "is-active" : "")" role="button" aria-expanded="false">Danh mục Tin tức</a>
                        <ul class="dropdown-menu">
                            @foreach (var cat in newsCategories)
                            {
                                <li class="nav-item">
                                    <a class="dropdown-item" href="/News?category=@cat.DuongDan">@cat.TenChuyenMuc</a>
                                </li>
                            }
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle @(isNews ? "is-active" : "")" role="button" aria-expanded="false">An sinh xã hội</a>
                        <ul class="dropdown-menu">
                            <li class="nav-item"><a class="dropdown-item" asp-controller="CongThongTinAnSXH" asp-action="Index">Quỹ “Vì người nghèo”</a></li>
                            <li class="nav-item"><a class="dropdown-item" asp-controller="QuyBienDao" asp-action="ViBienDaoQueHuongViTuyenDauTQ">Quỹ “Vì biển đảo quê hương, vì tuyến đầu Tổ quốc”</a></li>
                            <li class="nav-item"><a class="dropdown-item" asp-controller="QuyCuuTro" asp-action="Index">Quỹ “Cứu trợ”</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="VanBanTaiLieu" asp-action="Index">Văn bản và tài liệu</a></li>
                </ul>

                <div class="m26-search" id="m26-search">
                    <button class="m26-search-btn" id="m26-search-btn" type="button" aria-label="Tìm kiếm" aria-expanded="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    </button>
                    <form class="m26-search-form" role="search" method="get" asp-controller="Home" asp-action="UnderConstruction">
                        <input type="search" name="s" id="m26-search-input" placeholder="Tìm tin tức, tài liệu…" aria-label="Từ khoá tìm kiếm" />
                        <button type="submit" class="m26-search-go" aria-label="Tìm">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                        </button>
                    </form>
                </div>

                <a class="cta" asp-controller="GopY" asp-action="Index">Gửi phản ánh</a>
                <button class="m26-burger" id="m26-burger" type="button" aria-label="Mở menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            </div>
        </header>

        <!-- ==============================================
             MÀN HÌNH MENU MOBILE
             ============================================== -->
        <div class="m26-drawer" id="m26-drawer">
            <div class="m26-drawer-in">
                <div class="m26-drawer-head">
                    <a class="m26-drawer-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/PhuongTanDinh.png" alt="Biểu trưng MTTQ" />
                        <span>
                            <strong>Mặt trận Tổ quốc</strong>
                            <small>PHƯỜNG TÂN ĐỊNH</small>
                        </span>
                    </a>
                    <button class="x" type="button" data-close aria-label="Đóng menu">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </button>
                </div>

                <nav class="m26-drawer-nav">
                    <ul class="m26-mnav">
                        <!-- 1. Trang chủ -->
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <div class="m26-mnav-icon"><i class="fas fa-home"></i></div>
                                <span>Trang chủ</span>
                                <i class="fas fa-chevron-right m26-mnav-arrow"></i>
                            </a>
                        </li>

                        <!-- 2. Giới thiệu -->
                        <li>
                            <a asp-controller="About" asp-action="Index">
                                <div class="m26-mnav-icon"><i class="fas fa-info-circle"></i></div>
                                <span>Giới thiệu</span>
                                <i class="fas fa-chevron-right m26-mnav-arrow"></i>
                            </a>
                        </li>

                        <!-- 3. DROP DOWN: CỔNG AN SINH XÃ HỘI -->
                        <li class="m-dropdown">
                            <div class="m-dropdown-toggle">
                                <div class="m26-mnav-icon"><i class="far fa-heart"></i></div>
                                <span>Cổng an sinh xã hội</span>
                                <span class="m-caret"><i class="fas fa-chevron-down"></i></span>
                            </div>
                            <ul class="m-dropdown-menu">
                                <li><a asp-controller="CongThongTinAnSXH" asp-action="Index">Quỹ vì người nghèo</a></li>
                                <li><a asp-controller="QuyBienDao" asp-action="ViBienDaoQueHuongViTuyenDauTQ">Quỹ vì biển đảo quê hương</a></li>
                                <li><a asp-controller="QuyCuuTro" asp-action="Index">Quỹ cứu trợ</a></li>
                            </ul>
                        </li>

                        <!-- 4. Văn bản tài liệu -->
                        <li>
                            <a asp-controller="VanBanTaiLieu" asp-action="Index">
                                <div class="m26-mnav-icon"><i class="far fa-file-alt"></i></div>
                                <span>Văn bản và tài liệu</span>
                                <i class="fas fa-chevron-right m26-mnav-arrow"></i>
                            </a>
                        </li>

                        <!-- 5. DROP DOWN: TIN TỨC -->
                        <li class="m-dropdown">
                            <div class="m-dropdown-toggle">
                                <div class="m26-mnav-icon"><i class="far fa-newspaper"></i></div>
                                <span>Tin tức</span>
                                <span class="m-caret"><i class="fas fa-chevron-down"></i></span>
                            </div>
                            <ul class="m-dropdown-menu">
                                <li><a href="/News?category=mat-tran-to-quoc">Tin tức Mặt Trận Tổ Quốc</a></li>
                                <li><a href="/News?category=doan-thanh-nien">Tin tức Đoàn Thanh niên</a></li>
                                <li><a href="/News?category=hoi-lien-hiep-phu-nu">Tin tức Hội liên hiệp phụ nữ</a></li>
                                <li><a href="/News?category=hoi-cuu-chien-binh">Tin tức Hội cựu chiến binh</a></li>
                                <li><a href="/News?category=cong-doan">Tin tức Công đoàn</a></li>
                            </ul>
                        </li>

                        <!-- 6. Dân chủ pháp luật -->
                        <li>
                            <a asp-controller="Home" asp-action="UnderConstruction">
                                <div class="m26-mnav-icon"><i class="fas fa-balance-scale"></i></div>
                                <span>Dân chủ – pháp luật</span>
                                <i class="fas fa-chevron-right m26-mnav-arrow"></i>
                            </a>
                        </li>

                        <!-- 7. Giám sát phản biện -->
                        <li>
                            <a asp-controller="Home" asp-action="UnderConstruction">
                                <div class="m26-mnav-icon"><i class="far fa-eye"></i></div>
                                <span>Giám sát và phản biện</span>
                                <i class="fas fa-chevron-right m26-mnav-arrow"></i>
                            </a>
                        </li>
                    </ul>
                </nav>

                <div class="m26-drawer-foot">
                    <a class="drawer-cta" asp-controller="GopY" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H7l-3 3V4Z" /></svg>
                        Gửi phản ánh, kiến nghị
                    </a>
                    <a class="m26-drawer-hot" href="tel:@soDienThoai.Replace(".", "").Replace(" ", "")">Đường dây nóng: <b>@soDienThoai</b></a>
                </div>
            </div>
        </div>

        @RenderBody()

        <footer class="m26-foot">
            <div class="wrap">
                <div class="grid">
                    <div>
                        <div class="fb">
                            <img src="~/images/PhuongTanDinh.png" alt="Biểu trưng MTTQ Việt Nam" />
                            <div>
                                <strong>MTTQ Việt Nam</strong>
                                <span>PHƯỜNG TÂN ĐỊNH</span>
                            </div>
                        </div>
                        <p class="fp">Cổng thông tin điện tử @tenCoQuan, TP. Hồ Chí Minh — lắng nghe, phục vụ và kết nối Nhân dân.</p>
                    </div>
                    <div class="col">
                        <h5>Liên kết</h5>
                        <a asp-controller="About" asp-action="Index">Giới thiệu</a>
                        <a asp-controller="VanBanTaiLieu" asp-action="Index">Văn bản - Tài liệu</a>
                        <a asp-controller="CongThongTinAnSXH" asp-action="Index">Tiếp nhận ủng hộ</a>
                    </div>
                    <div class="col">
                        <h5>Liên hệ</h5>
                        <ul class="info">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.4-7-10a7 7 0 0 1 14 0c0 5.6-7 10-7 10Z" /><circle cx="12" cy="11" r="2.5" /></svg>@diaChi</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg><a href="tel:@soDienThoai.Replace(".", "").Replace(" ", "")">@soDienThoai</a></li>
