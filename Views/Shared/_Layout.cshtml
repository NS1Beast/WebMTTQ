@{
    var isHome = ViewContext.RouteData.Values["action"]?.ToString() == "Index"
        && ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - " : "")Ủy ban Mặt trận Tổ quốc Việt Nam - Xã Phú Hòa Đông</title>
    <meta name="description" content="Trang thông tin chính thức của Ủy ban Mặt trận Tổ quốc Việt Nam Xã Phú Hòa Đông – cập nhật tin tức và hoạt động địa phương." />
    <meta name="theme-color" content="#3C0709" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,700&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap&subset=vietnamese" rel="stylesheet" />
    <link rel="icon" href="https://mttq.phuhoadong.vn/apps/uploads/2025/11/cropped-favicon-32x32.png" sizes="32x32" />
    <link rel="stylesheet" href="~/css/mttq.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="mttq2026 @(isHome ? "mttq2026-has-hero" : "")">

<div id="m26-splash" role="status" aria-label="Đang tải">
    <div class="m26-splash-in">
        <div class="m26-splash-badge">
            <img src="https://mttq.phuhoadong.vn/apps/uploads/2025/11/cropped-favicon-270x270.png" alt="" width="82" height="82" />
        </div>
        <span class="m26-splash-txt">Mặt trận Tổ quốc · Phú Hòa Đông</span>
    </div>
</div>

<div class="m26">

    <div class="m26-util">
        <div class="wrap">
            <div class="u-left">
                <span><span class="dot"></span><span id="m26-date">Đang tải…</span></span>
                <a class="hide-sm" href="tel:0349493220">Đường dây nóng: <b>0349 493 220</b></a>
            </div>
            <div class="u-right">
                <a class="hide-sm" href="mailto:mttq.phuhoadong@tphcm.gov.vn">mttq.phuhoadong@tphcm.gov.vn</a>
                <div class="soc">
                    <a href="https://www.facebook.com/dtnxattd" target="_blank" rel="noopener" aria-label="Facebook">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
                    </a>
                    <a href="https://zalo.me/84978279738049304" target="_blank" rel="noopener" aria-label="Zalo"><b style="font-size:.6rem;font-weight:800">Zalo</b></a>
                </div>
            </div>
        </div>
    </div>

    <header class="m26-head" id="m26-head">
        <div class="wrap head-inner">
            <a class="m26-brand" asp-controller="Home" asp-action="Index">
                <img class="logo" src="https://mttq.phuhoadong.vn/apps/uploads/2025/11/cropped-favicon-270x270.png" alt="Biểu trưng MTTQ Việt Nam" />
                <span>
                    <strong>Mặt trận Tổ quốc Việt Nam</strong>
                    <span>Xã Phú Hòa Đông</span>
                </span>
            </a>

            <ul class="m26-nav">
                <li class="nav-item"><a class="nav-link @(isHome ? "" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Giới thiệu</a></li>
                <li class="nav-item">
                    <a href="#" class="nav-link dropdown-toggle">Danh mục Tin tức</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Tin tức</a></li>
                        <li><a class="dropdown-item" href="#">Dân chủ – pháp luật</a></li>
                        <li><a class="dropdown-item" href="#">Giám sát và phản biện</a></li>
                        <li><a class="dropdown-item" href="#">Vận động và phong trào</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link" href="#">Cổng an sinh xã hội</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Văn bản và tài liệu</a></li>
                <li class="nav-item">
                    <a href="#" class="nav-link dropdown-toggle">Ứng dụng Bản Đồ</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Bản đồ sinh hoạt hè</a></li>
                        <li><a class="dropdown-item" href="#">Bản đồ an sinh</a></li>
                        <li><a class="dropdown-item" href="#">Bản đồ bầu cử HĐND Xã 2026</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link dropdown-toggle">Không gian văn hóa Hồ Chí Minh</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Thư viện Bảo tàng 3D</a></li>
                        <li><a class="dropdown-item" href="#">Thư viện ca khúc về Bác</a></li>
                        <li><a class="dropdown-item" href="#">Thư viện Sách</a></li>
                    </ul>
                </li>
            </ul>

            <div class="m26-more" id="m26-more" hidden>
                <button class="m26-more-btn" type="button" aria-label="Xem thêm mục" aria-expanded="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h.01M12 12h.01M19 12h.01"/></svg>
                </button>
                <ul class="m26-more-list" id="m26-more-list"></ul>
            </div>

            <div class="m26-search" id="m26-search">
                <button class="m26-search-btn" id="m26-search-btn" type="button" aria-label="Tìm kiếm" aria-expanded="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </button>
                <form class="m26-search-form" role="search" method="get" asp-controller="Home" asp-action="Index">
                    <input type="search" name="s" id="m26-search-input" placeholder="Tìm tin tức, tài liệu…" aria-label="Từ khoá tìm kiếm" />
                    <button type="submit" class="m26-search-go" aria-label="Tìm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    </button>
                </form>
            </div>

            <a class="cta" href="#">Gửi phản ánh</a>
            <button class="m26-burger" id="m26-burger" type="button" aria-label="Mở menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
        </div>
    </header>

    <div class="m26-drawer" id="m26-drawer">
        <div class="m26-drawer-in">
            <div class="m26-drawer-head">
                <a class="m26-drawer-brand" asp-controller="Home" asp-action="Index">
                    <img src="https://mttq.phuhoadong.vn/apps/uploads/2025/11/cropped-favicon-270x270.png" alt="Biểu trưng MTTQ" />
                    <span><strong>Mặt trận Tổ quốc</strong><small>Xã Phú Hòa Đông</small></span>
                </a>
                <button class="x" type="button" data-close aria-label="Đóng menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <nav class="m26-drawer-nav">
                <ul class="m26-mnav">
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a href="#">Giới thiệu</a></li>
                    <li><a href="#">Cổng an sinh xã hội</a></li>
                    <li><a href="#">Văn bản và tài liệu</a></li>
                    <li><a href="#">Không gian văn hóa Hồ Chí Minh</a></li>
                    <li><a href="#">Tin tức</a></li>
                    <li><a href="#">Dân chủ – pháp luật</a></li>
                </ul>
            </nav>
            <div class="m26-drawer-foot">
                <a class="drawer-cta" href="#">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H7l-3 3V4Z"/></svg>
                    Gửi phản ánh, kiến nghị
                </a>
                <a class="m26-drawer-hot" href="tel:0349493220">Đường dây nóng: <b>0349 493 220</b></a>
            </div>
        </div>
    </div>

    @RenderBody()

    <footer class="m26-foot">
        <div class="wrap">
            <div class="grid">
                <div>
                    <div class="fb">
                        <img src="https://mttq.phuhoadong.vn/apps/uploads/2025/11/cropped-favicon-270x270.png" alt="Biểu trưng MTTQ Việt Nam" />
                        <div>
                            <strong>MTTQ Việt Nam</strong>
                            <span>Xã Phú Hòa Đông</span>
                        </div>
                    </div>
                    <p class="fp">Cổng thông tin điện tử Ủy ban Mặt trận Tổ quốc Việt Nam xã Phú Hòa Đông, TP. Hồ Chí Minh — lắng nghe, phục vụ và kết nối Nhân dân.</p>
                </div>
                <div class="col">
                    <h5>Liên kết</h5>
                    <a href="#">Giới thiệu</a>
                    <a href="#">Văn bản - Tài liệu</a>
                    <a href="#">Không gian VH Hồ Chí Minh</a>
                    <a href="#">Tiếp nhận ủng hộ</a>
                </div>
                <div class="col">
                    <h5>Liên hệ</h5>
                    <ul class="info">
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.4-7-10a7 7 0 0 1 14 0c0 5.6-7 10-7 10Z"/><circle cx="12" cy="11" r="2.5"/></svg>Số 463, Tỉnh lộ 15, ấp 8, xã Phú Hòa Đông, TP.HCM</li>
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg><a href="tel:0349493220">0349 493 220</a></li>
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="m4 6 8 6 8-6"/></svg><a href="mailto:mttq.phuhoadong@tphcm.gov.vn">mttq.phuhoadong@tphcm.gov.vn</a></li>
                    </ul>
                </div>
            </div>
            <div class="bottom">
                <span>© @DateTime.Now.Year Ủy ban MTTQ Việt Nam xã Phú Hòa Đông. Bản quyền thuộc cơ quan chủ quản.</span>
                <span>Cổng thông tin điện tử</span>
            </div>
        </div>
    </footer>
</div>

<nav class="m26-bnav" aria-label="Điều hướng nhanh">
    <a class="m26-bn-item @(isHome ? "is-active" : "")" asp-controller="Home" asp-action="Index" aria-current="@(isHome ? "page" : null)">
        <svg viewBox="0 0 24 24"><path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v10h12V10"/><path d="M10 20v-5h4v5"/></svg>
        <span>Trang chủ</span>
    </a>
    <a class="m26-bn-item" href="#">
        <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.1"/><path d="M3.6 20a5.4 5.4 0 0 1 10.8 0"/><path d="M16 5.6a3 3 0 0 1 0 5.6"/><path d="M17.6 20a5 5 0 0 0-2.7-4.4"/></svg>
        <span>Giới thiệu</span>
    </a>
    <a class="m26-bn-fab" href="#" aria-label="Gửi phản ánh, kiến nghị">
        <svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-10.9 6.7L4.5 19.5l1.3-4.3A7.5 7.5 0 1 1 20 11.5Z"/><path d="M8.5 10.8h7M8.5 13.8h4.5"/></svg>
        <span>Phản ánh</span>
    </a>
    <a class="m26-bn-item" href="#">
        <svg viewBox="0 0 24 24"><path d="M4 5h13v14H4z"/><path d="M17 8h3v9a2 2 0 0 1-2 2h-1"/><path d="M7 8h7M7 12h7M7 16h4"/></svg>
        <span>Tin tức</span>
    </a>
    <button type="button" class="m26-bn-item" id="m26-bnav-menu" aria-label="Mở danh mục">
        <svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.4"/><rect x="13" y="4" width="7" height="7" rx="1.4"/><rect x="4" y="13" width="7" height="7" rx="1.4"/><rect x="13" y="13" width="7" height="7" rx="1.4"/></svg>
        <span>Danh mục</span>
    </button>
</nav>

<button type="button" class="m26-top" id="m26-top" aria-label="Lên đầu trang">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
</button>

<script src="~/js/mttq.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
