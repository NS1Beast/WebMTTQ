<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị</title>
    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                display: flex;
                height: 100vh;
            }
            /* Cột Menu bên trái */
            .sidebar {
                width: 250px;
                background-color: #2c3e50;
                color: white;
                display: flex;
                flex-direction: column;
            }

                .sidebar h2 {
                    text-align: center;
                    padding: 20px 0;
                    margin: 0;
                    background-color: #1a252f;
                }

                .sidebar a {
                    color: white;
                    text-decoration: none;
                    padding: 15px 20px;
                    display: block;
                    border-bottom: 1px solid #34495e;
                }

                    .sidebar a:hover {
                        background-color: #34495e;
                    }
            /* Phần nội dung chính bên phải */
            .main-content {
                flex-grow: 1;
                padding: 20px;
                background-color: #f8f9fa;
                overflow-y: auto;
            }
    </style>
</head>
<body>

    <!-- Menu Trái -->
    <div class="sidebar">
        <h2>Admin Panel</h2>
        <a href="/admin">📊 Dashboard Tổng</a>
        <!-- Đây là nút dẫn vào phần Thông tin ủng hộ bạn vừa làm -->
        <a href="/admin/thongtinungho">💰 Thông tin ủng hộ</a>
        <a href="/admin/danhsachungho">📝 Danh sách ủng hộ</a>
        <a class="nav-link" href="/admin/soduquy">
            <i class="fas fa-wallet"></i>
            <span>Quản lý Số dư Quỹ</span>
        </a>
        <a href="#">⚙️ Cài đặt hệ thống (Ví dụ)</a>
    </div>

    <!-- Nội dung chính -->
    <div class="main-content">
        @RenderBody() <!-- Code của các trang khác sẽ được nhúng vào đây -->
    </div>
    <!-- DÁN DÒNG NÀY VÀO ĐÂY: Cho phép Layout nhận Script từ các trang con (như Create, Edit) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>