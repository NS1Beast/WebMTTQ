<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị MTTQ</title>
    <meta name="theme-color" content="#8b1a2b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,700&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap&subset=vietnamese" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fund-admin.css" asp-append-version="true" />

    <style>
            /* ========================================================
                                   CỤM CSS CHO TOAST NOTIFICATION
                                   ======================================================== */
            .admin-toast-container {
                position: fixed;
                top: 80px;
                right: 20px;
                z-index: 9999;
                display: flex;
                flex-direction: column;
                gap: 15px;
                pointer-events: none;
            }

            .admin-toast {
                min-width: 280px;
                max-width: 400px;
                background: white;
                padding: 16px 20px;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
                display: flex;
                align-items: center;
                gap: 15px;
                transform: translateX(120%);
                animation: toastSlideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
                transition: all 0.5s ease-out;
                pointer-events: auto;
            }

                .admin-toast.fade-out {
                    transform: translateX(120%);
                    opacity: 0;
                }

                .admin-toast.success {
                    border-left: 5px solid #28a745;
                }

                    .admin-toast.success .toast-icon {
                        color: #28a745;
                        font-size: 1.5rem;
                    }

                .admin-toast.error {
                    border-left: 5px solid #dc3545;
                }

                    .admin-toast.error .toast-icon {
                        color: #dc3545;
                        font-size: 1.5rem;
                    }

            .toast-content {
                flex: 1;
            }

            .toast-title {
                font-weight: 700;
                font-size: 0.95rem;
                color: #333;
                margin-bottom: 2px;
            }

            .toast-message {
                font-size: 0.85rem;
                color: #666;
                line-height: 1.4;
            }

            @@keyframes toastSlideIn {
                from {
                    transform: translateX(120%);
                }

                to {
                    transform: translateX(0);
                }
            }

            /* ========================================================
                                   CỤM CSS CHO ACCORDION MENU SIDEBAR (MENU THẢ XUỐNG)
                                   ======================================================== */
            .nav-group {
                margin-bottom: 5px;
            }

            .nav-group-toggle {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 20px 12px 15px;
                color: rgba(255,255,255,0.5);
                font-weight: 600;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                cursor: pointer;
                transition: all 0.3s;
                user-select: none;
            }

                .nav-group-toggle:hover {
                    color: #fff;
                    background: rgba(255,255,255,0.05);
                }

                .nav-group-toggle .caret {
                    transition: transform 0.3s ease;
                    font-size: 0.8rem;
                }

            /* Khi menu mở */
            .nav-group.is-open .nav-group-toggle {
                color: var(--admin-gold, #e8b84b);
            }

                .nav-group.is-open .nav-group-toggle .caret {
                    transform: rotate(180deg);
                }

            /* Menu con */
            .nav-submenu {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
                background: rgba(0,0,0,0.15); /* Làm nền menu con tối hơn một chút */
            }

            .nav-group.is-open .nav-submenu {
                max-height: 1000px; /* Số lớn để hiệu ứng trượt hoạt động mượt */
            }

            /* Thụt lề cho các item bên trong menu con */
            .nav-submenu a {
                padding-left: 45px !important; /* Thụt vào sâu hơn */
                font-size: 0.9rem;
            }

                .nav-submenu a i {
                    font-size: 0.9rem;
                    width: 20px;
                }
    </style>
</head>
<body class="admin-body">
    <div class="admin-layout">

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-brand">
                <h2>MTTQ Quản trị</h2>
                <small>Phường Tân Định</small>
            </div>
            <nav class="admin-sidebar-nav">
                @{
                    var session = Context.Session;
                    var isAdmin = WebMTTQ.Services.PhanQuyenHelper.IsAdmin(session);
                    var coQuyen = (string module) => isAdmin || WebMTTQ.Services.PhanQuyenHelper.CoQuyenXem(session, module);

                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

                    // Logic kiểm tra Active cho từng Group. Đã thêm "AdminDoanTheToChuc" vào group Quản lý nội dung
                    bool isNoiDungActive = currentController == "AdminNews" || currentController == "AdminVanBanTaiLieu" || currentController == "AdminTrangChu" || currentController == "AdminBanner" || currentController == "AdminTimeline" || currentController == "AdminDoanTheToChuc";
                    bool isNguoiNgheoActive = currentController == "AdminThongTin" || currentController == "AdminDanhSachUngHo" || currentController == "AdminSoDuQuy" || currentController == "AdminKetQuaChamLo" || currentController == "AdminDiaDiemBanDo";
                    bool isBienDaoActive = currentController == "AdminQuyBienDao";
                    bool isCuuTroActive = currentController == "AdminQuyCuuTro";
                    bool isTuongTacActive = currentController == "AdminNguoiDanCanTroGiup" || currentController == "AdminGopY";
                }

                <a href="/admin" class="@(currentAction == "Index" && currentController == "Admin" ? "is-active" : "")">
                    <i class="fas fa-chart-pie"></i>
                    <span>Dashboard</span>
                </a>

                <div class="nav-sep"></div>

                <!-- GROUP 1: QUẢN LÝ NỘI DUNG -->
                <div class="nav-group @(isNoiDungActive ? "is-open" : "")">
                    <div class="nav-group-toggle">
                        <span>Quản lý nội dung</span>
                        <i class="fas fa-chevron-down caret"></i>
                    </div>
                    <div class="nav-submenu">
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.TinTuc))
                        {
                            <a href="/AdminNews/Index" class="@(currentController == "AdminNews" ? "is-active" : "")">
                                <i class="fas fa-newspaper"></i>
                                <span>Quản lý Tin tức</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.TrangChu))
                        {
                            <a href="/AdminTrangChu/Index" class="@(currentController == "AdminTrangChu" || currentController == "AdminBanner" || currentController == "AdminTimeline" ? "is-active" : "")">
                                <i class="fas fa-home"></i>
                                <span>Cài đặt Trang chủ</span>
                            </a>

                            <!-- THÊM MỚI: QUẢN LÝ SƠ ĐỒ ĐOÀN THỂ TỔ CHỨC -->
                            <a href="/admin/doanthe" class="@(currentController == "AdminDoanTheToChuc" ? "is-active" : "")">
                                <i class="fas fa-sitemap"></i>
                                <span>Đoàn thể tổ chức</span>
                            </a>
                            <!-- THÊM MỚI: QUẢN LÝ Giới thiệu chung -->
                            <a href="/admin/gioithieu" class="@(currentController == "AdminGioiThieu" ? "is-active" : "")">
                                <i class="fas fa-info-circle"></i>
                                <span>Giới thiệu chung</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.VanBanTaiLieu))
                        {
                            <a href="/AdminVanBanTaiLieu/Index" class="@(currentController == "AdminVanBanTaiLieu" ? "is-active" : "")">
                                <i class="fas fa-file-signature"></i>
                                <span>Văn bản & Tài liệu</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="nav-sep"></div>

                <!-- GROUP 2: QUỸ VÌ NGƯỜI NGHÈO -->
                <div class="nav-group @(isNguoiNgheoActive ? "is-open" : "")">
                    <div class="nav-group-toggle">
                        <span>Quỹ vì người nghèo</span>
                        <i class="fas fa-chevron-down caret"></i>
                    </div>
                    <div class="nav-submenu">
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.ThongTinUngHo))
                        {
                            <a href="/admin/thongtinungho" class="@(currentController == "AdminThongTin" ? "is-active" : "")">
                                <i class="fas fa-university"></i>
                                <span>Thông tin ủng hộ</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.DanhSachUngHo))
                        {
                            <a href="/admin/danhsachungho" class="@(currentController == "AdminDanhSachUngHo" ? "is-active" : "")">
                                <i class="fas fa-hand-holding-usd"></i>
                                <span>Danh sách ủng hộ</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.SoDuQuy))
                        {
                            <a href="/admin/soduquy" class="@(currentController == "AdminSoDuQuy" ? "is-active" : "")">
                                <i class="fas fa-wallet"></i>
                                <span>Số dư Quỹ</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.KetQuaChamLo))
                        {
                            <a href="/admin/ketquachamlo" class="@(currentController == "AdminKetQuaChamLo" ? "is-active" : "")">
                                <i class="fas fa-hand-holding-heart"></i>
                                <span>Kết quả chăm lo</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.DiaDiemBanDo))
                        {
                            <a href="/AdminDiaDiemBanDo/Index" class="@(currentController == "AdminDiaDiemBanDo" ? "is-active" : "")">
                                <i class="fas fa-map-marked-alt"></i>
                                <span>Bản đồ an sinh</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- GROUP 3: QUỸ VÌ BIỂN ĐẢO -->
                @if (coQuyen(WebMTTQ.Models.ModuleQuyen.ThongTinUngHo))
                {
                    <div class="nav-group @(isBienDaoActive ? "is-open" : "")">
                        <div class="nav-group-toggle">
                            <span>Quỹ Vì Biển Đảo</span>
                            <i class="fas fa-chevron-down caret"></i>
                        </div>
                        <div class="nav-submenu">
                            <a href="/AdminQuyBienDao/ThongTin" class="@(currentController == "AdminQuyBienDao" && currentAction == "ThongTin" ? "is-active" : "")">
                                <i class="fas fa-university"></i>
                                <span>Thông tin ủng hộ BĐ</span>
                            </a>
                            <a href="/AdminQuyBienDao/DanhSach" class="@(currentController == "AdminQuyBienDao" && currentAction == "DanhSach" ? "is-active" : "")">
                                <i class="fas fa-hand-holding-usd"></i>
                                <span>Danh sách ủng hộ BĐ</span>
                            </a>
                            <a href="/AdminQuyBienDao/SoDu" class="@(currentController == "AdminQuyBienDao" && currentAction == "SoDu" ? "is-active" : "")">
                                <i class="fas fa-wallet"></i>
                                <span>Số dư Quỹ Biển Đảo</span>
                            </a>
                            <a href="/AdminQuyBienDao/KetQua" class="@(currentController == "AdminQuyBienDao" && currentAction == "KetQua" ? "is-active" : "")">
                                <i class="fas fa-ship"></i>
                                <span>Hoạt động Biển Đảo</span>
                            </a>
                        </div>
                    </div>

                    <!-- GROUP 4: QUỸ CỨU TRỢ -->
                    <div class="nav-group @(isCuuTroActive ? "is-open" : "")">
                        <div class="nav-group-toggle">
                            <span>Quỹ Cứu Trợ</span>
                            <i class="fas fa-chevron-down caret"></i>
                        </div>
                        <div class="nav-submenu">
                            <a href="/AdminQuyCuuTro/ThongTin" class="@(currentController == "AdminQuyCuuTro" && currentAction == "ThongTin" ? "is-active" : "")">
                                <i class="fas fa-hospital"></i>
                                <span>Thông tin tiếp nhận CT</span>
                            </a>
                            <a href="/AdminQuyCuuTro/DanhSach" class="@(currentController == "AdminQuyCuuTro" && currentAction == "DanhSach" ? "is-active" : "")">
                                <i class="fas fa-hands-helping"></i>
                                <span>Danh sách ủng hộ CT</span>
                            </a>
                            <a href="/AdminQuyCuuTro/SoDu" class="@(currentController == "AdminQuyCuuTro" && currentAction == "SoDu" ? "is-active" : "")">
                                <i class="fas fa-piggy-bank"></i>
                                <span>Số dư Quỹ Cứu trợ</span>
                            </a>
                            <a href="/AdminQuyCuuTro/KetQua" class="@(currentController == "AdminQuyCuuTro" && currentAction == "KetQua" ? "is-active" : "")">
                                <i class="fas fa-truck-loading"></i>
                                <span>Hoạt động Cứu trợ</span>
                            </a>
                        </div>
                    </div>
                }

                <div class="nav-sep"></div>

                <!-- GROUP 5: TƯƠNG TÁC -->
                <div class="nav-group @(isTuongTacActive ? "is-open" : "")">
                    <div class="nav-group-toggle">
                        <span>Tương tác</span>
                        <i class="fas fa-chevron-down caret"></i>
                    </div>
                    <div class="nav-submenu">
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.NguoiDanCanTroGiup))
                        {
                            <a href="/AdminNguoiDanCanTroGiup/Index" class="@(currentController == "AdminNguoiDanCanTroGiup" ? "is-active" : "")">
                                <i class="fas fa-life-ring"></i>
                                <span>Yêu cầu trợ giúp</span>
                            </a>
                        }
                        @if (coQuyen(WebMTTQ.Models.ModuleQuyen.GopY))
                        {
                            <a href="/AdminGopY/Index" class="@(currentController == "AdminGopY" ? "is-active" : "")">
                                <i class="fas fa-envelope-open-text"></i>
                                <span>Hộp thư góp ý</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="nav-sep"></div>

                <!-- CÁC CHỨC NĂNG LẺ CÒN LẠI -->
                @if (coQuyen(WebMTTQ.Models.ModuleQuyen.CauHinh))
                {
                    <a href="/AdminCauHinh/Index" class="@(currentController == "AdminCauHinh" ? "is-active" : "")">
                        <i class="fas fa-cog"></i>
                        <span>Cài đặt hệ thống</span>
                    </a>
                }

                @if (coQuyen(WebMTTQ.Models.ModuleQuyen.QuanLyNguoiDung))
                {
                    <a href="/AdminNguoiDung/Index" class="@(currentController == "AdminNguoiDung" ? "is-active" : "")">
                        <i class="fas fa-users"></i>
                        <span>Quản lý người dùng</span>
                    </a>
                }

                <div class="nav-sep"></div>
                <a href="/TaiKhoan/ThongTin">
                    <i class="fas fa-user-circle"></i>
                    <span>Tài khoản của tôi</span>
                </a>

                <a href="/" style="margin-top: auto; border-top: 1px solid rgba(255,255,255,0.06);">
                    <i class="fas fa-arrow-left"></i>
                    <span>Về trang chủ</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <header class="admin-topbar">
                <div class="admin-topbar-title">
                    <button class="admin-toggle-sidebar" id="adminToggleSidebar" type="button" aria-label="Toggle menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <i class="fas fa-shield-alt"></i>
                    <span>@ViewData["Title"]</span>
                </div>
                <div class="admin-topbar-right">
                    <span style="display:flex;align-items:center;gap:8px;">
                        <i class="fas fa-user-circle" style="font-size:1.1rem;color:var(--admin-gold-dark);"></i>
                        <span>@(Context.Session.GetString("AdminHoTen") ?? "Admin")</span>
                    </span>
                    <a href="/Auth/Logout" style="color:var(--admin-muted);" title="Đăng xuất">
                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                    </a>
                    <span style="width:1px;height:20px;background:var(--admin-line);"></span>
                    <a href="/"><i class="fas fa-external-link-alt"></i> Xem trang chủ</a>
                </div>
            </header>

            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- KHU VỰC RENDER TOAST THÔNG BÁO -->
    <div class="admin-toast-container" id="adminToastContainer">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-toast success">
                <div class="toast-icon"><i class="fas fa-check-circle"></i></div>
                <div class="toast-content">
                    <div class="toast-title">Thành công</div>
                    <div class="toast-message">@TempData["SuccessMessage"]</div>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-toast error">
                <div class="toast-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="toast-content">
                    <div class="toast-title">Có lỗi xảy ra</div>
                    <div class="toast-message">@TempData["ErrorMessage"]</div>
                </div>
            </div>
        }
    </div>

    <script>
            // Toggle sidebar trên mobile
            document.getElementById('adminToggleSidebar').addEventListener('click', function() {
                document.getElementById('adminSidebar').classList.toggle('is-open');
            });

            // Đóng sidebar khi click ra ngoài (mobile)
            document.addEventListener('click', function(e) {
                var sidebar = document.getElementById('adminSidebar');
                var toggle = document.getElementById('adminToggleSidebar');
                if (window.innerWidth <= 900) {
                    if (!sidebar.contains(e.target) && !toggle.contains(e.target)) {
                        sidebar.classList.remove('is-open');
                    }
                }
            });

            // HỆ THỐNG XỬ LÝ TOAST NOTIFICATION TỰ ĐỘNG ẨN
            document.addEventListener("DOMContentLoaded", function() {
                var toasts = document.querySelectorAll('.admin-toast');
                toasts.forEach(function(toast) {
                    setTimeout(function() {
                        toast.classList.add('fade-out');
                        setTimeout(function() {
                            toast.remove();
                        }, 500);
                    }, 3000);
                });
            });

            // ========================================================
            // JAVASCRIPT CHO MENU THẢ XUỐNG (ACCORDION)
            // ========================================================
            document.addEventListener("DOMContentLoaded", function() {
                var toggles = document.querySelectorAll('.nav-group-toggle');

                toggles.forEach(function(toggle) {
                    toggle.addEventListener('click', function() {
                        var parentGroup = this.parentElement;

                        // Đóng tất cả các menu khác (Nếu bạn muốn khi mở menu này thì menu kia đóng lại)
                        // Bỏ comment đoạn dưới nếu muốn tính năng đó:
                        /*
                        document.querySelectorAll('.nav-group').forEach(function(group) {
                            if (group !== parentGroup) {
                                group.classList.remove('is-open');
                            }
                        });
                        */

                        // Bật/tắt menu hiện tại
                        parentGroup.classList.toggle('is-open');
                    });
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>