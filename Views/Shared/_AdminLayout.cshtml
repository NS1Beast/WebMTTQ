<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị</title>
    <!-- Nhúng FontAwesome cho icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                display: flex;
                height: 100vh;
            }
            /* Cột Menu bên trái */
            .sidebar {
                width: 250px;
                background-color: #2c3e50;
                color: white;
                display: flex;
                flex-direction: column;
            }

                .sidebar h2 {
                    text-align: center;
                    padding: 20px 0;
                    margin: 0;
                    background-color: #1a252f;
                }

                .sidebar a {
                    color: white;
                    text-decoration: none;
                    padding: 15px 20px;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    border-bottom: 1px solid #34495e;
                    transition: 0.2s;
                }

                    .sidebar a:hover {
                        background-color: #34495e;
                    }

                    /* Tùy chỉnh icon trong menu */
                    .sidebar a i {
                        width: 20px;
                        text-align: center;
                    }

            /* Phần nội dung chính bên phải */
            .main-content {
                flex-grow: 1;
                padding: 20px;
                background-color: #f8f9fa;
                overflow-y: auto;
            }
    </style>
</head>
<body>

    <!-- Menu Trái -->
    <div class="sidebar">
        <h2>Admin Panel</h2>

        <a href="/admin">
            <span>📊 Dashboard Tổng</span>
        </a>

        <a href="/admin/thongtinungho">
            <span>💰 Thông tin ủng hộ</span>
        </a>

        <a href="/admin/danhsachungho">
            <span>📝 Danh sách ủng hộ</span>
        </a>

        <a class="nav-link" href="/admin/soduquy">
            <i class="fas fa-wallet"></i>
            <span>Quản lý Số dư Quỹ</span>
        </a>

        <a class="nav-link" href="/admin/ketquachamlo">
            <i class="fas fa-hand-holding-heart"></i>
            <span>Kết quả chăm lo</span>
        </a>

        <a class="nav-link" href="/AdminDiaDiemBanDo/Index">
            <i class="fas fa-map-marked-alt"></i>
            <span>Quản lý Bản đồ An sinh</span>
        </a>

        <a class="nav-link" href="/AdminNguoiDanCanTroGiup/Index">
            <i class="fas fa-life-ring"></i>
            <span>Yêu cầu trợ giúp</span>
        </a>

        <!-- NÚT MỚI THÊM: Hộp thư góp ý -->
        <a class="nav-link" href="/AdminGopY/Index">
            <i class="fas fa-envelope-open-text"></i>
            <span>Hộp thư góp ý</span>
        </a>

        <a href="#">
            <span>⚙️ Cài đặt hệ thống</span>
        </a>
    </div>

    <!-- Nội dung chính -->
    <div class="main-content">
        @RenderBody() <!-- Code của các trang Index, Create, Edit sẽ được nhúng vào đây -->
    </div>

    <!-- Cho phép Layout nhận Script từ các trang con -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>