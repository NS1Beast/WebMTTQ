<div class="m26-marquee" aria-hidden="true">
    <div class="track">
        @for (var i = 0; i < 2; i++)
        {
            <span>ĐOÀN KẾT <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> DÂN CHỦ <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> ĐỔI MỚI <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> SÁNG TẠO <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> PHÁT TRIỂN <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> </span>
        }
    </div>
</div>

<!-- ================= BANNER SLIDER ================= -->
@if (Model.Banners != null && Model.Banners.Any())
{
    var firstBanner = Model.Banners.First();
    var hieuUng = firstBanner?.HieuUng ?? "slide";
    var tocDo = firstBanner?.TocDo > 0 ? firstBanner.TocDo : 600;
    var thoiGianDung = firstBanner?.ThoiGianDung > 0 ? firstBanner.ThoiGianDung : 5000;
    var mauNen = firstBanner?.MauNen ?? "#1a1a2e";
    <div class="banner-wrapper" id="homeBanner" style="background:@mauNen;">
        <div class="banner-track @(hieuUng != "slide" ? hieuUng : "")" id="bannerTrack">
            @foreach (var item in Model.Banners)
            {
                <div class="banner-slide @(hieuUng == "zoom" ? "zoom" : "")" data-effect="@(item.HieuUng ?? hieuUng)">
                    @if (!string.IsNullOrEmpty(item.LienKet))
                    {
                        <a href="@item.LienKet" style="display:block;height:100%;"><img src="@item.HinhAnh" alt="@item.TieuDe" loading="lazy" /></a>
                    }
                    else
                    {
                        <img src="@item.HinhAnh" alt="@item.TieuDe" loading="lazy" />
                    }
                    @if (!string.IsNullOrEmpty(item.TieuDe) || !string.IsNullOrEmpty(item.MoTa))
                    {
                        <div class="banner-overlay">
                            @if (!string.IsNullOrEmpty(item.TieuDe)) { <h3>@item.TieuDe</h3> }
                            @if (!string.IsNullOrEmpty(item.MoTa)) { <p>@item.MoTa</p> }
                        </div>
                    }
                </div>
            }
        </div>
        <button class="banner-btn banner-prev" onclick="moveBanner(-1)" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button class="banner-btn banner-next" onclick="moveBanner(1)" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><path d="M9 18l6-6-6-6"/></svg></button>
        <div class="banner-dots">
            @for (int i = 0; i < Model.Banners.Count; i++)
            {
                <span class="dot @(i == 0 ? "active" : "")" onclick="setBanner(@i)"></span>
            }
        </div>
        <div class="banner-progress" id="bannerProgress"></div>
    </div>
}

<!-- ================= HOMEPAGE SECTIONS (từ DB) ================= -->
@if (Model.Sections != null && Model.Sections.Any())
{
    foreach (var sec in Model.Sections)
    {
        <div class="home-section" id="section-@sec.Id">
            <div class="wrap">
                <div class="section-header">
                    <h2>@sec.TieuDe</h2>
                    @if (!string.IsNullOrEmpty(sec.NoiDung))
                    {
                        <p>@sec.NoiDung</p>
                    }
                </div>
                @switch (sec.Loai)
                {
                    case "tin-tuc":
                        var sectionNewsItems = Model.SectionNews != null && Model.SectionNews.ContainsKey(sec.Id)
                            ? Model.SectionNews[sec.Id]
                            : new List<TrangChuTinTuc>();
                        @if (sectionNewsItems.Any())
                        {
                            <div class="news-grid">
                                @foreach (var news in sectionNewsItems)
                                {
                                    <a href="@(!string.IsNullOrEmpty(news.LienKet) ? news.LienKet : "#")" class="news-card">
                                        <div class="news-card-img-wrap">
                                        <img src="@news.HinhAnh" alt="@news.TieuDe" class="news-card-img" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22250%22 viewBox=%220 0 400 250%22%3E%3Crect fill=%22%238b1a2b%22 width=%22400%22 height=%22250%22/%3E%3Ctext fill=%22%23fff%22 font-family=%22Arial%22 font-size=%2216%22 text-anchor=%22middle%22 x=%22200%22 y=%22130%22%3EMTTQ%3C/text%3E%3C/svg%3E'" />
                                        </div>
                                        <div class="news-card-body">
                                            <span class="news-card-category">@sec.TieuDe</span>
                                            <h3 class="news-card-title">@news.TieuDe</h3>
                                            @if (!string.IsNullOrEmpty(news.TomTat))
                                            {
                                                <p class="news-card-summary">@news.TomTat</p>
                                            }
                                            <div class="news-card-date"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> @news.NgayTao.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-inbox" style="font-size:2rem;opacity:0.3;"></i>
                                <p>Chưa có tin tức nào trong mục này.</p>
                            </div>
                        }
                        break;
                    case "hinh-anh":
                        @if (!string.IsNullOrEmpty(sec.HinhAnh))
                        {
                            <div style="display:flex;justify-content:center;">
                                <img src="@sec.HinhAnh" alt="@sec.TieuDe" style="max-width:100%;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.1);" onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22800%22 height=%22400%22 viewBox=%220 0 800 400%22%3E%3Crect fill=%22%23e8b84b%22 width=%22800%22 height=%22400%22/%3E%3Ctext fill=%22%23333%22 font-family=%22Arial%22 font-size=%2224%22 text-anchor=%22middle%22 x=%22400%22 y=%22215%22%3EMTTQ%3C/text%3E%3C/svg%3E';" />
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-image" style="font-size:2rem;opacity:0.3;"></i>
                                <p>Chưa có hình ảnh cho mục này.</p>
                            </div>
                        }
                        break;
                    case "thong-tin":
                    case "van-ban":
                    case "lien-ket":
                    case "video":
                    default:
                        <div style="display:flex;justify-content:center;">
                            <div style="background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.06);max-width:800px;width:100%;border:1px solid rgba(0,0,0,0.04);">
                                <div style="text-align:center;margin-bottom:15px;">
                                    <div style="width:64px;height:64px;border-radius:50%;background:rgba(139,26,43,0.1);color:#8b1a2b;display:inline-flex;align-items:center;justify-content:center;font-size:1.5rem;">
                                        <i class="fas fa-info-circle"></i>
                                    </div>
                                </div>
                                <div style="color:#666;font-size:0.95rem;line-height:1.6;text-align:center;">
                                    @if (!string.IsNullOrEmpty(sec.NoiDung))
                                    {
                                        @Html.Raw(sec.NoiDung)
                                    }
                                    else
                                    {
                                        <p>Nội dung đang được cập nhật...</p>
                                    }
                                </div>
                            </div>
                        </div>
                        break;
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        let currentBannerIndex = 0;
        const bannerTrack = document.getElementById('bannerTrack');
        const slides = document.querySelectorAll('.banner-slide');
        const dots = document.querySelectorAll('.dot');
        const progressBar = document.getElementById('bannerProgress');
        const totalBanners = slides.length;
        let slideInterval, progressInterval;
        let isTransitioning = false;
        const firstSlide = slides[0];
        const defaultEffect = firstSlide?.dataset?.effect || 'slide';
        const defaultSpeed = @(Model.Banners?.FirstOrDefault()?.TocDo ?? 600);
        const defaultDelay = @(Model.Banners?.FirstOrDefault()?.ThoiGianDung ?? 5000);

        function getSlideEffect(index) { return slides[index]?.dataset?.effect || defaultEffect; }

        function updateBannerUI() {
            isTransitioning = true;
            const effect = getSlideEffect(currentBannerIndex);
            slides.forEach(s => s.classList.remove('active'));
            if (effect === 'fade') {
                slides.forEach((slide, i) => {
                    slide.style.opacity = i === currentBannerIndex ? '1' : '0';
                    slide.style.position = i === currentBannerIndex ? 'relative' : 'absolute';
                });
                slides[currentBannerIndex].classList.add('active');
            } else {
                bannerTrack.style.transition = 'transform ' + defaultSpeed + 'ms cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                bannerTrack.style.transform = 'translateX(-' + (currentBannerIndex * 100) + '%)';
                slides[currentBannerIndex].classList.add('active');
            }
            dots.forEach(d => d.classList.remove('active'));
            if (dots.length > 0) dots[currentBannerIndex].classList.add('active');
            if (progressBar) {
                progressBar.style.width = '0%';
                clearInterval(progressInterval);
                startProgress();
            }
            setTimeout(function() { isTransitioning = false; }, defaultSpeed);
        }

        function startProgress() {
            if (!progressBar) return;
            var width = 0;
            var step = 100 / (defaultDelay / 50);
            progressInterval = setInterval(function() {
                width += step;
                if (width >= 100) width = 0;
                progressBar.style.width = Math.min(width, 100) + '%';
            }, 50);
        }

        function moveBanner(step) {
            if (isTransitioning) return;
            currentBannerIndex += step;
            if (currentBannerIndex < 0) currentBannerIndex = totalBanners - 1;
            else if (currentBannerIndex >= totalBanners) currentBannerIndex = 0;
            updateBannerUI();
        }

        function setBanner(index) {
            if (isTransitioning || index === currentBannerIndex) return;
            currentBannerIndex = index;
            updateBannerUI();
        }

        function startAutoPlay() {
            if (slideInterval) clearInterval(slideInterval);
            slideInterval = setInterval(function() { moveBanner(1); }, defaultDelay);
        }

        if (totalBanners > 0) {
            var effect = getSlideEffect(0);
            if (effect === 'fade') {
                bannerTrack.style.transform = 'none';
                slides.forEach(function(slide, i) {
                    slide.style.opacity = i === 0 ? '1' : '0';
                    slide.style.position = i === 0 ? 'relative' : 'absolute';
                    slide.style.width = '100%'; slide.style.height = '100%';
                    slide.style.top = '0'; slide.style.left = '0';
                });
                slides[0].classList.add('active');
            }
            startAutoPlay(); startProgress();
            var wrapper = document.getElementById('homeBanner');
            wrapper.addEventListener('mouseenter', function() { clearInterval(slideInterval); clearInterval(progressInterval); });
            wrapper.addEventListener('mouseleave', function() { startAutoPlay(); startProgress(); });
            var touchStartX = 0;
            wrapper.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
            wrapper.addEventListener('touchend', function(e) {
                var diff = touchStartX - e.changedTouches[0].screenX;
                if (Math.abs(diff) > 50) { if (diff > 0) moveBanner(1); else moveBanner(-1); }
            }, { passive: true });
        }
    </script>
}