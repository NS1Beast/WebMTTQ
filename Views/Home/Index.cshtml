@model WebMTTQ.Models.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    /* ================= BANNER SLIDER ================= */
    .banner-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: var(--m26-ink, #1a1a2e);
        /* Thêm !important để ghi đè inline style chiều cao bị giới hạn trong HTML */
        height: auto !important;
        /* --- ĐOẠN CODE THÊM MỚI ĐỂ THU GỌN VÀ CĂN GIỮA BANNER --- */
        max-width: auto; /* Bạn có thể thay đổi số này (VD: 900px, 1140px, 1200px) */
        margin-left: auto; /* Căn giữa */
        margin-right: auto; /* Căn giữa */
        /* Gợi ý thêm: Bạn có thể bỏ comment dòng dưới nếu muốn bo góc banner cho đẹp */
         border-radius: 12px; 
    }

    .banner-track {
        display: flex;
        width: 100%;
        will-change: transform;
        /* Ghi đè inline style height:100% */
        height: auto !important;
        align-items: flex-start;
    }

    .banner-slide {
        min-width: 100%;
        box-sizing: border-box;
        /* Ghi đè inline style height:100% */
        height: auto !important;
    }
        /* Xử lý thẻ a bọc ngoài ảnh để không giới hạn chiều cao */
        .banner-slide a {
            display: block !important;
            height: auto !important;
        }

        .banner-slide img {
            width: 100%;
            /* Để chiều cao tự động theo tỷ lệ gốc của ảnh */
            height: auto !important;
            display: block;
            /* Chuyển thành contain để đảm bảo thấy trọn vẹn ảnh, không bị cắt xén */
            object-fit: contain;
            object-position: center;
            transition: transform 8s ease-out;
            max-height: none !important;
        }
    /* XỬ LÝ RIÊNG CHO MÁY TÍNH (Màn hình rộng từ 992px trở lên) */
    @@media (min-width: 992px) {
        .banner-slide img {
            /* Loại bỏ mọi giới hạn chiều cao */
            max-height: none;
            object-fit: contain;
            /* Căn ảnh ở giữa, loại bỏ center 100% gây lỗi mất đầu */
            object-position: center;
        }
    }

    .banner-slide.zoom img {
        transform: scale(1.15);
    }

    .banner-slide.zoom.active img {
        transform: scale(1);
    }

    .banner-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 40px 30px 30px;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
        color: white;
        z-index: 2;
    }

        .banner-overlay h3 {
            margin: 0 0 6px;
            font-size: clamp(1.1rem, 2.5vw, 1.6rem);
            font-weight: 700;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }

        .banner-overlay p {
            margin: 0;
            font-size: clamp(0.85rem, 1.5vw, 1rem);
            opacity: 0.9;
            text-shadow: 0 1px 4px rgba(0,0,0,0.5);
            max-width: 600px;
        }

    .banner-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: white;
        border: 1px solid rgba(255,255,255,0.2);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        opacity: 0;
    }

    .banner-wrapper:hover .banner-btn {
        opacity: 1;
    }

    .banner-btn:hover {
        background: var(--m26-gold, #e8b84b);
        border-color: var(--m26-gold, #e8b84b);
        transform: translateY(-50%) scale(1.1);
        box-shadow: 0 4px 20px rgba(232,184,75,0.4);
    }

    .banner-prev {
        left: 20px;
    }

    .banner-next {
        right: 20px;
    }

    .banner-dots {
        position: absolute;
        bottom: 15px;
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 10px;
        z-index: 10;
    }

    .dot {
        width: 12px;
        height: 12px;
        background: rgba(255,255,255,0.4);
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.4s ease;
        border: 2px solid transparent;
    }

        .dot.active {
            background: var(--m26-gold, #e8b84b);
            border-color: rgba(255,255,255,0.6);
            box-shadow: 0 0 12px rgba(232,184,75,0.5);
            transform: scale(1.2);
        }

        .dot:hover {
            background: rgba(255,255,255,0.7);
        }

    .banner-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: var(--m26-gold, #e8b84b);
        z-index: 10;
        transition: width 0.1s linear;
        width: 0%;
    }

    /* ================= HOMEPAGE SECTIONS ================= */
    .home-section { padding: 60px 0; position: relative; overflow: hidden; }
    .home-section:nth-child(even) { background: #f8f6f4; }
    .home-section:nth-child(odd) { background: #fff; }
    .section-header {
        text-align: center;
        margin-bottom: 40px;
    }
    .section-header h2 {
        font-family: var(--font-display, "Playfair Display", Georgia, serif);
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        font-weight: 800;
        color: var(--m26-red, #8b1a2b);
        margin: 0 0 10px;
        position: relative;
        display: inline-block;
    }
    .section-header h2::after {
        content: '';
        display: block;
        width: 60px;
        height: 3px;
        background: var(--m26-gold, #e8b84b);
        margin: 12px auto 0;
        border-radius: 2px;
    }
    .section-header p { color: #777; font-size: 1rem; max-width: 600px; margin: 0 auto; line-height: 1.6; }

    /* ================= NEWS CARD ================= */
    .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
    .news-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.4s ease;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .news-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.12); }
    .news-card-img { width: 100%; height: 200px; object-fit: cover; transition: transform 0.6s ease; display: block; }
    .news-card:hover .news-card-img { transform: scale(1.05); }
    .news-card-img-wrap { overflow: hidden; }
    .news-card-body { padding: 20px; }
    .news-card-category {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: var(--m26-red, #8b1a2b);
        color: #fff;
        margin-bottom: 10px;
    }
    .news-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #222;
        line-height: 1.4;
        margin: 0 0 10px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .news-card-summary {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.4;
        margin: 5px 0;
    }
    .news-card-date { font-size: 0.8rem; color: #999; display: flex; align-items: center; gap: 6px; }
    .empty-state {
        width: 100%;
        text-align: center;
        padding: 40px;
        color: #999;
    }

    @@media (max-width: 768px) {
        .home-section { padding: 40px 0; }
        .news-grid { grid-template-columns: 1fr; }
        .banner-overlay { padding: 20px 15px 15px; }
        .banner-overlay h3 { font-size: 1rem; }
        .banner-overlay p { font-size: 0.8rem; }
        .banner-btn { width: 36px; height: 36px; font-size: 16px; }
        .banner-prev { left: 10px; }
        .banner-next { right: 10px; }
    }

    .banner-track.fade { transition: none; }
    .banner-track.fade .banner-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transition: opacity 0.6s ease;
        pointer-events: none;
    }
    .banner-track.fade .banner-slide.active {
        opacity: 1;
        pointer-events: auto;
        position: relative;
    }
</style>

