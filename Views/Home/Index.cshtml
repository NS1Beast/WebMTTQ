@model WebMTTQ.Models.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="m26-hero" id="m26-hero">
    <div class="rays"></div>
    <div class="grain"></div>
    <div class="spot" id="m26-spot"></div>
    <div class="hero-dang" aria-hidden="true">
        <svg class="ring" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" fill="none" stroke="#F2C14E" stroke-width="1" opacity=".45" /><circle cx="50" cy="50" r="43.5" fill="none" stroke="#F8DA86" stroke-width="2.2" stroke-dasharray="1 7" opacity=".65" /></svg>
        <img class="logo" src="https://mttq.phuhoadong.vn/apps/themes/mttq-2026/assets/images/logo-dang.png" alt="Đảng Cộng sản Việt Nam" />
    </div>
    <div class="wrap hero-grid">
        <div class="copy">
            <span class="eyebrow on-dark">Mặt trận Tổ quốc Việt Nam</span>
            <h1 class="hl">
                <span class="line"><span>Vì Nhân dân</span></span>
                <span class="line">
                    <span class="m26-rotor">
                        <span class="track">
                            <b>đoàn kết</b><b>phục vụ</b><b>đồng thuận</b><b>nghĩa tình</b><b>đoàn kết</b>
                        </span>
                    </span>
                </span>
            </h1>
            <p class="lead">Cổng thông tin Ủy ban MTTQ Việt Nam Phường Tân Định — lắng nghe ý kiến Nhân dân, công khai hoạt động và kết nối các phong trào thi đua, an sinh xã hội tại địa phương.</p>
            <div class="cta-row">
                <a class="btn btn-gold" asp-controller="GopY" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H7l-3 3V4Z" /></svg>
                    Gửi phản ánh, kiến nghị
                </a>
                <a class="btn btn-line" asp-controller="Home" asp-action="UnderConstruction">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l5 5v15H6z" /><path d="M14 2v6h6" /></svg>
                    Tra cứu văn bản
                </a>
            </div>
            <nav class="m26-quick" aria-label="Truy cập nhanh">
                <a asp-controller="GopY" asp-action="Index"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8px"><path d="M20 11.5a7.5 7.5 0 0 1-10.9 6.7L4.5 19.5l1.3-4.3A7.5 7.5 0 1 1 20 11.5Z" /><path d="M8.5 10.8h7M8.5 13.8h4.5" /></svg></span><span>Phản ánh</span></a>
                <a asp-controller="Home" asp-action="UnderConstruction"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8px"><path d="M6 2h9l5 5v15H6z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h5" /></svg></span><span>Văn bản</span></a>
                <a asp-controller="Home" asp-action="UnderConstruction"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8px"><path d="M4 5h13v14H4z" /><path d="M17 8h3v9a2 2 0 0 1-2 2h-1" /><path d="M7 8h7M7 12h7M7 16h4" /></svg></span><span>Tin tức</span></a>
                <a asp-controller="Home" asp-action="UnderConstruction"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8px"><path d="M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 17l-5.2 2.7 1-5.8L4.6 9.7l5.8-.8z" /></svg></span><span>VH Hồ Chí Minh</span></a>
                <a asp-controller="CongThongTinAnSXH" asp-action="Index"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8px"><path d="M12 21s-7-4.4-7-10a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 5.6-7 10-7 10Z" /></svg></span><span>Tiếp nhận ủng hộ</span></a>
                <a asp-controller="Home" asp-action="UnderConstruction"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8px"><circle cx="9" cy="8" r="3.1" /><path d="M3.6 20a5.4 5.4 0 0 1 10.8 0" /><path d="M16 5.6a3 3 0 0 1 0 5.6" /><path d="M17.6 20a5 5 0 0 0-2.7-4.4" /></svg></span><span>Giới thiệu</span></a>
            </nav>
            <div class="mini">
                <div class="m"><b>24/7</b><span>Tiếp nhận phản ánh</span></div>
                <div class="m"><b>100%</b><span>Công khai minh bạch</span></div>
                <div class="m"><b>22</b><span>Ấp, khu dân cư</span></div>
            </div>
        </div>
        <div class="m26-emblem-stage">
            <div class="halo"></div>
            <svg class="drum-ring r2" viewBox="0 0 400 400" aria-hidden="true"><g fill="none" stroke="#F2C14E"><circle cx="200" cy="200" r="196" stroke-width="1.5" opacity=".4" /><circle cx="200" cy="200" r="182" stroke-width="6" stroke-dasharray="1.5 11" opacity=".55" /></g></svg>
            <svg class="drum-ring r1" viewBox="0 0 400 400" aria-hidden="true"><g fill="none" stroke="#F8DA86"><circle cx="200" cy="200" r="190" stroke-width="1" opacity=".5" /><circle cx="200" cy="200" r="176" stroke-width="8" stroke-dasharray="1 12" opacity=".65" /><circle cx="200" cy="200" r="150" stroke-width="3" stroke-dasharray="0.5 9" opacity=".4" /></g></svg>
            <svg class="m26-lotus" viewBox="0 0 300 200" aria-hidden="true">
                <defs>
                    <linearGradient id="m26lotusG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FCEBBE" /><stop offset=".55" stop-color="#F2C14E" /><stop offset="1" stop-color="#C9942B" /></linearGradient>
                    <linearGradient id="m26lotusG2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E9C877" /><stop offset="1" stop-color="#A9791F" /></linearGradient>
                    <path id="m26petal" d="M0,0 C-26,-46 -15,-116 0,-148 C15,-116 26,-46 0,0 Z" />
                </defs>
                <g transform="translate(150,196)">
                    <g fill="url(#m26lotusG2)" opacity=".92">
                        <use href="#m26petal" transform="rotate(-64) scale(.8)" />
                        <use href="#m26petal" transform="rotate(-40) scale(.9)" />
                        <use href="#m26petal" transform="rotate(40) scale(.9)" />
                        <use href="#m26petal" transform="rotate(64) scale(.8)" />
                    </g>
                    <g fill="url(#m26lotusG)" stroke="#B8862A" stroke-width="1.2" stroke-opacity=".45">
                        <use href="#m26petal" transform="rotate(-50) scale(.9)" />
                        <use href="#m26petal" transform="rotate(-25)" />
                        <use href="#m26petal" />
                        <use href="#m26petal" transform="rotate(25)" />
                        <use href="#m26petal" transform="rotate(50) scale(.9)" />
                    </g>
                </g>
            </svg>
            <div class="m26-medallion">
                <img src="https://mttq.phuhoadong.vn/apps/uploads/2025/11/cropped-favicon-270x270.png" alt="Biểu trưng Mặt trận Tổ quốc Việt Nam" />
            </div>
            <div class="m26-motes">
                <span class="m26-mote" style="left:20%;top:66%;animation-delay:0s"></span>
                <span class="m26-mote" style="left:80%;top:60%;animation-delay:1.3s"></span>
                <span class="m26-mote" style="left:32%;top:78%;animation-delay:2.5s"></span>
                <span class="m26-mote" style="left:70%;top:76%;animation-delay:3.5s"></span>
                <span class="m26-mote" style="left:50%;top:84%;animation-delay:4.6s"></span>
                <span class="m26-mote" style="left:12%;top:48%;animation-delay:5.5s"></span>
            </div>
        </div>
    </div>
</section>

<div class="m26-marquee" aria-hidden="true">
    <div class="track">
        @for (var i = 0; i < 2; i++)
        {
            <span>ĐOÀN KẾT <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> DÂN CHỦ <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> ĐỔI MỚI <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> SÁNG TẠO <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> PHÁT TRIỂN <svg viewBox="0 0 100 100" fill="currentColor"><polygon points="50,6 61,38 95,38 67,58 78,92 50,72 22,92 33,58 5,38 39,38" /></svg> </span>
        }
    </div>
</div>

<div class="m26-body m26-body--home">
    <div style="display: flex; align-items: center; justify-content: center; padding: 6rem 1rem; min-height: 50vh;">
        <div class="wrap" style="text-align: center;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; border-radius: 50%; background: rgba(232, 184, 75, 0.15); color: var(--m26-gold-dark); margin-bottom: 1.5rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 40px; height: 40px;">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                </svg>
            </div>
            <h2 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: var(--m26-red); margin: 0 0 1rem;">
                Các tính năng đang được cập nhật
            </h2>
            <p style="color: var(--m26-muted); font-size: 1.05rem; max-width: 500px; margin: 0 auto 2rem; line-height: 1.6;">
                Hệ thống đang trong quá trình xây dựng và hoàn thiện các chức năng bên dưới để phục vụ bà con tốt hơn. Vui lòng quay lại sau!
            </p>
        </div>
    </div>
</div>