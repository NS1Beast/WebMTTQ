            <!-- Card 2 -->
            <a asp-controller="VanBanTaiLieu" asp-action="Index" class="bento-card bento-card-secondary">
                <div class="bento-card-icon"><i class="fas fa-file-alt"></i></div>
                <div>
                    <h3>Văn bản & tài liệu</h3>
                    <p>Kho văn bản, biểu mẫu được công khai và cập nhật thường xuyên.</p>
                    <span class="bento-cta">Tra cứu <i class="fas fa-arrow-right"></i></span>
                </div>
            </a>
            <!-- Card 3 -->
            <a asp-controller="CongThongTinAnSXH" asp-action="Index" class="bento-card bento-card-secondary">
