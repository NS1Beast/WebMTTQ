@model WebMTTQ.Models.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    /* ================= BANNER SLIDER ================= */
    .banner-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: var(--m26-ink, #1a1a2e);
        height: auto !important;
    }

    .banner-track {
        display: flex;
        width: 100%;
        will-change: transform;
        height: auto !important;
        align-items: flex-start;
    }

    .banner-slide {
        min-width: 100%;
        box-sizing: border-box;
        height: auto !important;
        transition: opacity 0.6s ease, transform 0.6s ease;
    }
        /* Xử lý thẻ a bọc ngoài ảnh để không giới hạn chiều cao */
        .banner-slide a {
            display: block !important;
            height: auto !important;
        }

        .banner-slide img {
            width: 100%;
            height: auto !important;
            display: block;
            object-fit: contain;
            object-position: center;
            transition: transform 8s ease-out;
            max-height: 500px !important;
        }

    /* ===== CENTERED CAROUSEL LAYOUT (Desktop) ===== */
    .banner-track.centered {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 18px;
        position: relative;   /* slides' offsetParent = track, so offsetLeft is track-local */
        width: 100%;
        padding: 0;
        margin: 0;
        will-change: transform;
    }

    .banner-track.centered .banner-slide {
        flex: 0 0 auto;
        min-width: 0;
        width: 66%;            /* ACTIVE ~66% of viewport, PREV/NEXT peek ~17% each side */
        box-sizing: border-box;
        opacity: 0.5;
        transform: scale(0.9);
        transform-origin: center;
        transition: opacity 0.6s ease, transform 0.6s ease;
        cursor: pointer;
        will-change: transform;
        z-index: 1;
    }

    .banner-track.centered .banner-slide img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;     /* fill edges so peek really shows neighbor image (no blank sides) */
        object-position: center;
    }

    .banner-track.centered .banner-slide.active {
        opacity: 1;
        transform: scale(1);
        z-index: 2;
        cursor: default;
    }

    /* XỬ LÝ RIÊNG CHO MÁY TÍNH (Màn hình rộng từ 992px trở lên) */
    @@media (min-width: 992px) {
        .banner-slide img {
            max-height: 500px !important;
            height: auto !important;
            object-fit: contain;
            object-position: center;
        }
    }

    /* Mobile: chiều cao banner 250-300px */
    @@media (max-width: 991px) {
        .banner-slide img {
            max-height: 300px !important;
            height: auto !important;
            object-fit: contain;
        }
    }

    /* Mobile: chuyển về dạng 1 slide tiêu chuẩn */
    @@media (max-width: 768px) {
        .banner-track.centered {
            width: 100%;
            gap: 0;
        }
        .banner-track.centered .banner-slide {
            min-width: 100%;
            width: 100%;
            flex: 0 0 auto;
            margin: 0;
            opacity: 1;
            transform: scale(1);
            cursor: default;
        }
        /* Mobile: only ACTIVE full width, no PREV/NEXT peek buttons */
        .banner-btn {
            display: none;
        }
    }

    .banner-slide.zoom img {
        transform: scale(1.15);
    }

    .banner-slide.zoom.active img {
        transform: scale(1);
    }


    .banner-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: white;
        border: 1px solid rgba(255,255,255,0.2);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        opacity: 0;
    }

    .banner-wrapper:hover .banner-btn {
        opacity: 1;
    }

    .banner-btn:hover {
        background: var(--m26-gold, #e8b84b);
        border-color: var(--m26-gold, #e8b84b);
        transform: translateY(-50%) scale(1.1);
        box-shadow: 0 4px 20px rgba(232,184,75,0.4);
    }

    .banner-prev {
        left: 20px;
    }

    .banner-next {
        right: 20px;
    }

    .banner-dots {
        position: absolute;
        bottom: 15px;
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 10px;
        z-index: 10;
    }

    .dot {
        width: 12px;
        height: 12px;
        background: rgba(255,255,255,0.4);
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.4s ease;
        border: 2px solid transparent;
    }

        .dot.active {
            background: var(--m26-gold, #e8b84b);
            border-color: rgba(255,255,255,0.6);
            box-shadow: 0 0 12px rgba(232,184,75,0.5);
            transform: scale(1.2);
        }

        .dot:hover {
            background: rgba(255,255,255,0.7);
        }

    .banner-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: var(--m26-gold, #e8b84b);
        z-index: 10;
        transition: width 0.1s linear;
        width: 0%;
    }

    /* ================= HOMEPAGE SECTIONS ================= */
    .home-section { padding: 60px 0; position: relative; overflow: hidden; }
    .home-section:nth-child(even) { background: #f8f6f4; }
    .home-section:nth-child(odd) { background: #fff; }
    .section-header {
        text-align: center;
        margin-bottom: 40px;
    }
    .section-header h2 {
        font-family: var(--font-display, "Playfair Display", Georgia, serif);
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        font-weight: 800;
        color: var(--m26-red, #8b1a2b);
        margin: 0 0 10px;
        position: relative;
        display: inline-block;
    }
    .section-header h2::after {
        content: '';
        display: block;
        width: 60px;
        height: 3px;
        background: var(--m26-gold, #e8b84b);
        margin: 12px auto 0;
        border-radius: 2px;
    }
    .section-header p { color: #777; font-size: 1rem; max-width: 600px; margin: 0 auto; line-height: 1.6; }

    /* ================= NEWS CARD ================= */
    .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
    .news-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.4s ease;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .news-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.12); }
    .news-card-img { width: 100%; height: 200px; object-fit: cover; transition: transform 0.6s ease; display: block; }
    .news-card:hover .news-card-img { transform: scale(1.05); }
    .news-card-img-wrap { overflow: hidden; }
    .news-card-body { padding: 20px; }
    .news-card-category {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: var(--m26-red, #8b1a2b);
        color: #fff;
        margin-bottom: 10px;
    }
    .news-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #222;
        line-height: 1.4;
        margin: 0 0 10px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .news-card-summary {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.4;
        margin: 5px 0;
    }
    .news-card-date { font-size: 0.8rem; color: #999; display: flex; align-items: center; gap: 6px; }
    .empty-state {
        width: 100%;
        text-align: center;
        padding: 40px;
        color: #999;
    }

    /* ================= SECTION NEWS LAYOUT (1 featured + 5 small) ================= */
    .section-news-layout { display: grid; grid-template-columns: 55% 1fr; gap: 24px; align-items: stretch; }
    .section-featured-article {
        position: relative; border-radius: 16px; overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.15); display: block; color: white;
        min-height: 480px; text-decoration: none; transition: all 0.4s ease;
    }
    .section-featured-article:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,0.25); }
    .section-featured-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .section-featured-overlay {
        position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.35) 45%, transparent 100%);
        display: flex; flex-direction: column; justify-content: flex-end; padding: 28px;
    }
    .section-featured-badge {
        display: inline-block; background: #e8a33d; color: #fff;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em;
        padding: 5px 14px; border-radius: 20px; text-transform: uppercase;
        width: fit-content; margin-bottom: 12px;
    }
    .section-featured-title {
        font-family: var(--font-display, "Playfair Display", serif);
        font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-weight: 800;
        line-height: 1.35; margin: 0 0 12px;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .section-featured-meta { display: flex; gap: 16px; font-size: 0.8rem; opacity: 0.85; align-items: center; }
    .section-featured-meta span { display: inline-flex; align-items: center; gap: 6px; }
    .section-news-sidelist { display: flex; flex-direction: column; gap: 10px; }
    .section-news-side-card {
        display: flex; gap: 12px; background: #fff; border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 12px; text-decoration: none;
        color: inherit; transition: all 0.3s ease; flex: 1;
    }
    .section-news-side-card:hover { transform: translateX(4px); box-shadow: 0 6px 20px rgba(0,0,0,0.12); }
    .section-news-side-thumb {
        width: 32%; min-width: 90px; aspect-ratio: 16/9; border-radius: 8px;
        object-fit: cover; overflow: hidden;
    }
    .section-news-side-content { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
    .section-news-side-cat {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.05em; color: var(--m26-red, #8b1a2b); margin-bottom: 4px;
    }
    .section-news-side-title {
        font-size: 0.88rem; font-weight: 700; color: #222; line-height: 1.35;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        margin: 0 0 4px;
    }
    .section-news-side-date { font-size: 0.75rem; color: #999; }

    @@media (max-width: 768px) {
        .home-section { padding: 40px 0; }
        .news-grid { grid-template-columns: 1fr; }
        .banner-btn { width: 36px; height: 36px; font-size: 16px; }
        .banner-prev { left: 10px; }
        .banner-next { right: 10px; }
    }

    .banner-track.fade { transition: none; }
    .banner-track.fade .banner-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transition: opacity 0.6s ease;
        pointer-events: none;
    }
    .banner-track.fade .banner-slide.active {
        opacity: 1;
        pointer-events: auto;
        position: relative;
    }

    /* ================= FEATURED NEWS ================= */
    .featured-news-section { background: #f8f6f4; padding: 60px 0; }
    .featured-news-header { text-align: center; margin-bottom: 40px; }
    .featured-news-eyebrow {
        display: inline-flex; align-items: center; gap: 12px;
        font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--m26-red, #8b1a2b);
    }
    .featured-news-eyebrow::before, .featured-news-eyebrow::after {
        content: ''; height: 1px; width: 40px; background: currentColor; opacity: 0.4;
    }
    .featured-news-header h2 {
        font-family: var(--font-display, "Playfair Display", serif);
        font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800;
        color: var(--m26-ink, #1e1a1d); margin: 10px 0 0;
    }
    .featured-news-layout { display: grid; grid-template-columns: 55% 1fr; gap: 28px; align-items: stretch; }
    .featured-article {
        position: relative; border-radius: 16px; overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.15); display: block; color: white;
        min-height: 480px; text-decoration: none; transition: all 0.4s ease;
    }
    .featured-article:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,0.25); }
    .featured-article-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .featured-article-overlay {
        position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.35) 45%, transparent 100%);
        display: flex; flex-direction: column; justify-content: flex-end; padding: 28px;
    }
    .featured-badge {
        display: inline-block; background: var(--m26-red, #8b1a2b); color: #fff;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em;
        padding: 5px 14px; border-radius: 20px; text-transform: uppercase;
        width: fit-content; margin-bottom: 12px;
    }
    .featured-article-title {
        font-family: var(--font-display, "Playfair Display", serif);
        font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-weight: 800;
        line-height: 1.35; margin: 0 0 12px;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .featured-article-meta { display: flex; gap: 16px; font-size: 0.8rem; opacity: 0.85; align-items: center; }
    .featured-article-meta span { display: inline-flex; align-items: center; gap: 6px; }
    .featured-sidelist { display: flex; flex-direction: column; gap: 10px; }
    .featured-side-card {
        display: flex; gap: 12px; background: #fff; border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 12px; text-decoration: none;
        color: inherit; transition: all 0.3s ease; flex: 1;
    }
    .featured-side-card:hover { transform: translateX(4px); box-shadow: 0 6px 20px rgba(0,0,0,0.12); }
    .featured-side-thumb {
        width: 32%; min-width: 90px; aspect-ratio: 16/9; border-radius: 8px;
        object-fit: cover; overflow: hidden;
    }
    .featured-side-content { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
    .featured-side-cat {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.05em; color: var(--m26-red, #8b1a2b); margin-bottom: 4px;
    }
    .featured-side-title {
        font-size: 0.88rem; font-weight: 700; color: #222; line-height: 1.35;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        margin: 0 0 4px;
    }
    .featured-side-date { font-size: 0.75rem; color: #999; }

    /* ================= UTILITIES BENTO GRID ================= */
    .utilities-section { padding: 60px 0; background: #fff; }
    .utilities-header { text-align: center; margin-bottom: 45px; }
    .utilities-eyebrow {
        display: inline-flex; align-items: center; gap: 12px;
        font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--m26-red, #8b1a2b);
    }
    .utilities-eyebrow::before, .utilities-eyebrow::after {
        content: ''; height: 1px; width: 40px; background: currentColor; opacity: 0.4;
    }
    .utilities-header h2 {
        font-family: var(--font-display, "Playfair Display", serif);
        font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800;
        color: var(--m26-ink, #1e1a1d); margin: 10px 0 8px;
    }
    .utilities-header p { color: #777; max-width: 560px; margin: 0 auto; line-height: 1.6; font-size: 0.95rem; }
    
    /* Đổi sang Grid 2 cột: Cột trái to (1.4fr), Cột phải nhỏ (1fr) */
    .bento-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; }
    
    .bento-card {
        border-radius: 16px; padding: 32px; display: flex; flex-direction: column;
        justify-content: space-between; position: relative;
        overflow: hidden; transition: all 0.35s ease; text-decoration: none;
        /* Đã gỡ bỏ min-height cố định để các ô tự động khớp chiều cao với nhau */
    }
    .bento-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,0.15); }
    
    .bento-card-main {
        background: linear-gradient(145deg, #8b1a2b 0%, #6d1120 100%);
        color: white; 
        grid-row: span 2; /* Ép thẻ chính chiếm 2 hàng */
        min-height: 100%; /* Kéo giãn vừa bằng 2 thẻ bên phải */
    }
    .bento-card-main::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(circle at 85% 15%, rgba(255,255,255,0.08) 0%, transparent 60%);
    }
    .sunburst {
        position: absolute; right: -40px; top: -40px; width: 180px; height: 180px;
        background: repeating-conic-gradient(from 0deg, rgba(255,255,255,0.08) 0deg 15deg, transparent 15deg 30deg);
        border-radius: 50%; pointer-events: none;
    }
    .bento-card-icon {
        width: 52px; height: 52px; border-radius: 12px; display: flex;
        align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 18px;
    }
    .bento-card-main .bento-card-icon { background: rgba(255,255,255,0.15); }
    .bento-card h3 { font-family: var(--font-display, "Playfair Display", serif); font-size: 1.35rem; font-weight: 800; margin: 0 0 10px; }
    .bento-card p { font-size: 0.9rem; line-height: 1.6; opacity: 0.85; margin: 0 0 20px; }
    .bento-card.main p { opacity: 0.9; }
    
    .bento-card-secondary { 
        background: #fff; border: 1px solid rgba(139,26,43,0.12); box-shadow: 0 4px 18px rgba(0,0,0,0.04); 
        min-height: 200px; /* Giữ độ cao tối thiểu để nội dung không bị ép */
    }
    .bento-card-secondary .bento-card-icon { background: #fdf6e3; color: #8b1a2b; }
    .bento-cta {
        display: inline-flex; align-items: center; gap: 8px; font-weight: 700;
        font-size: 0.9rem; margin-top: auto; transition: gap 0.3s ease;
    }
    .bento-card-main .bento-cta { color: #f0d48a; }
    .bento-card-secondary .bento-cta { color: var(--m26-red, #8b1a2b); }
    .bento-card:hover .bento-cta { gap: 14px; }

    /* ================= GALLERY (THƯ VIỆN ẢNH) ================= */
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .gallery-item {
        position: relative; border-radius: 12px; overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08); cursor: pointer;
        transition: all 0.4s ease; background: #fff;
    }
    .gallery-item:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.15); }
    .gallery-item img { width: 100%; height: 220px; object-fit: cover; display: block; transition: transform 0.6s ease; }
    .gallery-item:hover img { transform: scale(1.05); }
    .gallery-caption {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
        color: #fff; padding: 30px 16px 14px; font-size: 0.9rem; font-weight: 600;
        line-height: 1.4;
    }

    /* ================= VIDEO GRID ================= */
    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
    .video-card {
        background: #fff; border-radius: 12px; overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08); transition: all 0.4s ease;
        text-decoration: none; color: inherit; display: block;
    }
    .video-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.15); }
    .video-embed-wrap { position: relative; width: 100%; padding-top: 56.25%; /* 16:9 aspect ratio */ background: #000; }
    .video-embed-wrap iframe {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        border: none; display: block;
    }
    .video-body { padding: 16px 20px; }
    .video-title { font-size: 1rem; font-weight: 700; color: #222; line-height: 1.4; margin: 0 0 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .video-desc { font-size: 0.85rem; color: #666; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* ================= VĂN BẢN LIST ================= */
    .vanban-list { display: flex; flex-direction: column; gap: 12px; max-width: 900px; margin: 0 auto; }
    .vanban-item {
        display: flex; align-items: center; gap: 16px;
        background: #fff; border-radius: 10px; padding: 16px 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06); text-decoration: none;
        color: inherit; transition: all 0.3s ease; border-left: 4px solid #8b1a2b;
    }
    .vanban-item:hover { transform: translateX(6px); box-shadow: 0 6px 20px rgba(0,0,0,0.12); }
    .vanban-icon {
        width: 48px; height: 48px; border-radius: 10px; flex-shrink: 0;
        background: rgba(139,26,43,0.1); color: #8b1a2b;
        display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
    }
    .vanban-content { flex: 1; min-width: 0; }
    .vanban-title { font-size: 0.95rem; font-weight: 700; color: #222; margin: 0 0 4px; line-height: 1.4; }
    .vanban-desc { font-size: 0.82rem; color: #666; margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .vanban-download { color: #8b1a2b; font-size: 1.2rem; flex-shrink: 0; }

    /* ================= LIÊN KẾT GRID ================= */
    .link-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
    .link-card {
        display: flex; align-items: center; gap: 14px;
        background: #fff; border-radius: 10px; padding: 16px 18px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06); text-decoration: none;
        color: inherit; transition: all 0.3s ease; border: 1px solid rgba(0,0,0,0.04);
    }
    .link-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); border-color: rgba(139,26,43,0.2); }
    .link-icon {
        width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0;
        background: #fdf6e3; color: #8b1a2b;
        display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
    }
    .link-title { font-size: 0.9rem; font-weight: 700; color: #222; margin: 0; line-height: 1.4; }
    .link-arrow { margin-left: auto; color: #8b1a2b; font-size: 0.9rem; flex-shrink: 0; }

    /* ================= TIMELINE ================= */
    .timeline-section { padding: 60px 0; background: #f8f6f4; }
    .timeline-header { text-align: center; margin-bottom: 50px; }
    .timeline-eyebrow {
        display: inline-flex; align-items: center; gap: 12px;
        font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--m26-red, #8b1a2b);
    }
    /* Thêm gạch ngang 2 bên cho giống hình */
    .timeline-eyebrow::before, .timeline-eyebrow::after {
        content: ''; height: 1px; width: 40px; background: currentColor; opacity: 0.4;
    }
    .timeline-header h2 {
        font-family: var(--font-display, "Playfair Display", serif);
        font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800;
        color: var(--m26-ink, #1e1a1d); margin: 12px 0 0;
    }
    .timeline-vertical {
        position: relative; 
        max-width: 650px; /* Thu hẹp lại một chút để khối ôm sát và căn giữa gọn gàng */
        margin: 0 auto;   /* Sử dụng auto để căn giữa toàn bộ khối */
        padding-left: 20px; 
    }
    .timeline-vertical::before {
        content: ''; position: absolute; left: -30px; top: 0; bottom: 0;
        width: 2px; background: #dea954; /* Đường kẻ mảnh màu vàng cam */
        border-radius: 2px;
    }
    .timeline-item {
        display: flex; gap: 40px; margin-bottom: 40px; position: relative;
        width: 100%; padding-left: 0; text-align: left;
    }
    .timeline-dot {
        position: absolute; left: -57px; top: 4px; width: 16px; height: 16px;
        border-radius: 50%; background: #f8f6f4; /* Chấm rỗng (trùng với nền timeline) */
        border: 2px solid #dea954; /* Viền vàng cam */
        box-shadow: 0 0 0 4px rgba(222, 169, 84, 0.15); /* Quầng mờ xung quanh */
        z-index: 1;
    }
    .timeline-time {
        display: block; color: var(--m26-red, #8b1a2b);
        font-size: 0.85rem; font-weight: 800; padding: 0; border-radius: 0;
        margin-bottom: 6px; letter-spacing: 0.05em; background: transparent; /* Xóa phông nền cũ */
    }
    .timeline-text h3 {
        font-family: var(--font-display, "Playfair Display", serif);
        font-size: 1.15rem; font-weight: 800; color: #222; margin: 0 0 8px;
    }
    .timeline-text p { font-size: 0.88rem; color: #666; line-height: 1.6; margin: 0; }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 991px) {
        .featured-news-layout { grid-template-columns: 1fr; }
        .featured-article { min-height: 400px; }
        .section-news-layout { grid-template-columns: 1fr; }
        .section-featured-article { min-height: 400px; }
        .bento-grid { grid-template-columns: 1fr; }
        .bento-card-main { grid-row: span 1; min-height: 240px; }
        .timeline-vertical { margin-left: 40px; }
        .timeline-vertical::before { left: 5px; }
        .timeline-item {
            width: 100%; flex-direction: row; padding-left: 20px !important; padding-right: 0 !important;
            text-align: left !important; margin-left: 0 !important; margin-right: 0 !important;
        }
        .timeline-dot { left: -3px !important; right: auto !important; }
        .timeline-dot, .timeline-item:nth-child(even) .timeline-dot { left: -3px !important; }
    }
    @@media (max-width: 600px) {
        .bento-grid { grid-template-columns: 1fr; }
        .featured-news-section, .utilities-section, .timeline-section { padding: 40px 0; }
        .featured-article { min-height: 340px; }
        .featured-side-thumb { width: 35%; min-width: 80px; }
        .section-featured-article { min-height: 340px; }
        .section-news-side-thumb { width: 35%; min-width: 80px; }
        .gallery-grid { grid-template-columns: 1fr; }
        .video-grid { grid-template-columns: 1fr; }
        .link-grid { grid-template-columns: 1fr; }
        .gallery-item img { height: 200px; }
        .video-thumb { height: 180px; }
        .vanban-item { flex-direction: column; align-items: flex-start; gap: 10px; }
        .vanban-download { align-self: flex-end; }
    }
</style>

