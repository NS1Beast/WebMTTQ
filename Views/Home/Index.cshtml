</section>

<!-- ================= FEATURED NEWS ================= -->
@if (Model.FeaturedNews != null && Model.FeaturedNews.Any())
{
    var featured = Model.FeaturedNews[0];
    var sideArticles = Model.FeaturedNews.Skip(1).Take(4).ToList();

    <section class="featured-news-section">
        <div class="wrap">
            <div class="featured-news-header">
                <span class="featured-news-eyebrow">TIN TỨC - SỰ KIỆN</span>
                <h2>Hoạt động nổi bật của Mặt trận</h2>
            </div>
            <div class="featured-news-layout">
                <!-- Featured article (left) -->
                <a href="/News/Details/@featured.IdbaiViet" class="featured-article">
                    <img src="@(featured.HinhAnh ?? "")" alt="@featured.TieuDe" class="featured-article-img" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22800%22 height=%22500%22 viewBox=%220 0 800 500%22%3E%3Crect fill=%22%238b1a2b%22 width=%22800%22 height=%22500%22/%3E%3Ctext fill=%22%23fff%22 font-family=%22Arial%22 font-size=%2224%22 text-anchor=%22middle%22 x=%22400%22 y=%22260%22%3EMTTQ%3C/text%3E%3C/svg%3E'" />
                    <div class="featured-article-overlay">
                        <span class="featured-badge">Tiêu điểm</span>
                        <h3 class="featured-article-title">@featured.TieuDe</h3>
                        <div class="featured-article-meta">
                            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> @(featured.NgayXuatBan?.ToString("dd/MM/yyyy") ?? "")</span>
                            @if (featured.IdchuyenMucNavigation != null)
                            {
                                <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="6" cy="6" r="2"/><path d="M8 12a5 5 0 0 1 5-5M20 6a14 14 0 0 1-14 14"/></svg> @featured.IdchuyenMucNavigation.TenChuyenMuc</span>
                            }
                        </div>
                    </div>
                </a>

                <!-- Side list (right) -->
                <div class="featured-sidelist">
                    @foreach (var item in sideArticles)
                    {
                        <a href="/News/Details/@item.IdbaiViet" class="featured-side-card">
                            <img src="@(item.HinhAnh ?? "")" alt="@item.TieuDe" class="featured-side-thumb" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%2290%22 viewBox=%220 0 160 90%22%3E%3Crect fill=%22%238b1a2b%22 width=%22160%22 height=%2290%22/%3E%3Ctext fill=%22%23fff%22 font-family=%22Arial%22 font-size=%2212%22 text-anchor=%22middle%22 x=%2280%22 y=%2250%22%3EMTTQ%3C/text%3E%3C/svg%3E'" />
                            <div class="featured-side-content">
                                @if (item.IdchuyenMucNavigation != null)
                                {
                                    <span class="featured-side-cat">@item.IdchuyenMucNavigation.TenChuyenMuc</span>
                                }
                                <h4 class="featured-side-title">@item.TieuDe</h4>
                                <span class="featured-side-date">@(item.NgayXuatBan?.ToString("dd/MM/yyyy") ?? "")</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- ================= HOMEPAGE SECTIONS (từ DB) ================= -->
@if (Model.Sections != null && Model.Sections.Any())
{
    foreach (var sec in Model.Sections)
    {
        <div class="home-section" id="section-@sec.Id">
            <div class="wrap">
                <div class="section-header">
                    <h2>@sec.TieuDe</h2>
                    @if (!string.IsNullOrEmpty(sec.NoiDung))
                    {
                        <p>@sec.NoiDung</p>
                    }
                </div>
                @switch (sec.Loai)
                {
                    case "tin-tuc":
                        var sectionNewsItems = Model.SectionNews != null && Model.SectionNews.ContainsKey(sec.Id)
                            ? Model.SectionNews[sec.Id]
                            : new List<TrangChuTinTuc>();
                        @if (sectionNewsItems.Any())
                        {
                            var featuredNews = sectionNewsItems[0];
                            var sideNews = sectionNewsItems.Skip(1).Take(5).ToList();
                            <div class="section-news-layout">
                                <!-- Featured article (left) -->
                                <a href="@(!string.IsNullOrEmpty(featuredNews.LienKet) ? featuredNews.LienKet : "#")" class="section-featured-article">
                                    <img src="@featuredNews.HinhAnh" alt="@featuredNews.TieuDe" class="section-featured-img" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22800%22 height=%22500%22 viewBox=%220 0 800 500%22%3E%3Crect fill=%22%238b1a2b%22 width=%22800%22 height=%22500%22/%3E%3Ctext fill=%22%23fff%22 font-family=%22Arial%22 font-size=%2224%22 text-anchor=%22middle%22 x=%22400%22 y=%22260%22%3EMTTQ%3C/text%3E%3C/svg%3E'" />
                                    <div class="section-featured-overlay">
                                        <span class="section-featured-badge">Tiêu điểm</span>
                                        <h3 class="section-featured-title">@featuredNews.TieuDe</h3>
                                        <div class="section-featured-meta">
                                            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> @featuredNews.NgayTao.ToString("dd/MM/yyyy")</span>
                                            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="6" cy="6" r="2"/><path d="M8 12a5 5 0 0 1 5-5M20 6a14 14 0 0 1-14 14"/></svg> @sec.TieuDe</span>
                                        </div>
                                    </div>
                                </a>

                                <!-- Side list (right) -->
                                <div class="section-news-sidelist">
                                    @foreach (var news in sideNews)
                                    {
                                        <a href="@(!string.IsNullOrEmpty(news.LienKet) ? news.LienKet : "#")" class="section-news-side-card">
                                            <img src="@news.HinhAnh" alt="@news.TieuDe" class="section-news-side-thumb" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%2290%22 viewBox=%220 0 160 90%22%3E%3Crect fill=%22%238b1a2b%22 width=%22160%22 height=%2290%22/%3E%3Ctext fill=%22%23fff%22 font-family=%22Arial%22 font-size=%2212%22 text-anchor=%22middle%22 x=%2280%22 y=%2250%22%3EMTTQ%3C/text%3E%3C/svg%3E'" />
                                            <div class="section-news-side-content">
                                                <span class="section-news-side-cat">@sec.TieuDe</span>
                                                <h4 class="section-news-side-title">@news.TieuDe</h4>
                                                <span class="section-news-side-date">@news.NgayTao.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-inbox" style="font-size:2rem;opacity:0.3;"></i>
                                <p>Chưa có tin tức nào trong mục này.</p>
                            </div>
                        }
                        break;
                    case "hinh-anh":
                        var galleryItems = Model.SectionNews != null && Model.SectionNews.ContainsKey(sec.Id)
                            ? Model.SectionNews[sec.Id]
                            : new List<TrangChuTinTuc>();
                        @if (galleryItems.Any())
                        {
                            <div class="gallery-grid">
                                @foreach (var img in galleryItems)
                                {
                                    <div class="gallery-item" onclick="window.open('@img.HinhAnh', '_blank')">
                                        <img src="@img.HinhAnh" alt="@img.TieuDe" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22 viewBox=%220 0 400 300%22%3E%3Crect fill=%22%23e8b84b%22 width=%22400%22 height=%22300%22/%3E%3Ctext fill=%22%23333%22 font-family=%22Arial%22 font-size=%2220%22 text-anchor=%22middle%22 x=%22200%22 y=%22160%22%3EMTTQ%3C/text%3E%3C/svg%3E'" />
                                        @if (!string.IsNullOrEmpty(img.TieuDe))
                                        {
                                            <div class="gallery-caption">@img.TieuDe</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-images" style="font-size:2rem;opacity:0.3;"></i>
                                <p>Chưa có hình ảnh cho mục này.</p>
                            </div>
                        }
                        break;
                    case "video":
                        var videoItems = Model.SectionNews != null && Model.SectionNews.ContainsKey(sec.Id)
                            ? Model.SectionNews[sec.Id]
                            : new List<TrangChuTinTuc>();
                        @if (videoItems.Any())
                        {
                            <div class="video-grid">
                                @foreach (var video in videoItems)
                                {
                                    var embedUrl = video.LienKet ?? "";
                                    // Chuyển đổi URL YouTube sang embed
                                    if (embedUrl.Contains("youtube.com/watch?v="))
                                    {
                                        embedUrl = embedUrl.Replace("youtube.com/watch?v=", "youtube.com/embed/");
                                    }
                                    else if (embedUrl.Contains("youtu.be/"))
                                    {
                                        embedUrl = embedUrl.Replace("youtu.be/", "youtube.com/embed/");
                                    }
                                    else if (embedUrl.Contains("drive.google.com/file/d/"))
                                    {
                                        // Google Drive: chuyển sang preview
                                        var driveId = embedUrl.Split("/file/d/")[1].Split("/")[0];
                                        embedUrl = $"https://drive.google.com/file/d/{driveId}/preview";
                                    }
                                    else if (embedUrl.Contains("vimeo.com/"))
                                    {
                                        var vimeoId = embedUrl.Split("vimeo.com/")[1].Split("?")[0];
                                        embedUrl = $"https://player.vimeo.com/video/{vimeoId}";
                                    }
                                    <div class="video-card">
                                        <div class="video-embed-wrap">
                                            <iframe src="@embedUrl" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                        </div>
                                        <div class="video-body">
                                            <h3 class="video-title">@video.TieuDe</h3>
                                            @if (!string.IsNullOrEmpty(video.TomTat))
                                            {
                                                <p class="video-desc">@video.TomTat</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-video" style="font-size:2rem;opacity:0.3;"></i>
                                <p>Chưa có video nào trong mục này.</p>
                            </div>
                        }
                        break;
                    case "van-ban":
                        var vanbanItems = Model.SectionNews != null && Model.SectionNews.ContainsKey(sec.Id)
                            ? Model.SectionNews[sec.Id]
                            : new List<TrangChuTinTuc>();
                        @if (vanbanItems.Any())
                        {
                            <div class="vanban-list">
                                @foreach (var vb in vanbanItems)
                                {
                                    <a href="@(!string.IsNullOrEmpty(vb.LienKet) ? vb.LienKet : "#")" target="@(!string.IsNullOrEmpty(vb.LienKet) ? "_blank" : "_self")" class="vanban-item">
                                        <div class="vanban-icon"><i class="fas fa-file-pdf"></i></div>
                                        <div class="vanban-content">
                                            <h3 class="vanban-title">@vb.TieuDe</h3>
                                            @if (!string.IsNullOrEmpty(vb.TomTat))
                                            {
                                                <p class="vanban-desc">@vb.TomTat</p>
                                            }
                                        </div>
                                        <div class="vanban-download"><i class="fas fa-download"></i></div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-file-alt" style="font-size:2rem;opacity:0.3;"></i>
                                <p>Chưa có văn bản nào trong mục này.</p>
                            </div>
                        }
                        break;
                    default:
                        <div style="display:flex;justify-content:center;">
                            <div style="background:#fff;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.06);max-width:800px;width:100%;border:1px solid rgba(0,0,0,0.04);">
                                <div style="text-align:center;margin-bottom:15px;">
                                    <div style="width:64px;height:64px;border-radius:50%;background:rgba(139,26,43,0.1);color:#8b1a2b;display:inline-flex;align-items:center;justify-content:center;font-size:1.5rem;">
                                        <i class="fas fa-info-circle"></i>
                                    </div>
                                </div>
                                <div style="color:#666;font-size:0.95rem;line-height:1.6;text-align:center;">
                                    @if (!string.IsNullOrEmpty(sec.NoiDung))
                                    {
                                        @Html.Raw(WebMTTQ.Services.HtmlSanitizer.Sanitize(sec.NoiDung ?? ""))
                                    }
                                    else
                                    {
                                        <p>Nội dung đang được cập nhật...</p>
                                    }
                                </div>
                            </div>
                        </div>
                        break;
                }
            </div>
        </div>
    }
}

<!-- ================= TIMELINE (HÀNH TRÌNH CHUYỂN ĐỔI SỐ) ================= -->
@if (Model.Timeline != null && Model.Timeline.IsEnabled && Model.Timeline.Items != null && Model.Timeline.Items.Any())
{
    <section class="timeline-section">
        <div class="wrap">
            <div class="timeline-header">
                @if (!string.IsNullOrEmpty(Model.Timeline.Eyebrow))
                {
                    <span class="timeline-eyebrow">@Model.Timeline.Eyebrow</span>
                }
                @if (!string.IsNullOrEmpty(Model.Timeline.Title))
                {
                    <h2>@Model.Timeline.Title</h2>
                }
            </div>
            <div class="timeline-vertical">
                @{
                    var items = Model.Timeline.Items.OrderBy(i => i.SortOrder).ToList();
                }
                @for (int i = 0; i < items.Count; i++)
                {
                    var tlItem = items[i];
                    <div class="timeline-item">
                        <div class="timeline-text">
                            <span class="timeline-time">@tlItem.TimeLabel</span>
                            <h3>@tlItem.Title</h3>
                            @if (!string.IsNullOrEmpty(tlItem.Description))
                            {
                                <p>@tlItem.Description</p>
                            }
                        </div>
                        <span class="timeline-dot"></span>
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        let currentBannerIndex = 0;
        const bannerTrack = document.getElementById('bannerTrack');
        const wrapper = document.getElementById('homeBanner');
        const dots = Array.from(document.querySelectorAll('.dot'));
        const progressBar = document.getElementById('bannerProgress');
        const baseSlides = Array.from(document.querySelectorAll('.banner-slide'));
        const totalBanners = baseSlides.length;
        let slideInterval, progressInterval;
        let isTransitioning = false;
        let snapTimer = null;
        const defaultEffect = baseSlides[0] ? (baseSlides[0].dataset.effect || 'slide') : 'slide';
        const defaultSpeed = @(Model.Banners?.FirstOrDefault()?.TocDo ?? 600);
        const defaultDelay = @(Model.Banners?.FirstOrDefault()?.ThoiGianDung ?? 5000);
        const isCentered = defaultEffect === 'centered';
        const MOBILE_BREAK = 768;

        // allSlides = slides currently attached to the track (includes clones on desktop centered)
        let allSlides = baseSlides.slice();
        let offset = 0; // clones placed before the first real slide
        let builtCarousel = false; // whether the track currently holds closed-loop clones

        const isMobile = () => window.innerWidth <= MOBILE_BREAK;
        const useCarousel = () => isCentered && totalBanners >= 3 && !isMobile();

        function getSlideEffect(index) { return allSlides[index] ? (allSlides[index].dataset.effect || defaultEffect) : defaultEffect; }

        function trackTranslateX(px, animate) {
            bannerTrack.style.transition = animate
                ? 'transform ' + defaultSpeed + 'ms cubic-bezier(0.25, 0.46, 0.45, 0.94)'
                : 'none';
            // px can be a number (px) or a "%"-suffixed string (non-carousel 100%-wide slides)
            bannerTrack.style.transform = 'translateX(' + (typeof px === 'number' ? px + 'px' : px) + ')';
            if (!animate) void bannerTrack.offsetWidth; // force reflow so the snap is instant
        }

        // formula: translateX = viewportCenter - activeSlideCenter
        function slideCenter(childIndex) {
            const el = allSlides[childIndex];
            if (!el) return 0;
            return el.offsetLeft + el.offsetWidth / 2;
        }
        function centerChild(childIndex, animate) {
            trackTranslateX(wrapper.clientWidth / 2 - slideCenter(childIndex), animate);
        }

        function buildTrack() {
            if (snapTimer) { clearTimeout(snapTimer); snapTimer = null; }
            const fragment = document.createDocumentFragment();
            while (bannerTrack.firstChild) bannerTrack.removeChild(bannerTrack.firstChild);
            if (useCarousel()) {
                // [lastClone, ...originals..., firstClone] for seamless infinite loop
                fragment.appendChild(baseSlides[totalBanners - 1].cloneNode(true));
                baseSlides.forEach(s => fragment.appendChild(s.cloneNode(true)));
                fragment.appendChild(baseSlides[0].cloneNode(true));
                offset = 1;
                builtCarousel = true;
            } else {
                baseSlides.forEach(s => {
                    const c = s.cloneNode(true);
                    if (isCentered) c.style.width = '100%'; // non-carousel (1-2 banners / mobile) -> full width slide
                    fragment.appendChild(c);
                });
                offset = 0;
                builtCarousel = false;
            }
            bannerTrack.appendChild(fragment);
            allSlides = Array.from(bannerTrack.querySelectorAll('.banner-slide'));
        }

        function updateContent() {
            allSlides.forEach(s => s.classList.remove('active'));
            const activeChild = useCarousel() ? offset + currentBannerIndex : currentBannerIndex;
            const el = allSlides[activeChild];
            if (el) el.classList.add('active');
            dots.forEach(d => d.classList.remove('active'));
            if (dots[currentBannerIndex]) dots[currentBannerIndex].classList.add('active');
            if (progressBar) {
                progressBar.style.width = '0%';
                clearInterval(progressInterval);
                startProgress();
            }
        }

        function positionActive() {
            const effect = getSlideEffect(currentBannerIndex);
            if (effect === 'fade') {
                allSlides.forEach((s, i) => {
                    s.style.opacity = i === currentBannerIndex ? '1' : '0';
                    s.style.position = i === currentBannerIndex ? 'relative' : 'absolute';
                    s.style.transform = i === currentBannerIndex ? 'scale(1)' : 'scale(0.9)';
                });
            } else if (useCarousel()) {
                centerChild(offset + currentBannerIndex, true);
            } else {
                // Each slide is 100% of the track width, so advance by full percentages
                // (previously used -N*100 as px, which never actually switched banners).
                trackTranslateX('-' + (currentBannerIndex * 100) + '%', true);
            }
        }

        function finishMove() {
            updateContent();
            setTimeout(function() { isTransitioning = false; }, defaultSpeed);
        }

        /* old setupCenteredCarousel()/updateCenteredPosition() replaced by buildTrack()/centerChild() */

        /* old updateBannerUI() removed -- use positionActive() + updateContent() instead */

        function startProgress() {
            if (!progressBar) return;
            var width = 0;
            var step = 100 / (defaultDelay / 50);
            progressInterval = setInterval(function() {
                width += step;
                if (width >= 100) width = 0;
                progressBar.style.width = Math.min(width, 100) + '%';
            }, 50);
        }

        function resetAutoPlay() {
            if (slideInterval) { clearInterval(slideInterval); slideInterval = null; }
            slideInterval = setInterval(function() { moveBanner(1); }, defaultDelay);
        }

        function moveBanner(step) {
            if (isTransitioning) return;
            isTransitioning = true;
            resetAutoPlay(); // any interaction (autoplay/button/dot/swipe) restarts the autoplay timer
            if (useCarousel()) {
                const maxIndex = totalBanners - 1;
                const next = currentBannerIndex + step;
                if (next < 0) {
                    // Move onto the left LAST-clone (visually the previous banner), then snap back seamlessly
                    centerChild(offset - 1, true);
                    snapTimer = setTimeout(function() {
                        currentBannerIndex = maxIndex;
                        centerChild(offset + maxIndex, false);
                        finishMove();
                    }, defaultSpeed);
                } else if (next > maxIndex) {
                    // Move onto the right FIRST-clone (visually the next banner), then snap back seamlessly
                    centerChild(offset + totalBanners, true);
                    snapTimer = setTimeout(function() {
                        currentBannerIndex = 0;
                        centerChild(offset, false);
                        finishMove();
                    }, defaultSpeed);
                } else {
                    currentBannerIndex = next;
                    centerChild(offset + currentBannerIndex, true);
                    finishMove();
                }
            } else {
                currentBannerIndex = (currentBannerIndex + step + totalBanners) % totalBanners;
                positionActive();
                finishMove();
            }
        }

        function setBanner(index) {
            if (isTransitioning || index === currentBannerIndex) return;
            resetAutoPlay();
            currentBannerIndex = index;
            isTransitioning = true;
            positionActive();
            finishMove();
        }

        /* side-slide (peek) click delegation is handled by the click listener in the init block below */

        function initSlider() {
            buildTrack();
            if (getSlideEffect(0) === 'fade') {
                bannerTrack.style.transform = 'none';
                allSlides.forEach(function(slide, i) {
                    slide.style.opacity = i === 0 ? '1' : '0';
                    slide.style.position = i === 0 ? 'relative' : 'absolute';
                    slide.style.width = '100%'; slide.style.height = '100%';
                    slide.style.top = '0'; slide.style.left = '0';
                });
            } else if (useCarousel()) {
                currentBannerIndex = 0;
                centerChild(offset, false); // snap first slide to the exact viewport center
            } else {
                currentBannerIndex = 0;
                trackTranslateX(0, false);
            }
            updateContent();
        }

        if (totalBanners > 0) {
            initSlider();
            startProgress();
            resetAutoPlay();

            var touchStartX = 0;
            wrapper.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
            wrapper.addEventListener('touchend', function(e) {
                var diff = touchStartX - e.changedTouches[0].screenX;
                if (Math.abs(diff) > 50) { if (diff > 0) moveBanner(1); else moveBanner(-1); }
            }, { passive: true });

            // Clicking a peeked side slide (desktop carousel) -> PREV / NEXT
            bannerTrack.addEventListener('click', function(e) {
                if (!isCentered || !useCarousel()) return;
                var node = e.target;
                while (node && node.classList && !node.classList.contains('banner-slide')) node = node.parentElement;
                if (!node) return;
                var childIndex = allSlides.indexOf(node);
                var activeChild = offset + currentBannerIndex;
                if (childIndex === activeChild) return; // let the ACTIVE slide's own <a> behave normally
                if (childIndex === activeChild - 1 || (childIndex === 0 && currentBannerIndex === 0)) {
                    e.preventDefault();
                    moveBanner(-1);
                } else if (childIndex === activeChild + 1 || (childIndex === allSlides.length - 1 && currentBannerIndex === totalBanners - 1)) {
                    e.preventDefault();
                    moveBanner(1);
                }
            });

            // Responsive: rebuild clones when crossing the 768px breakpoint, else recenter on resize
            window.addEventListener('resize', function() {
                if (!isCentered) return;
                if (useCarousel() !== builtCarousel) buildTrack();
                if (useCarousel()) centerChild(offset + currentBannerIndex, false);
                else { trackTranslateX('-' + (currentBannerIndex * 100) + '%', false); updateContent(); }
            });
        }
    </script>
}
