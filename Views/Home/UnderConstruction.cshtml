@{
    ViewData["Title"] = "Tính năng đang cập nhật";
}

<div class="m26-body" style="background: var(--m26-bg); min-height: 70vh; display: flex; align-items: center; justify-content: center;">
    <div class="wrap" style="text-align: center; padding: 4rem 1rem;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; border-radius: 50%; background: rgba(232, 184, 75, 0.15); color: var(--m26-gold-dark); margin-bottom: 1.5rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 40px; height: 40px;">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
            </svg>
        </div>
        <h1 style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: var(--m26-red); margin: 0 0 1rem;">
            Tính năng đang được cập nhật
        </h1>
        <p style="color: var(--m26-muted); font-size: 1.05rem; max-width: 500px; margin: 0 auto 2rem; line-height: 1.6;">
            Hệ thống đang trong quá trình xây dựng và hoàn thiện chức năng này để phục vụ bà con tốt hơn. Vui lòng quay lại sau!
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-gold" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.5rem; border-radius: 999px; font-weight: 600;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px;"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
            Quay lại Trang chủ
        </a>
    </div>
</div>